# shellcheck shell=bash
# The flake's development shell, anywhere in the repository (flake.nix's
# devShells say what it holds); nix-direnv keeps it, so it's entered at once.

# The shell builds changed-checks, merge-net and the other tools from this
# checkout, but nix-direnv builds it afresh only when flake.nix or
# flake.lock changes, so a rebase that moved a tool left the shell running
# the old one. On 2026-11-11, 31 trees' shells held a merge-net from before
# the keeper of what passed, which found no pass made since it landed and
# refused changes the installed one let merge. So the shell also follows a
# file naming what its tools were built from, as git's ids for the commit
# checked out, rewritten only when they change: a commit or a rebase that
# moves them builds the shell afresh, while editing them costs no build
# each time the shell is entered.
layout="$(direnv_layout_dir)"
built_from="$layout/built-from"
said="$(git rev-parse HEAD:tools HEAD:modules/guide/tools.nix \
  HEAD:modules/wifid/sign-in/package.nix 2>/dev/null || true)"
kept="$(cat "$built_from" 2>/dev/null || true)"
if [[ $said != "$kept" ]]; then
  mkdir -p "$layout"
  printf '%s\n' "$said" >"$built_from"
fi
watch_file "$built_from"

use flake
