+/*
+ * The room left for cells once the padding is kept clear on both sides. A
+ * padding that would leave no room for a cell is dropped rather than
+ * leaving the screen empty. The renderers centre the cells in the whole
+ * screen, so what's left over beside the padding is shared out evenly.
+ */
+static unsigned int padded(unsigned int length, unsigned int padding, unsigned int cell)
+{
+	if (length < 2 * padding + cell)
+		return length;
+	return length - 2 * padding;
+}
+
 unsigned int kmscon_text_get_cols(struct kmscon_text *txt, unsigned int font_width)
 {
 	if (!txt || !font_width)
 		return 0;
 
-	return kmscon_text_get_width(txt) / font_width;
+	return padded(kmscon_text_get_width(txt), txt->padding_x, font_width) / font_width;
 }
 
