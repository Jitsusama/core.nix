stub: Turn on hardware P-states before hashing

Some firmware hands over to the boot loader with the CPU at its lowest
ratio and HWP off, and keeps it there for as long as it likes: it
ignores a request through IA32_PERF_CTL. On a Core Ultra X7 358H the
stub entered at 400 MHz with IA32_PERF_CTL asking for 1.9 GHz, with no
thermal or power limit in force, and hashed the kernel and initrd at
84 TSC ticks a byte against 7.4 at full speed. How long the hold lasts
varies from boot to boot: 130 ms into the stub on one, the whole 3 s
of the loader on another.

Linux's intel_pstate turns HWP on at every boot and can't turn it off,
so the stub turns it on first, when CPUID says the CPU has it and the
firmware hasn't, flooring the CPU at its highest performance until
Linux writes its own request. The EPP stays at 0x80: intel_pstate
adopts an EPP it finds when HWP was already on as its balance_performance
default, and 0x80 is what it would use otherwise.

What the stub found goes in the volatile StubHwp variable, under
systemd's loader GUID, so a boot shows whether the hold was there and
whether HWP lifted it.

diff -ruN a/stub/src/hwp.rs b/stub/src/hwp.rs
--- a/stub/src/hwp.rs	1969-12-31 19:00:00.000000000 -0500
+++ b/stub/src/hwp.rs	2026-10-11 21:17:13.665791628 -0400
@@ -0,0 +1,90 @@
+//! Turns on hardware P-states before the stub reads and hashes anything.
+//!
+//! Some firmware hands over with the CPU at its lowest ratio and HWP off,
+//! and holds it there for a while it chooses: a request through
+//! IA32_PERF_CTL is ignored, so the stub's SHA-256 of the kernel and
+//! initrd runs ten times slower than it should. Linux turns HWP on at every
+//! boot anyway and can't turn it off again, so turning it on here only
+//! moves that earlier.
+//!
+//! The request floors the CPU at its highest performance until Linux writes
+//! its own. EPP stays at 0x80: Linux takes the EPP it finds when HWP was
+//! already on as its balance_performance default, and 0x80 is the default
+//! it would have used.
+//!
+//! What it found is left in the volatile StubHwp variable, three u64s:
+//! IA32_PM_ENABLE and IA32_PERF_STATUS as handed over, and IA32_PERF_STATUS
+//! about a millisecond after the request.
+
+use core::arch::x86_64::{__cpuid, _rdtsc};
+use linux_bootloader::efivars::BOOT_LOADER_VENDOR_UUID;
+use uefi::cstr16;
+use uefi::runtime::{self, VariableAttributes};
+
+const PERF_STATUS: u32 = 0x198;
+const PM_ENABLE: u32 = 0x770;
+const HWP_CAPABILITIES: u32 = 0x771;
+const HWP_REQUEST: u32 = 0x774;
+const EPP_DEFAULT: u64 = 0x80;
+
+#[allow(unused_unsafe)]
+fn hwp_supported() -> bool {
+    // CPUID.06H:EAX bit 7 says IA32_PM_ENABLE and the HWP MSRs exist.
+    // Without it they fault, so nothing is touched.
+    let max_leaf = unsafe { __cpuid(0) }.eax;
+    max_leaf >= 6 && unsafe { __cpuid(6) }.eax & (1 << 7) != 0
+}
+
+fn rdmsr(msr: u32) -> u64 {
+    let (lo, hi): (u32, u32);
+    // SAFETY: only called for MSRs that CPUID says exist.
+    unsafe {
+        core::arch::asm!("rdmsr", in("ecx") msr, out("eax") lo, out("edx") hi,
+            options(nomem, nostack, preserves_flags));
+    }
+    ((hi as u64) << 32) | lo as u64
+}
+
+fn wrmsr(msr: u32, value: u64) {
+    // SAFETY: only called for MSRs that CPUID says exist.
+    unsafe {
+        core::arch::asm!("wrmsr", in("ecx") msr, in("eax") value as u32,
+            in("edx") (value >> 32) as u32, options(nomem, nostack, preserves_flags));
+    }
+}
+
+#[allow(unused_unsafe)]
+fn tsc() -> u64 {
+    unsafe { _rdtsc() }
+}
+
+/// Turns HWP on asking for the CPU's highest performance, unless the
+/// firmware already turned it on, and records what it found.
+pub fn enable() {
+    if !hwp_supported() {
+        return;
+    }
+    let found = rdmsr(PM_ENABLE);
+    let before = rdmsr(PERF_STATUS);
+    if found & 1 == 0 {
+        wrmsr(PM_ENABLE, 1);
+        let highest = rdmsr(HWP_CAPABILITIES) & 0xff;
+        wrmsr(HWP_REQUEST, EPP_DEFAULT << 24 | highest << 8 | highest);
+    }
+    let end = tsc() + 4_000_000;
+    while tsc() < end {
+        core::hint::spin_loop();
+    }
+    let after = rdmsr(PERF_STATUS);
+
+    let mut bytes = [0u8; 24];
+    for (i, v) in [found, before, after].iter().enumerate() {
+        bytes[i * 8..i * 8 + 8].copy_from_slice(&v.to_le_bytes());
+    }
+    let _ = runtime::set_variable(
+        cstr16!("StubHwp"),
+        &BOOT_LOADER_VENDOR_UUID,
+        VariableAttributes::BOOTSERVICE_ACCESS | VariableAttributes::RUNTIME_ACCESS,
+        &bytes,
+    );
+}
