From: Joel Gerber <Jitsusama@users.noreply.github.com>
Subject: [PATCH] services/pipewire: say a node's state and its format

A PwNode said its name, its properties and its volumes, but not what
pipewire says it's doing, running, idle or suspended, nor the format it
moves audio in, which pw-cli and pw-top both show. A shell saying every
figure a sound device has could only read them by running pw-dump.

PwNode now has a `state`, from the node's info, and PwNodeAudio a
`format`, from its Format param, read whenever the node's params change:
its rate, its channels and its sample format's short name, empty while
the node is suspended and has none. Reading a param opens no stream, so
a sleeping card stays asleep.

---
diff --git a/src/services/pipewire/node.cpp b/src/services/pipewire/node.cpp
--- a/src/services/pipewire/node.cpp
+++ b/src/services/pipewire/node.cpp
@@ -14,7 +14,11 @@
 #include <qstring.h>
 #include <qtmetamacros.h>
 #include <qtypes.h>
+#include <spa/debug/types.h>
 #include <spa/node/keys.h>
+#include <spa/param/audio/format-utils.h>
+#include <spa/param/audio/type-info.h>
+#include <spa/param/format-utils.h>
 #include <spa/param/param.h>
 #include <spa/param/props.h>
 #include <spa/pod/builder.h>
@@ -212,6 +216,14 @@
 void PwNode::onInfo(void* data, const pw_node_info* info) {
 	auto* self = static_cast<PwNode*>(data);
 
+	if ((info->change_mask & PW_NODE_CHANGE_MASK_STATE) != 0) {
+		auto state = QString::fromUtf8(pw_node_state_as_string(info->state));
+		if (state != self->state) {
+			self->state = state;
+			emit self->stateChanged();
+		}
+	}
+
 	if ((info->change_mask & PW_NODE_CHANGE_MASK_PROPS) != 0) {
 		auto properties = QMap<QString, QString>();
 
@@ -323,11 +335,46 @@
 					qCWarning(logNode) << "Unable to enumerate props param for" << this->node
 					                   << "as the param does not have read+write permissions.";
 				}
+			} else if (param.id == SPA_PARAM_Format) {
+				// A node has a format only while it's set up to move audio: a
+				// suspended one's can be written but not read, and it has none.
+				if ((param.flags & SPA_PARAM_INFO_READ) != 0) {
+					pw_node_enum_params(this->node->proxy(), 0, param.id, 0, UINT32_MAX, nullptr);
+				} else if (!this->mFormat.isEmpty()) {
+					this->mFormat.clear();
+					emit this->formatChanged();
+				}
 			}
 		}
 	}
 }
 
+QVariantMap PwNodeBoundAudio::format() const { return this->mFormat; }
+
+void PwNodeBoundAudio::updateFormat(const spa_pod* param) {
+	uint32_t mediaType = 0;
+	uint32_t mediaSubtype = 0;
+	if (spa_format_parse(param, &mediaType, &mediaSubtype) < 0) return;
+
+	// Only raw audio says a rate, channels and a sample format of its own;
+	// a passthrough format such as IEC 958 is left unsaid.
+	auto format = QVariantMap();
+	if (mediaType == SPA_MEDIA_TYPE_audio && mediaSubtype == SPA_MEDIA_SUBTYPE_raw) {
+		auto raw = spa_audio_info_raw();
+		if (spa_format_audio_raw_parse(param, &raw) < 0) return;
+
+		const auto* sample = spa_debug_type_find_short_name(spa_type_audio_format, raw.format);
+		format.insert("rate", raw.rate);
+		format.insert("channels", raw.channels);
+		format.insert("sample", QString::fromUtf8(sample != nullptr ? sample : ""));
+	}
+
+	if (format != this->mFormat) {
+		this->mFormat = format;
+		emit this->formatChanged();
+	}
+}
+
 void PwNodeBoundAudio::onSpaParam(quint32 id, quint32 index, const spa_pod* param) {
 	if (id == SPA_PARAM_Props && index == 0) {
 		if (this->node->shouldUseDevice()) {
@@ -338,6 +385,8 @@
 		}
 
 		this->updateVolumeProps(PwVolumeProps::parseSpaPod(param));
+	} else if (id == SPA_PARAM_Format && index == 0) {
+		this->updateFormat(param);
 	}
 }
 
