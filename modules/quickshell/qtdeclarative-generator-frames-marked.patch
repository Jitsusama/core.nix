@@ -174,7 +174,7 @@ struct Q_QML_EXPORT Value : public StaticValue
     bool sameValue(Value other) const;
     bool sameValueZero(Value other) const;
 
-    inline void mark(MarkStack *markStack);
+    inline void mark(MarkStack *markStack) const;
 
     static double toInteger(double d) { return StaticValue::toInteger(d); }
     static int toInt32(double d) { return StaticValue::toInt32(d); }
@@ -278,7 +278,7 @@ inline Encode::Encode(HeapBase *o)
     val = Value::fromHeapObject(o).asReturnedValue();
 }
 
-inline void Value::mark(MarkStack *markStack)
+inline void Value::mark(MarkStack *markStack) const
 {
     HeapBasePtr o = heapObject();
     if (o)
diff --git a/src/qml/memory/qv4mm.cpp b/src/qml/memory/qv4mm.cpp
index 2fb7ad8cf98..b4f473d027d 100644
--- a/src/qml/memory/qv4mm.cpp
+++ b/src/qml/memory/qv4mm.cpp
@@ -1500,8 +1500,13 @@ void MemoryManager::collectFromJSStack(MarkStack *markStack) const
     }
 
     for (auto *frame = engine->currentStackFrame; frame; frame = frame->parentFrame()) {
-        if (!frame->isMetaTypesFrame())
+        if (frame->isJSTypesFrame()) {
+            // Generator frames don't live on the JS stack, but in a heap object that the
+            // interpreter writes to without write barrier.
+            if (frame->v4Function->isGenerator())
+                static_cast<const JSTypesStackFrame *>(frame)->markJSFrame(markStack);
             continue;
+        }
 
         if (const QQmlPrivate::AOTTrackedLocalsStorage *locals
                 = static_cast<const MetaTypesStackFrame *>(frame)->locals()) {
