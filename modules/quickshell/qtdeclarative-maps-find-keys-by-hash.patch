+
+// Gives the hash of a string or number key, consistent with sameValueZero:
+// a string by its text, a number by its value as a double, so 1 and 1.0 and
+// +0 and -0 hash alike. Returns false for any other key.
+bool ESTable::hashOf(const Value &key, uint *hash)
+{
+    if (const String *s = key.stringValue()) {
+        *hash = s->hashValue();
+        return true;
+    }
+    if (key.isNumber()) {
+        double d = key.asDouble();
+        if (d == 0)
+            d = 0;
+        quint64 bits;
+        std::memcpy(&bits, &d, sizeof bits);
+        bits ^= bits >> 33;
+        bits *= Q_UINT64_C(0xff51afd7ed558ccd);
+        bits ^= bits >> 33;
+        *hash = uint(bits);
+        return true;
+    }
+    return false;
+}
+
+// Puts the key at \a position in the index, which has room.
+void ESTable::indexAt(uint position, uint hash)
+{
+    const uint mask = m_indexCapacity - 1;
+    uint slot = hash & mask;
+    while (m_index[slot] != 0)
+        slot = (slot + 1) & mask;
+    m_index[slot] = position + 1;
+}
+
+// Makes the index afresh with room for \a capacity slots, a power of two,
+// and counts the keys it can't hold.
+void ESTable::reindex(uint capacity)
+{
+    if (capacity != m_indexCapacity) {
+        free(m_index);
+        m_index = static_cast<uint *>(malloc(capacity * sizeof(uint)));
+        m_indexCapacity = capacity;
+    }
+    memset(m_index, 0, m_indexCapacity * sizeof(uint));
+    m_others = 0;
+    for (uint i = 0; i < m_size; ++i) {
+        uint hash;
+        if (hashOf(m_keys[i], &hash))
+            indexAt(i, hash);
+        else
+            ++m_others;
+    }
+}
+
+// Gives the position of \a key, or -1 when it isn't held.
+int ESTable::find(const Value &key) const
+{
+    uint hash;
+    if (hashOf(key, &hash)) {
+        if (!m_index)
+            return -1;
+        const uint mask = m_indexCapacity - 1;
+        for (uint slot = hash & mask; m_index[slot] != 0; slot = (slot + 1) & mask) {
+            const uint position = m_index[slot] - 1;
+            if (m_keys[position].sameValueZero(key))
+                return int(position);
+        }
+        return -1;
+    }
+    if (m_others == 0)
+        return -1;
+    for (uint i = 0; i < m_size; ++i) {
+        if (m_keys[i].sameValueZero(key))
+            return int(i);
+    }
+    return -1;
 }
 
