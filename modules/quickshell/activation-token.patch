+#include <qpointer.h>
 #include <qprocess.h>
 #include <qqmlcontext.h>
 #include <qqmlengine.h>
@@ -26,6 +28,7 @@
 #include <unistd.h>
 
 #include "../io/processcore.hpp"
+#include "activation.hpp"
 #include "generation.hpp"
 #include "iconimageprovider.hpp"
 #include "instanceinfo.hpp"
@@ -297,6 +300,21 @@ QVariant QuickshellGlobal::env(const QString& variable) { // NOLINT
 	return qEnvironmentVariable(vstr.data());
 }
 
+void QuickshellGlobal::activationToken(const QJSValue& callback) {
+	if (!callback.isCallable()) {
+		qCritical() << "Quickshell.activationToken needs a function to call with the token";
+		return;
+	}
+
+	// The global goes with its engine as the shell reloads, and a callback into that
+	// engine would run against code that is gone.
+	auto global = QPointer(this);
+
+	qs::core::ActivationTokens::request([global, callback](const QString& token) {
+		if (global) callback.call({QJSValue(token)});
+	});
+}
+
 void QuickshellGlobal::execDetached(QList<QString> command) {
 	QuickshellGlobal::execDetached(qs::io::process::ProcessContext(std::move(command)));
 }
