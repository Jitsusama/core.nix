diff --git a/b/src/wayland/xdg_activation.cpp b/src/wayland/xdg_activation.cpp
new file mode 100644
index 0000000..f579a00
--- /dev/null
+++ b/src/wayland/xdg_activation.cpp
@@ -0,0 +1,82 @@
+#include "xdg_activation.hpp"
+
+#include <utility>
+
+#include <private/qwaylanddisplay_p.h>
+#include <private/qwaylandinputdevice_p.h>
+#include <private/qwaylandintegration_p.h>
+#include <private/qwaylandwindow_p.h>
+#include <qlogging.h>
+#include <qloggingcategory.h>
+#include <qstring.h>
+#include <qwaylandclientextension.h>
+
+#include "../core/activation.hpp"
+#include "../core/logcat.hpp"
+
+namespace qs::wayland::xdg_activation {
+
+namespace {
+QS_LOGGING_CATEGORY(logXdgActivation, "quickshell.wayland.xdg_activation", QtWarningMsg);
+}
+
+XdgActivation::XdgActivation(): QWaylandClientExtensionTemplate(1) { this->initialize(); }
+
+XdgActivation::~XdgActivation() {
+	if (this->isInitialized()) this->destroy();
+}
+
+XdgActivation* XdgActivation::instance() {
+	static auto* instance = new XdgActivation(); // NOLINT
+	return instance->isInitialized() ? instance : nullptr;
+}
+
+void XdgActivation::requestToken(qs::core::ActivationTokens::Callback callback) {
+	auto* token = new XdgActivationToken(this->get_activation_token(), std::move(callback));
+
+	// Compositors only honor a token tied to recent input, so it carries the serial
+	// of the last input event Qt saw and the surface that event went to.
+	auto* display = QtWaylandClient::QWaylandIntegration::instance()->display();
+
+	if (auto* device = display->lastInputDevice()) {
+		token->set_serial(display->lastInputSerial(), device->wl_seat());
+	}
+
+	if (auto* window = display->lastInputWindow()) {
+		if (auto* surface = window->wlSurface()) token->set_surface(surface);
+	}
+
+	token->commit();
+	qCDebug(logXdgActivation) << "Requested activation token" << token;
+}
+
+XdgActivationToken::XdgActivationToken(
+    ::xdg_activation_token_v1* token,
+    qs::core::ActivationTokens::Callback callback
+)
+    : QtWayland::xdg_activation_token_v1(token)
+    , callback(std::move(callback)) {}
+
+XdgActivationToken::~XdgActivationToken() {
+	if (this->isInitialized()) this->destroy();
+}
+
+void XdgActivationToken::xdg_activation_token_v1_done(const QString& token) {
+	qCDebug(logXdgActivation) << "Received activation token for" << this;
+	auto callback = std::move(this->callback);
+	delete this;
+	callback(token);
+}
+
+} // namespace qs::wayland::xdg_activation
+
+// NOLINTNEXTLINE(misc-use-internal-linkage)
+void installXdgActivation() {
+	qs::core::ActivationTokens::setHandler([](qs::core::ActivationTokens::Callback callback) {
+		if (auto* activation = qs::wayland::xdg_activation::XdgActivation::instance()) {
+			activation->requestToken(std::move(callback));
+		} else {
+			callback(QString());
+		}
+	});
+}
diff --git a/b/src/wayland/xdg_activation.hpp b/src/wayland/xdg_activation.hpp
new file mode 100644
index 0000000..b3b3774
--- /dev/null
+++ b/src/wayland/xdg_activation.hpp
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <qtclasshelpermacros.h>
+#include <qwayland-xdg-activation-v1.h>
+#include <qwaylandclientextension.h>
+
+#include "../core/activation.hpp"
+#include "wayland-xdg-activation-v1-client-protocol.h"
+
+namespace qs::wayland::xdg_activation {
+
+class XdgActivation
+    : public QWaylandClientExtensionTemplate<XdgActivation>
+    , public QtWayland::xdg_activation_v1 {
+public:
+	explicit XdgActivation();
+	~XdgActivation() override;
+	Q_DISABLE_COPY_MOVE(XdgActivation);
+
+	/// Requests a token for the most recent input Qt has seen, on the window it went to.
+	void requestToken(qs::core::ActivationTokens::Callback callback);
+
+	static XdgActivation* instance();
+};
+
+class XdgActivationToken: public QtWayland::xdg_activation_token_v1 {
+public:
+	explicit XdgActivationToken(
+	    ::xdg_activation_token_v1* token,
+	    qs::core::ActivationTokens::Callback callback
+	);
+
+	~XdgActivationToken() override;
+	Q_DISABLE_COPY_MOVE(XdgActivationToken);
+
+protected:
+	void xdg_activation_token_v1_done(const QString& token) override;
+
+private:
+	qs::core::ActivationTokens::Callback callback;
+};
+
+} // namespace qs::wayland::xdg_activation
