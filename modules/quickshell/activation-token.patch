diff --git a/src/services/notifications/notification.cpp b/src/services/notifications/notification.cpp
index d048bde..9ac0deb 100644
--- a/src/services/notifications/notification.cpp
+++ b/src/services/notifications/notification.cpp
@@ -6,10 +6,13 @@
 #include <qlogging.h>
 #include <qloggingcategory.h>
 #include <qobject.h>
+#include <qpointer.h>
 #include <qproperty.h>
+#include <qstring.h>
 #include <qtmetamacros.h>
 #include <qtypes.h>
 
+#include "../../core/activation.hpp"
 #include "../../core/desktopentry.hpp"
 #include "../../core/iconimageprovider.hpp"
 #include "../../core/logcat.hpp"
@@ -48,11 +51,23 @@ void NotificationAction::invoke() {
 		return;
 	}
 
-	NotificationServer::instance()->ActionInvoked(this->notification->id(), this->mIdentifier);
+	// Activation token, then action, then close, as the specification orders them, so
+	// the program can bring the window the action concerns forward.
+	auto id = this->notification->id();
+	auto identifier = this->mIdentifier;
+	auto notification = QPointer(this->notification);
 
-	if (!this->notification->bindableResident().value()) {
-		this->notification->close(NotificationCloseReason::Dismissed);
-	}
+	qs::core::ActivationTokens::request([=](const QString& token) {
+		auto* server = NotificationServer::instance();
+		if (!token.isEmpty()) server->ActivationToken(id, token);
+		server->ActionInvoked(id, identifier);
+
+		if (notification && !notification->isRetained()
+		    && !notification->bindableResident().value())
+		{
+			notification->close(NotificationCloseReason::Dismissed);
+		}
+	});
 }
 
 void NotificationAction::setText(const QString& text) {
