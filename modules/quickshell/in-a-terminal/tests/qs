#!/usr/bin/env bash
# A stand-in for Quickshell's qs, answering `qs ipc call -- launcher show
# <path>` as a running shell would for a home of three rows and a Machine
# of two, so launcher's completion is typed against what a shell says
# without one running. Any other path names nothing, as the shell says.
case $6 in
$'\u203a')
  echo '{"in":[],"path":[],"row":null,"rows":[
    {"id":"on","name":"Now","count":"2 need you"},
    {"id":"computer","name":"Machine","count":"Disk"},
    {"id":"reopen","name":"Sessions to Reopen"}]}'
  ;;
$'\u203a'machine)
  echo '{"in":["Machine"],"path":["computer"],"row":{"id":"computer","name":"Machine"},
    "rows":[{"id":"disk","name":"Disk","side":"412 GB free"},{"id":"power","name":"Power"}]}'
  ;;
*)
  echo '{"missing":"x","near":[],"in":[]}'
  ;;
esac
