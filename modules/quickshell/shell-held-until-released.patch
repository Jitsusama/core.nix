 void PolkitAgentImpl::registerComplete(bool success) {
-	if (success) this->bIsRegistered = true;
-	else qCWarning(logPolkit) << "failed to register listener on path" << this->qmlAgent->path();
+	if (success) {
+		this->bIsRegistered = true;
+		return;
+	}
+
+	// A shell started held loads while the one it replaces still holds the session's agent, so
+	// it asks again until polkit has let that one go, for as long as a handover takes.
+	if (!qEnvironmentVariableIsEmpty("QS_HELD") && this->registerTries < 40) {
+		this->registerTries += 1;
+		QTimer::singleShot(250, this, [this]() {
+			if (this->bIsRegistered.value()) return;
+			auto utf8Path = this->path.toUtf8();
+			qs_polkit_agent_register(this->listener.get(), utf8Path.constData());
+		});
+		return;
+	}
+
+	qCWarning(logPolkit) << "failed to register listener on path" << this->qmlAgent->path();
 }
 
