 #include <qqmlintegration.h>
@@ -139,3 +141,15 @@
 protected:
 	bool isPostReload = false;
 };
+
+/// What a shell started with QS_HELD holds back until it's released: its windows and its
+/// sockets, so it can load beside the shell it replaces, which goes on drawing and serving.
+class HeldUntilReleased {
+public:
+	/// Whether the shell is still held.
+	static bool held();
+	/// Run once the shell is released, unless context has gone by then; at once if it isn't held.
+	static void onRelease(QObject* context, std::function<void()> run);
+	/// Release the shell, running what waited on it in the order it was asked.
+	static void release();
+};
