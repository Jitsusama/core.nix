 #include "scan.hpp"
 #include "toolsupport.hpp"
 
+namespace {
+
+// The pipe SIGUSR1 is said on, read on the main thread, since a signal handler may only write.
+int releasePipe[2] = {-1, -1};
+
+void releaseSaid(int /*signal*/) {
+	const char byte = 1;
+	[[maybe_unused]] auto written = write(releasePipe[1], &byte, 1);
+}
+
+// A shell started held says it has loaded by writing "ready" to the file QS_HELD names, and
+// shows its windows and serves its sockets once SIGUSR1 releases it.
+void sayHeldReady(QObject* parent) {
+	static bool said = false;
+	if (said || !HeldUntilReleased::held()) return;
+	said = true;
+
+	if (pipe2(releasePipe, O_CLOEXEC | O_NONBLOCK) == 0) {
+		auto* notifier = new QSocketNotifier(releasePipe[0], QSocketNotifier::Read, parent);
+		QObject::connect(notifier, &QSocketNotifier::activated, parent, [notifier]() {
+			char byte = 0;
+			while (read(releasePipe[0], &byte, 1) > 0) {}
+			notifier->setEnabled(false);
+			qInfo() << "Released";
+			HeldUntilReleased::release();
+		});
+		struct sigaction action {};
+		action.sa_handler = &releaseSaid;
+		sigemptyset(&action.sa_mask);
+		action.sa_flags = SA_RESTART;
+		sigaction(SIGUSR1, &action, nullptr);
+	}
+
+	QFile ready(qEnvironmentVariable("QS_HELD"));
+	if (ready.open(QFile::WriteOnly | QFile::Truncate)) ready.write("ready\n");
+	qInfo() << "Held until released";
+}
+
+} // namespace
