+QImage QQuickDefaultTextureFactory::image() const
+{
+    return im.isNull() && reading ? readAgain() : im;
+}
+
+// What a picture let go of was first read with, to read it again the same.
+struct QQuickDefaultTextureFactory::Reading
+{
+    QUrl url;
+    QRect region;
+    QSize requested;
+    QQuickImageProviderOptions options;
+    int frame;
+    qreal ratio;
+};
+
+void QQuickDefaultTextureFactory::letGo(const QUrl &url, const QRect &region, const QSize &requested,
+                                        const QQuickImageProviderOptions &options, int frame,
+                                        qreal ratio)
+{
+    reading = std::make_shared<const Reading>(
+        Reading { url, region, requested, options, frame, ratio });
+}
+
+// The picture read again from its file with what it was first read with,
+// or none where it can't be.
+QImage QQuickDefaultTextureFactory::readAgain() const
+{
+    QFile f(existingImageFileForPath(QQmlFile::urlToLocalFileOrQrc(reading->url)));
+    QImage image;
+    QString errorString;
+    QSize read;
+    int frameCount = 0;
+    if (!f.open(QIODevice::ReadOnly)
+        || !readImage(reading->url, &f, &image, &errorString, &read, &frameCount,
+                      reading->region, reading->requested, reading->options, nullptr,
+                      reading->frame, reading->ratio)) {
+        qWarning().noquote() << "Cannot read" << reading->url.toString() << "again:"
+                             << errorString;
+        return QImage();
+    }
+    return drawable(image);
+}
+
