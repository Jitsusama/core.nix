 private:
     Q_DISABLE_COPY(QQuickPixmapData)
 };
 
+void QQuickPixmapData::letGoOfItsImage()
+{
+    if (QQmlFile::urlToLocalFileOrQrc(url).isEmpty())
+        return;
+    if (auto *factory = qobject_cast<QQuickDefaultTextureFactory *>(textureFactory))
+        factory->letGo(url, requestRegion, requestSize, providerOptions, frame, devicePixelRatio);
+}
