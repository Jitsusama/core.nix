      "argument": "nowifi",
      "in": "wifi",
      "name": "Wi-Fi Off",
      "verb": "off",
      "glyph": "offline",
      "states": {
        "off": {
          "name": "Wi-Fi On",
          "verb": "on",
          "glyph": "wireless",
          "argument": "wifi"
        }
      }
    },
    {
      "id": "verb:wifi-leave",
      "command": "disconnect",
      "in": "wifi",
      "name": "Disconnect It",
      "act": "ending",
      "ends": "disconnect"
    },
    {
      "id": "verb:wifi-join",
      "command": "set",
      "argument": "wifi={name}",
      "in": "wifi",
      "name": "Connect It"
    },
    {
      "id": "verb:wifi-password",
      "command": "password",
      "in": "wifi",
      "name": "Connect It with a New Password"
    },
    {
      "id": "verb:wifi-account",
      "command": "signin",
      "argument": "{method}",
      "in": "wifi",
      "name": "Connect It with an Account Over {method}"
