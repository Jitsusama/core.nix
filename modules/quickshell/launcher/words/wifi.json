        "strong": "strong",
        "good": "good",
        "broken": "broken",
        "weak": "weak"
      }
    },
    {
      "id": "wifi:standard",
      "in": "wifi:protection",
      "name": "Standard"
    },
    {
      "id": "wifi:proof",
      "in": "wifi:protection",
      "name": "Connected By",
      "said": {
        "note": "how a card proves it may connect",
