        "required": "always protected",
        "mine": "this card's are protected",
        "notMine": "this card's aren't",
        "note": "which stops anyone taking a card off it"
      }
    },
    {
      "id": "wifi:connected",
      "in": "wifi",
      "name": "Connected For"
    },
    {
