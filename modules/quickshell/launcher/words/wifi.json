    },
    {
      "id": "wifi:group",
      "in": "wifi:protection",
      "name": "Encryption to All",
      "said": {
        "note": "what's sent to every card at once is sent with"
      }
    },
    {
      "id": "wifi:frames",
      "in": "wifi:protection",
      "name": "Management Frames",
      "said": {
        "off": "unprotected",
