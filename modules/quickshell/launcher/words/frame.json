  "commands": [
    {
      "id": "command:ip",
      "provider": "networks",
      "start": "ip ",
      "form": "⟨address or network⟩",
      "says": "An address's range and who holds it",
      "reads": "Give an address with or without its prefix, or a network, for its range, mask and hosts, and who holds a public one.",
      "examples": [
        { "typed": "ip 192.0.2.10/24", "answers": "in 192.0.2.0/24" },
        { "typed": "ip 198.51.100.0/24", "answers": "254 hosts" }
      ]
    },
    {
      "id": "command:mac",
      "provider": "vendors",
      "start": "mac ",
      "form": "⟨hardware address⟩",
      "says": "Who made it",
      "reads": "Give a hardware address, in any of its usual spellings, for the maker its first three bytes name.",
      "examples": [
        { "typed": "mac 02:00:00:00:00:05", "answers": "locally set, no maker" }
      ]
    },
    {
      "id": "command:sum",
      "provider": "calculator",
      "start": "",
      "form": "⟨sum⟩",
      "says": "Worked out as it's typed",
      "reads": "Type a sum with brackets, powers, roots or bits, in any base, and the answer comes as you type.",
      "examples": [
        { "typed": "(3+4)/2", "answers": "3.5" },
        { "typed": "255 in hex", "answers": "0xff" }
      ]
    },
    {
      "id": "command:within",
      "provider": "networks",
      "start": "is ",
      "form": "⟨address⟩ in ⟨network⟩",
      "says": "Whether a network holds an address",
      "reads": "Give an address or a smaller network, then in, then the network by its prefix or mask.",
      "examples": [
        { "typed": "is 192.0.2.10 in 192.0.2.0/24", "answers": "yes" },
        { "typed": "is 198.51.100.7 in 192.0.2.0/24", "answers": "no" }
      ]
    },
    {
      "id": "command:split",
      "provider": "networks",
      "start": "",
      "form": "⟨network⟩ in /⟨prefix⟩s",
      "says": "A network split into smaller ones",
      "reads": "Give a network and the prefix to cut it to, for each smaller network and its range.",
      "examples": [
        { "typed": "192.0.2.0/24 in /26s", "answers": "4 /26s" }
      ]
    },
    {
      "id": "command:char",
      "provider": "characters",
      "start": "char ",
      "form": "⟨number or character⟩",
      "says": "A character and its codes",
      "reads": "Give a character, or its number in decimal or hex, for its name, code point and bytes.",
      "examples": [
        { "typed": "char 65", "answers": "A" },
        { "typed": "char \u00e9", "answers": "233" }
      ]
    },
    {
      "id": "command:utf8",
      "provider": "characters",
      "start": "utf8 ",
      "form": "⟨text⟩",
      "says": "Text as UTF-8's bytes",
      "reads": "Give any text for its bytes in UTF-8, escaped and as a web address writes them.",
      "examples": [
        { "typed": "utf8 \u00e9", "answers": "c3 a9" }
      ]
    },
    {
      "id": "command:units",
      "provider": "units",
      "start": "",
      "form": "⟨amount⟩ ⟨unit⟩ in ⟨unit⟩",
      "says": "A measure in another unit",
      "reads": "Give an amount, its unit, and the unit wanted, joined by in or to.",
      "examples": [
        { "typed": "5 km in mi", "answers": "3.10686 mi" },
        { "typed": "100 c in f", "answers": "212 °F" }
      ]
    },
    {
      "id": "command:money",
      "provider": "currency",
      "start": "",
      "form": "⟨amount⟩ ⟨currency⟩ in ⟨currency⟩",
      "says": "Money at today's rate",
      "reads": "Give an amount and two currencies by their codes, at the day's rate Frankfurter gives.",
      "examples": [
        { "typed": "100 cad in usd", "answers": "the amount in US dollars" }
      ]
    },
    {
      "id": "command:time",
      "provider": "time",
      "start": "time in ",
      "form": "⟨place⟩",
      "says": "The time somewhere",
      "reads": "Give a city or a country for its time, its day and how far it is from here.",
      "examples": [
        { "typed": "time in tokyo", "answers": "21:00 when it's noon in UTC" }
      ]
    },
    {
      "id": "command:timer",
      "provider": "timers",
      "start": "timer ",
      "form": "⟨span⟩ ⟨name⟩",
      "says": "Starts a timer that rings as a notice",
      "reads": "Give how long, in seconds, minutes or hours, and a name to know it by when it rings.",
      "examples": [
        { "typed": "timer 10m tea", "answers": "tea rings in 10 minutes" }
      ],
      "verb": "start"
    },
    {
      "id": "command:weather",
      "provider": "weather",
      "start": "weather in ",
      "form": "⟨place⟩",
      "says": "The weather somewhere",
      "reads": "Give a place for its weather now and the days to come, as Open-Meteo gives them.",
      "examples": [
        { "typed": "weather in lisbon", "answers": "Lisbon's weather now" }
      ]
    },
    {
      "id": "command:colour",
      "provider": "colours",
      "start": "colour ",
      "form": "⟨colour⟩",
      "says": "A colour in its other forms",
      "reads": "Give a colour by hex, RGB or HSL, or one of the theme's by name, for its other forms.",
      "examples": [
        { "typed": "colour accent", "answers": "the theme's accent as hex, RGB and HSL" }
      ]
    },
    {
      "id": "command:volume",
      "provider": "sound",
      "start": "volume ",
      "form": "⟨percent⟩",
      "says": "Sets how loud",
      "reads": "Give a percent from 0 to 100, for whatever is playing sound now.",
      "examples": [
        { "typed": "volume 40", "answers": "sound at 40%" }
      ],
      "verb": "set"
    },
    {
      "id": "command:brightness",
      "provider": "displays",
      "start": "brightness ",
      "form": "⟨percent⟩",
      "says": "Sets the screen's brightness",
      "reads": "Give a percent from 0 to 100, for the screen's own light.",
      "examples": [
        { "typed": "brightness 40", "answers": "the screen at 40%" }
      ],
      "verb": "set"
    },
    {
      "id": "command:desk",
      "provider": "light",
      "start": "desk light ",
      "form": "⟨percent, warmth, on or off⟩",
      "says": "Sets the desk light",
      "reads": "Give a percent, a warmth in kelvin, or on or off.",
      "examples": [
        { "typed": "desk light 60", "answers": "the desk light at 60%" },
        { "typed": "desk light 3000 k", "answers": "the desk light at 3,000 K" }
      ],
      "verb": "set"
    },
    {
      "id": "command:epoch",
      "provider": "time",
      "start": "epoch",
      "form": "",
      "says": "Seconds since 1970, and the clock's other figures",
      "reads": "Type it for Unix time, counting to the second, with UTC, TAI, GPS and sidereal time under it.",
      "examples": [
        { "typed": "epoch", "answers": "the seconds since 1970, counting" }
      ]
    }
  ],
