--- a/src/qml/memory/qv4mm_p.h
+++ b/src/qml/memory/qv4mm_p.h
@@ -178,16 +178,28 @@ struct BlockAllocator {
         memset(freeBins, 0, sizeof(freeBins));
     }
 
-    // A bin for each size up to 2 KB, so the last one holds only runs that fit nearly anything
-    // asked of it. With eight, every request of 224 bytes or more walked one list of every free
-    // run that size or larger, passing each too small for it.
-    enum { NumBins = 64 };
+    // A bin for each size under 63 slots, about 2 KB. With eight, every request of 224 bytes or
+    // more walked one list of every free run that size or larger, passing each too small for it.
+    enum { NumExactBins = 63 };
 
-    // How many runs too small a request for the last bin passes before it takes a new chunk.
+    // Runs of 63 to 127 slots share the first large bin, and each bin after it holds runs from a
+    // power of two to the next, the last every run of 1024 slots or more. With one list for them
+    // all, a request passed its 32 tries on runs too small for it while runs that fit sat further
+    // on, and took a new chunk whenever its tries ran out.
+    enum { NumLargeBins = 5, NumBins = NumExactBins + NumLargeBins };
+
+    // How many runs too small a request passes in its own large bin before it looks in the larger
+    // ones, where the first run fits it. A request of 1024 slots or more, 32 KB, has no larger bin
+    // to look in, so it may still take a new chunk while a run that fits lies past its tries.
     enum { LargeBinTries = 32 };
 
-    static inline size_t binForSlots(size_t nSlots) {
-        return nSlots >= NumBins ? NumBins - 1 : nSlots;
+    static constexpr size_t binForSlots(size_t nSlots) {
+        if (nSlots < NumExactBins)
+            return nSlots;
+        // 63 to 127 slots is the first large bin, 128 to 255 the second, and so on.
+        const size_t width = 64 - size_t(qCountLeadingZeroBits(quint64(nSlots)));
+        const size_t large = width < 8 ? 0 : qMin(size_t(NumLargeBins - 1), width - 7);
+        return NumExactBins + large;
     }
 
     HeapItem *allocate(size_t size, bool forceAllocation = false);
@@ -221,6 +233,18 @@ struct BlockAllocator {
     uint *allocationStats = nullptr;
 };
 
+// Each large bin's runs fit every request of a smaller bin, and the largest run a chunk holds
+// lands in the last bin, so a request takes the first run of any bin above its own.
+static_assert(BlockAllocator::binForSlots(BlockAllocator::NumExactBins - 1)
+              == BlockAllocator::NumExactBins - 1);
+static_assert(BlockAllocator::binForSlots(BlockAllocator::NumExactBins)
+              == BlockAllocator::NumExactBins);
+static_assert(BlockAllocator::binForSlots(127) == BlockAllocator::NumExactBins);
+static_assert(BlockAllocator::binForSlots(128) == BlockAllocator::NumExactBins + 1);
+static_assert(BlockAllocator::binForSlots(1023) == BlockAllocator::NumBins - 2);
+static_assert(BlockAllocator::binForSlots(1024) == BlockAllocator::NumBins - 1);
+static_assert(BlockAllocator::binForSlots(Chunk::AvailableSlots) == BlockAllocator::NumBins - 1);
+
 struct HugeItemAllocator {
     HugeItemAllocator(ChunkAllocator *chunkAllocator, ExecutionEngine *engine)
         : chunkAllocator(chunkAllocator), engine(engine)
