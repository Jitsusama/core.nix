+            // Kept within the caller's bins even where asserts are compiled out.
+            uint bin = qMin(uint(BlockAllocator::binForSlots(nSlots)), nBins - 1);
+            Q_ASSERT(bin == BlockAllocator::binForSlots(nSlots));
