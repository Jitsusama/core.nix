+/* Readable once a termination signal has come, so the wait for a frame
+ * hears it whichever thread took it, and even when it came just before
+ * the wait began. */
+static int stop_fd = -1;
+
 void handle_graceful_termination(int)
 {
+    stopped = true;
     exit_main_loop = true;
+    if (stop_fd >= 0)
+    {
+        uint64_t one = 1;
+        (void)!write(stop_fd, &one, sizeof(one));
+    }
+}
+
+/* Dispatches the display's events as wl_display_dispatch does, but gives
+ * way at once to a termination signal. wl_display_dispatch polls again
+ * when a signal breaks in, and a frame asked for with damage comes only
+ * once something on the screen moves, so a recording stopped over a still
+ * screen went on, and wasn't saved, until something did. */
+static int dispatch_or_stop(struct wl_display *display)
+{
+    while (wl_display_prepare_read(display) != 0)
+    {
+        if (wl_display_dispatch_pending(display) == -1)
+        {
+            return -1;
+        }
+    }
+    wl_display_flush(display);
+
+    struct pollfd fds[2] = {
+        { wl_display_get_fd(display), POLLIN, 0 },
+        { stop_fd, POLLIN, 0 },
+    };
+    int polled;
+    do {
+        polled = poll(fds, stop_fd >= 0 ? 2 : 1, -1);
+    } while (polled == -1 && errno == EINTR && !exit_main_loop);
+
+    if (polled > 0 && fds[0].revents != 0)
+    {
+        if (wl_display_read_events(display) == -1)
+        {
+            return -1;
+        }
+    } else
+    {
+        wl_display_cancel_read(display);
+        if (polled == -1 && errno != EINTR)
+        {
+            return -1;
+        }
+    }
+    return wl_display_dispatch_pending(display);
 }
 
