+/* Readable once a termination signal has come, so the wait for a frame
+ * hears it whichever thread took it, and even when it came just before
+ * the wait began. */
+static int stop_fd = -1;
+
 void handle_graceful_termination(int)
 {
+    stopped = true;
     exit_main_loop = true;
+    if (stop_fd >= 0)
+    {
+        // Kept, since the signal may break in between a call and its
+        // caller's reading of errno.
+        const int was = errno;
+        uint64_t one = 1;
+        (void)!write(stop_fd, &one, sizeof(one));
+        errno = was;
+    }
+}
+
+/* Dispatches the display's events as wl_display_dispatch does, but gives
+ * way at once to a termination signal. wl_display_dispatch polls again
+ * when a signal breaks in, and a frame asked for with damage comes only
+ * once something on the screen moves, so a recording stopped over a still
+ * screen went on, and wasn't saved, until something did. With `within`
+ * at or past 0 it waits that many milliseconds at most, and returns 0 if
+ * nothing came; without `hear_stop` it waits for the display alone, as
+ * the stop's last frame does once the signal has been heard. */
+static int dispatch_within(struct wl_display *display, int within, bool hear_stop)
+{
+    while (wl_display_prepare_read(display) != 0)
+    {
+        if (wl_display_dispatch_pending(display) == -1)
+        {
+            return -1;
+        }
+    }
+    // A request the socket can't take yet is sent once it can, as
+    // libwayland's own dispatch does, so the frame asked for isn't held
+    // back behind it.
+    const int flushed = wl_display_flush(display);
+    if (flushed == -1 && errno != EAGAIN)
+    {
+        wl_display_cancel_read(display);
+        return -1;
+    }
+
+    struct pollfd fds[2] = {
+        { wl_display_get_fd(display), (short)(POLLIN | (flushed == -1 ? POLLOUT : 0)), 0 },
+        { stop_fd, POLLIN, 0 },
+    };
+    int polled;
+    do {
+        polled = poll(fds, hear_stop && stop_fd >= 0 ? 2 : 1, within);
+    } while (polled == -1 && errno == EINTR && !(hear_stop && exit_main_loop));
+
+    if (polled > 0 && (fds[0].revents & POLLOUT) != 0)
+    {
+        wl_display_flush(display);
+    }
+    if (polled > 0 && (fds[0].revents & ~POLLOUT) != 0)
+    {
+        if (wl_display_read_events(display) == -1)
+        {
+            return -1;
+        }
+    } else
+    {
+        wl_display_cancel_read(display);
+        if (polled == -1 && errno != EINTR)
+        {
+            return -1;
+        }
+    }
+    return wl_display_dispatch_pending(display);
 }
 
