From: Joel Gerber <Jitsusama@users.noreply.github.com>
Subject: [PATCH] core/desktopentry: read the entries again only when a folder holding them changes

The desktop entry monitor watched each folder holding desktop entries and
every folder above it, up to the root, so a folder replaced or a link
pointed elsewhere was heard. But a watch on a folder hears every entry in
it, so any file made, renamed or removed beside the way down read every
desktop entry again: a dotfile written in the home folder, the recent
files' list renamed over in ~/.local/share, anything in /run or /etc.

Each folder above is now watched only for the entry in it that leads down
to a folder of desktop entries, by where it leads and which directory that
is, so a change beside it is let go and a replaced folder or a moved link
still reads them again. The folders holding entries are heard as before.

---
diff --git a/src/core/desktopentrymonitor.cpp b/src/core/desktopentrymonitor.cpp
index bed6ef1..a64203b 100644
--- a/src/core/desktopentrymonitor.cpp
+++ b/src/core/desktopentrymonitor.cpp
@@ -6,23 +6,10 @@
 #include <qobject.h>
 #include <qstring.h>
 #include <qtmetamacros.h>
+#include <sys/stat.h>
 
 #include "desktopentry.hpp"
 
-namespace {
-void addPathAndParents(QFileSystemWatcher& watcher, const QString& path) {
-	watcher.addPath(path);
-
-	auto p = QFileInfo(path).absolutePath();
-	while (!p.isEmpty()) {
-		watcher.addPath(p);
-		const auto parent = QFileInfo(p).dir().absolutePath();
-		if (parent == p) break;
-		p = parent;
-	}
-}
-} // namespace
-
 DesktopEntryMonitor::DesktopEntryMonitor(QObject* parent): QObject(parent) {
 	this->debounceTimer.setSingleShot(true);
 	this->debounceTimer.setInterval(100);
@@ -43,10 +30,37 @@ DesktopEntryMonitor::DesktopEntryMonitor(QObject* parent): QObject(parent) {
 	this->startMonitoring();
 }
 
+// What a path is now: where it leads, and which directory that is, so a
+// folder replaced or a link pointed elsewhere reads as a change, and one
+// left alone doesn't. Empty while nothing is there.
+QString DesktopEntryMonitor::identity(const QString& path) {
+	struct stat info {};
+	if (::stat(path.toLocal8Bit().constData(), &info) != 0) return {};
+	return QFileInfo(path).canonicalFilePath() % QStringLiteral(":")
+	     % QString::number(info.st_dev) % QStringLiteral(":") % QString::number(info.st_ino);
+}
+
+// Each folder above a desktop path is watched only for the one entry in it
+// that leads down to the path, so a file written beside it (the home
+// folder's dotfiles, the recent files' list in ~/.local/share, anything in
+// /run) doesn't read every desktop entry again.
+void DesktopEntryMonitor::watchParents(const QString& path) {
+	auto child = QFileInfo(path).absoluteFilePath();
+	auto p = QFileInfo(child).absolutePath();
+	while (!p.isEmpty() && p != child) {
+		this->watcher.addPath(p);
+		auto& leads = this->leadsTo[p];
+		if (!leads.contains(child)) leads.append(child);
+		this->seen.insert(child, identity(child));
+		child = p;
+		p = QFileInfo(p).dir().absolutePath();
+	}
+}
+
 void DesktopEntryMonitor::startMonitoring() {
 	for (const auto& path: DesktopEntryManager::desktopPaths()) {
 		if (!QDir(path).exists()) continue;
-		addPathAndParents(this->watcher, path);
+		this->watchParents(path);
 		this->scanAndWatch(path);
 	}
 }
@@ -55,14 +69,32 @@ void DesktopEntryMonitor::scanAndWatch(const QString& dirPath) {
 	auto dir = QDir(dirPath);
 	if (!dir.exists()) return;
 
+	// Held by the path it's watched as, which is the one a change names, and
+	// by its absolute path, which a folder above names it by.
 	this->watcher.addPath(dirPath);
+	this->held.insert(dirPath);
+	this->held.insert(QFileInfo(dirPath).absoluteFilePath());
 
 	auto subdirs = dir.entryInfoList(QDir::Dirs | QDir::NoDotAndDotDot | QDir::NoSymLinks);
-	for (const auto& subdir: subdirs) this->watcher.addPath(subdir.absoluteFilePath());
+	for (const auto& subdir: subdirs) {
+		this->watcher.addPath(subdir.absoluteFilePath());
+		this->held.insert(subdir.absoluteFilePath());
+	}
 }
 
-void DesktopEntryMonitor::onDirectoryChanged(const QString& /*path*/) {
+void DesktopEntryMonitor::onDirectoryChanged(const QString& path) {
+	if (!this->held.contains(path)) {
+		auto moved = false;
+		for (const auto& child: this->leadsTo.value(path)) {
+			const auto now = identity(child);
+			if (now != this->seen.value(child)) {
+				this->seen.insert(child, now);
+				moved = true;
+			}
+		}
+		if (!moved) return;
+	}
 	this->debounceTimer.start();
 }
 
-void DesktopEntryMonitor::processChanges() { emit this->desktopEntriesChanged(); }
\ No newline at end of file
+void DesktopEntryMonitor::processChanges() { emit this->desktopEntriesChanged(); }
diff --git a/src/core/desktopentrymonitor.hpp b/src/core/desktopentrymonitor.hpp
index eb3251d..c7b56cc 100644
--- a/src/core/desktopentrymonitor.hpp
+++ b/src/core/desktopentrymonitor.hpp
@@ -1,7 +1,9 @@
 #pragma once
 
 #include <qfilesystemwatcher.h>
+#include <qhash.h>
 #include <qobject.h>
+#include <qset.h>
 #include <qstringlist.h>
 #include <qtimer.h>
 
@@ -25,8 +27,16 @@ private slots:
 
 private:
 	void startMonitoring();
+	void watchParents(const QString& path);
 	void scanAndWatch(const QString& dirPath);
+	static QString identity(const QString& path);
 
+	// The folders holding desktop entries, any change in which is read.
+	QSet<QString> held;
+	// Each folder above them, by the entries in it that lead down to one,
+	// and what each of those was when last looked at.
+	QHash<QString, QStringList> leadsTo;
+	QHash<QString, QString> seen;
 	QFileSystemWatcher watcher;
 	QTimer debounceTimer;
 };
