diff --git a/src/wayland/presentation/qml.cpp b/src/wayland/presentation/qml.cpp
new file mode 100644
index 0000000..4b3f5c5
--- /dev/null
+++ b/src/wayland/presentation/qml.cpp
@@ -0,0 +1,251 @@
+#include "qml.hpp"
+#include <cstdint>
+#include <ctime>
+#include <utility>
+
+#include <private/qwaylandwindow_p.h>
+#include <qcoreapplication.h>
+#include <qobject.h>
+#include <qpointer.h>
+#include <qquickwindow.h>
+#include <qtmetamacros.h>
+#include <qwayland-presentation-time.h>
+#include <qwaylandclientextension.h>
+
+#include "../../window/proxywindow.hpp"
+#include "../../window/windowinterface.hpp"
+
+using QtWaylandClient::QWaylandWindow;
+
+namespace qs::wayland::presentation {
+
+namespace impl {
+
+namespace {
+
+double milliseconds(const timespec& time) {
+	return static_cast<double>(time.tv_sec) * 1000.0 + static_cast<double>(time.tv_nsec) / 1e6;
+}
+
+} // namespace
+
+Presentation::Presentation(): QWaylandClientExtensionTemplate(1) { this->initialize(); }
+
+void Presentation::wp_presentation_clock_id(uint32_t clockId) {
+	this->mClock = static_cast<clockid_t>(clockId);
+}
+
+Presentation* Presentation::instance() {
+	static auto* instance = new Presentation(); // NOLINT
+	return instance->isInitialized() ? instance : nullptr;
+}
+
+Feedback::Feedback(struct ::wp_presentation_feedback* object, clockid_t clock, Done done)
+    : QtWayland::wp_presentation_feedback(object)
+    , clock(clock)
+    , done(std::move(done)) {}
+
+Feedback::~Feedback() {
+	// The feedback has no destructor request: the compositor lets it go once
+	// it has said presented or discarded, and the proxy is freed here.
+	if (this->isInitialized()) wp_presentation_feedback_destroy(this->object());
+}
+
+void Feedback::wp_presentation_feedback_presented(
+    uint32_t secondsHigh,
+    uint32_t secondsLow,
+    uint32_t nanoseconds,
+    uint32_t /*refresh*/,
+    uint32_t /*sequenceHigh*/,
+    uint32_t /*sequenceLow*/,
+    uint32_t /*flags*/
+) {
+	auto seconds = (static_cast<uint64_t>(secondsHigh) << 32) | secondsLow;
+	auto at = static_cast<double>(seconds) * 1000.0 + static_cast<double>(nanoseconds) / 1e6;
+
+	// Said on the compositor's clock, which is the monotonic one on every
+	// compositor in use; another is moved onto it by how far each is now.
+	if (this->clock != CLOCK_MONOTONIC) {
+		timespec theirs {};
+		timespec ours {};
+		clock_gettime(this->clock, &theirs);
+		clock_gettime(CLOCK_MONOTONIC, &ours);
+		at += milliseconds(ours) - milliseconds(theirs);
+	}
+
+	this->finish(at);
+}
+
+void Feedback::wp_presentation_feedback_discarded() { this->finish(-1); }
+
+void Feedback::finish(double at) {
+	auto done = std::move(this->done);
+	// Freed after this event's handler has returned, as it still runs in it.
+	QMetaObject::invokeMethod(
+	    QCoreApplication::instance(),
+	    [this]() { delete this; },
+	    Qt::QueuedConnection
+	);
+	if (done) done(at);
+}
+
+} // namespace impl
+
+namespace {
+
+// The monotonic clock now, in milliseconds, as `presented` says its times.
+double monotonicNow() {
+	timespec now {};
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	return impl::milliseconds(now);
+}
+
+} // namespace
+
+FramePresentation* FramePresentation::qmlAttachedProperties(QObject* object) {
+	auto* proxyWindow = qobject_cast<ProxyWindowBase*>(object);
+
+	if (!proxyWindow) {
+		if (auto* iface = qobject_cast<WindowInterface*>(object)) {
+			proxyWindow = iface->proxyWindow();
+		}
+	}
+
+	if (!proxyWindow) return nullptr;
+	return new FramePresentation(proxyWindow);
+}
+
+FramePresentation::FramePresentation(ProxyWindowBase* window)
+    : QObject(window)
+    , proxyWindow(window) {
+	QObject::connect(
+	    window,
+	    &ProxyWindowBase::windowConnected,
+	    this,
+	    &FramePresentation::onWindowConnected
+	);
+
+	// The protocol's global is bound here, on the thread its events are
+	// read on, never first from the render thread.
+	impl::Presentation::instance();
+
+	if (window->backingWindow()) this->onWindowConnected();
+}
+
+bool FramePresentation::available() { return impl::Presentation::instance() != nullptr; }
+
+void FramePresentation::ask() {
+	this->asked = true;
+	if (this->mWindow) this->mWindow->update();
+}
+
+void FramePresentation::onWindowConnected() {
+	auto* window = this->proxyWindow ? this->proxyWindow->backingWindow() : nullptr;
+	if (window == this->mWindow) return;
+
+	if (this->mWindow) QObject::disconnect(this->mWindow, nullptr, this, nullptr);
+	this->mWindow = window;
+	if (!window) return;
+
+	// Each is heard on the render thread as it happens, never queued to the
+	// GUI thread, which hears a frame's swap only once it's free.
+	QObject::connect(
+	    window,
+	    &QQuickWindow::beforeSynchronizing,
+	    this,
+	    &FramePresentation::onBeforeSynchronizing,
+	    Qt::DirectConnection
+	);
+	QObject::connect(
+	    window,
+	    &QQuickWindow::afterSynchronizing,
+	    this,
+	    &FramePresentation::onAfterSynchronizing,
+	    Qt::DirectConnection
+	);
+	QObject::connect(
+	    window,
+	    &QQuickWindow::beforeRendering,
+	    this,
+	    &FramePresentation::onBeforeRendering,
+	    Qt::DirectConnection
+	);
+	QObject::connect(
+	    window,
+	    &QQuickWindow::afterRendering,
+	    this,
+	    &FramePresentation::onAfterRendering,
+	    Qt::DirectConnection
+	);
+	QObject::connect(
+	    window,
+	    &QQuickWindow::frameSwapped,
+	    this,
+	    &FramePresentation::onFrameSwapped,
+	    Qt::DirectConnection
+	);
+}
+
+QVariantMap FramePresentation::timesOf(int frame) const {
+	if (frame <= 0) return {};
+
+	auto at = static_cast<size_t>(frame) % this->drawn.size();
+	QMutexLocker lock(&this->drawnLock);
+	const auto& times = this->drawn.at(at);
+	if (times.frame != frame) return {};
+
+	return {
+	    {"synchronizing", times.synchronizing},
+	    {"synchronized", times.synchronized},
+	    {"rendering", times.rendering},
+	    {"rendered", times.rendered},
+	    {"swapped", times.swapped},
+	};
+}
+
+void FramePresentation::onBeforeSynchronizing() { this->drawing.synchronizing = monotonicNow(); }
+
+void FramePresentation::onAfterSynchronizing() { this->drawing.synchronized = monotonicNow(); }
+
+void FramePresentation::onAfterRendering() { this->drawing.rendered = monotonicNow(); }
+
+void FramePresentation::onFrameSwapped() {
+	this->drawing.swapped = monotonicNow();
+	if (this->drawing.frame > 0) {
+		auto at = static_cast<size_t>(this->drawing.frame) % this->drawn.size();
+		QMutexLocker lock(&this->drawnLock);
+		this->drawn.at(at) = this->drawing;
+	}
+	// A frame rendered without a sync, as one only exposed again is, says no
+	// sync rather than the last frame's.
+	this->drawing = Times();
+}
+
+void FramePresentation::onBeforeRendering() {
+	auto frame = ++this->begun;
+	this->drawing.frame = frame;
+	this->drawing.rendering = monotonicNow();
+	if (!this->asked.exchange(false)) return;
+
+	auto* manager = impl::Presentation::instance();
+	auto* window = this->mWindow ? dynamic_cast<QWaylandWindow*>(this->mWindow->handle()) : nullptr;
+	auto* surface = window ? window->wlSurface() : nullptr;
+
+	if (!manager || !surface) {
+		QMetaObject::invokeMethod(
+		    this,
+		    [this, frame]() { emit this->discarded(frame); },
+		    Qt::QueuedConnection
+		);
+		return;
+	}
+
+	auto self = QPointer(this);
+	new impl::Feedback(manager->feedback(surface), manager->clock(), [self, frame](double at) {
+		if (!self) return;
+		if (at < 0) emit self->discarded(frame);
+		else emit self->presented(frame, at);
+	});
+}
+
+} // namespace qs::wayland::presentation
diff --git a/src/wayland/presentation/qml.hpp b/src/wayland/presentation/qml.hpp
new file mode 100644
index 0000000..1e911f1
--- /dev/null
+++ b/src/wayland/presentation/qml.hpp
@@ -0,0 +1,162 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <ctime>
+#include <functional>
+
+#include <qmutex.h>
+#include <qobject.h>
+#include <qpointer.h>
+#include <qqmlintegration.h>
+#include <qquickwindow.h>
+#include <qtmetamacros.h>
+#include <qvariant.h>
+#include <qwayland-presentation-time.h>
+#include <qwaylandclientextension.h>
+
+#include "../../window/proxywindow.hpp"
+
+namespace qs::wayland::presentation {
+
+namespace impl {
+
+class Presentation
+    : public QWaylandClientExtensionTemplate<Presentation>
+    , public QtWayland::wp_presentation {
+	Q_OBJECT;
+
+public:
+	explicit Presentation();
+
+	[[nodiscard]] clockid_t clock() const { return this->mClock; }
+
+	static Presentation* instance();
+
+protected:
+	void wp_presentation_clock_id(uint32_t clockId) override;
+
+private:
+	std::atomic<clockid_t> mClock = CLOCK_MONOTONIC;
+};
+
+// One frame's feedback, which deletes itself once the compositor says
+// whether it was shown.
+class Feedback: public QtWayland::wp_presentation_feedback {
+public:
+	// Given the time it was shown on CLOCK_MONOTONIC in milliseconds, or -1
+	// when it never was.
+	using Done = std::function<void(double at)>;
+
+	Feedback(struct ::wp_presentation_feedback* object, clockid_t clock, Done done);
+	~Feedback() override;
+	Q_DISABLE_COPY_MOVE(Feedback);
+
+protected:
+	void wp_presentation_feedback_presented(
+	    uint32_t secondsHigh,
+	    uint32_t secondsLow,
+	    uint32_t nanoseconds,
+	    uint32_t refresh,
+	    uint32_t sequenceHigh,
+	    uint32_t sequenceLow,
+	    uint32_t flags
+	) override;
+	void wp_presentation_feedback_discarded() override;
+
+private:
+	void finish(double at);
+
+	clockid_t clock;
+	Done done;
+};
+
+} // namespace impl
+
+///! When the compositor showed a window's next frame.
+/// Tells, as an attached object on a @@Quickshell.QsWindow or subclass, when
+/// the compositor actually put on screen the first frame drawn after `ask()`,
+/// using the [presentation-time] Wayland protocol. A frame Qt drew is not a
+/// frame the compositor showed: one drawn at a size it hasn't been given yet,
+/// or behind a busy thread, may wait seconds to be shown, or never be.
+///
+/// `presented` gives which frame it was and the time on the monotonic clock
+/// in milliseconds, the clock QElapsedTimer reads, so it can be set against
+/// when something asked for it. Asks made before a frame begins are answered
+/// by it once; asking again on each answer follows every frame.
+///
+/// [presentation-time]: https://wayland.app/protocols/presentation-time
+class FramePresentation: public QObject {
+	Q_OBJECT;
+	/// Whether the compositor tells when frames are shown.
+	Q_PROPERTY(bool available READ available CONSTANT);
+	/// How many frames have begun since the window was made, the newest
+	/// being the one a frameSwapped handler was told of. Read when needed,
+	/// as it changes every frame and notifies nothing.
+	Q_PROPERTY(int framesBegun READ framesBegun);
+	QML_ELEMENT;
+	QML_UNCREATABLE("FramePresentation can only be used as an attached object.");
+	QML_ATTACHED(FramePresentation);
+
+public:
+	explicit FramePresentation(ProxyWindowBase* window);
+
+	[[nodiscard]] static bool available();
+	[[nodiscard]] int framesBegun() const { return this->begun; }
+
+	/// Asks to be told when the next frame begun from now is shown, and asks
+	/// for that frame.
+	Q_INVOKABLE void ask();
+
+	/// When the frame `frame`, counted as `framesBegun` counts, began its
+	/// sync, ended it, began rendering, ended it and was swapped, each read on
+	/// the render thread as it happened, in monotonic milliseconds, so a
+	/// frame's time is its own however late the GUI thread hears its swap.
+	/// Empty before it's swapped and once it's older than the last sixteen;
+	/// a time it had no such step for is 0.
+	Q_INVOKABLE QVariantMap timesOf(int frame) const;
+
+	static FramePresentation* qmlAttachedProperties(QObject* object);
+
+signals:
+	/// The frame asked for, counted as `framesBegun` counts, was shown at
+	/// `at`, in monotonic milliseconds.
+	void presented(int frame, double at);
+	/// The frame asked for was never shown, as one drawn while hidden isn't.
+	void discarded(int frame);
+
+private slots:
+	void onWindowConnected();
+
+private:
+	// Runs on the render thread, before the frame it draws is committed, so
+	// the feedback is for that frame's commit.
+	void onBeforeRendering();
+	// And these on the render thread too, timing each frame's steps.
+	void onBeforeSynchronizing();
+	void onAfterSynchronizing();
+	void onAfterRendering();
+	void onFrameSwapped();
+
+	struct Times {
+		int frame = 0;
+		double synchronizing = 0;
+		double synchronized = 0;
+		double rendering = 0;
+		double rendered = 0;
+		double swapped = 0;
+	};
+
+	QPointer<ProxyWindowBase> proxyWindow;
+	QPointer<QQuickWindow> mWindow;
+	std::atomic<bool> asked = false;
+	std::atomic<int> begun = 0;
+	// The frame being drawn, touched only on the render thread.
+	Times drawing;
+	// The last frames swapped, by their number, read from the GUI thread.
+	std::array<Times, 16> drawn {};
+	mutable QMutex drawnLock;
+};
+
+} // namespace qs::wayland::presentation
