+package agent
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+
+	"golang.org/x/sys/unix"
+)
+
+const account = "/user.slice/user-1000.slice/user@1000.service/"
+
+func places(cgroups ...string) []gatePlace {
+	chain := make([]gatePlace, len(cgroups))
+	for i, cgroup := range cgroups {
+		chain[i] = gatePlace{pid: 100 + i, cgroup: cgroup}
+	}
+	return chain
+}
+
+func mustGate(t *testing.T, text string) gate {
+	t.Helper()
+	g, err := parseGate(text)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return g
+}
+
+func TestGateRefusesTheFirstPlaceItNames(t *testing.T) {
+	g := mustGate(t, "allow /terminal\\.scope$\nrefuse /agents\\.slice/\n")
+	refused, at := g.judge(places(account+"agents.slice/spawner.scope", account+"agents.slice/terminal.scope"))
+	if !refused || at.pid != 100 {
+		t.Fatalf("a peer in agents.slice was served, or blamed on %d", at.pid)
+	}
+}
+
+func TestGateAllowsWhatItAllowsFirst(t *testing.T) {
+	g := mustGate(t, "allow /awaited\\.service$\nrefuse /jobs\\.slice/\n")
+	if refused, _ := g.judge(places(account+"jobs.slice/awaited.service", account+"jobs.slice/jobs.service")); refused {
+		t.Fatal("an allowed place was refused for a refused parent")
+	}
+}
+
+func TestGateLooksPastPlacesItDoesntName(t *testing.T) {
+	g := mustGate(t, "refuse /pi-spawner-[^/]*\\.scope$\n")
+	if refused, at := g.judge(places(account+"app.slice/run.scope", account+"jobs.slice/pi-spawner-1-a.scope")); !refused || at.pid != 101 {
+		t.Fatal("a command whose parent is a spawner was served")
+	}
+}
+
+func TestGateServesAChainItDoesntName(t *testing.T) {
+	g := mustGate(t, "refuse /agents\\.slice/\n")
+	if refused, _ := g.judge(places(account + "app.slice/editor.scope")); refused {
+		t.Fatal("an editor was refused")
+	}
+}
+
+func TestGateRefusesAPeerWithNoPlace(t *testing.T) {
+	if refused, _ := mustGate(t, "refuse /x\n").judge(nil); !refused {
+		t.Fatal("a peer whose cgroup couldn't be read was served")
+	}
+}
+
+func TestGateWatches(t *testing.T) {
+	if g := mustGate(t, "# a comment\nwatch\nrefuse /x\n"); !g.watching {
+		t.Fatal("watch wasn't read")
+	}
+}
+
+func TestGateRefusesALineItCantRead(t *testing.T) {
+	for _, text := range []string{"refuse\n", "allow (\n", "deny /x\n", "watch me\n", "", "# only a comment\n", "watch\n", "allow .\n"} {
+		if _, err := parseGate(text); err == nil {
+			t.Errorf("%q parsed", text)
+		}
+	}
+}
+
+func writeProc(t *testing.T, proc string, pid, ppid int, cgroup string) {
+	t.Helper()
+	dir := filepath.Join(proc, strconv.Itoa(pid))
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	status := "Name:\tx\nPPid:\t" + strconv.Itoa(ppid) + "\n"
+	if err := os.WriteFile(filepath.Join(dir, "status"), []byte(status), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "cgroup"), []byte("0::"+cgroup+"\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestChainReadsEachAncestor(t *testing.T) {
+	proc := t.TempDir()
+	writeProc(t, proc, 30, 20, "/c")
+	writeProc(t, proc, 20, 10, "/b")
+	writeProc(t, proc, 10, 1, "/a")
+	chain, whole := chainOf(proc, 30)
+	if !whole {
+		t.Fatal("a chain read to init wasn't whole")
+	}
+	var got []string
+	for _, place := range chain {
+		got = append(got, place.cgroup)
+	}
+	if strings.Join(got, " ") != "/c /b /a" {
+		t.Fatalf("read %v", got)
+	}
+}
+
+func TestChainOfAGonePeerIsEmpty(t *testing.T) {
+	if chain, whole := chainOf(t.TempDir(), 30); len(chain) != 0 || whole {
+		t.Fatalf("read %v, whole %v", chain, whole)
+	}
+}
+
+func TestChainWhoseParentWentIsntWhole(t *testing.T) {
+	proc := t.TempDir()
+	writeProc(t, proc, 30, 20, "/c")
+	if _, whole := chainOf(proc, 30); whole {
+		t.Fatal("a chain whose parent exited as it was read was whole")
+	}
+}
+
+// chainOfLength is a chain of length processes below init, read from its
+// last.
+func chainOfLength(t *testing.T, length int) (chain []gatePlace, whole bool) {
+	t.Helper()
+	proc := t.TempDir()
+	for pid := 2; pid <= length+1; pid++ {
+		writeProc(t, proc, pid, pid-1, "/x")
+	}
+	return chainOf(proc, length+1)
+}
+
+func TestChainAsLongAsTheGateReadsIsWhole(t *testing.T) {
+	if chain, whole := chainOfLength(t, maxGateChain); !whole || len(chain) != maxGateChain {
+		t.Fatalf("a chain of %d read %d, whole %v", maxGateChain, len(chain), whole)
+	}
+}
+
+func TestChainPastTheLongestIsntWhole(t *testing.T) {
+	if _, whole := chainOfLength(t, maxGateChain+1); whole {
+		t.Fatal("a chain longer than the gate reads was whole")
+	}
+}
+
+func TestAPeerWhoseParentWentIsUnknown(t *testing.T) {
+	proc := t.TempDir()
+	writeProc(t, proc, 30, 20, "/c")
+	if _, err := placeOf(proc, 30, -1); !errors.Is(err, ErrPeerUnknown) {
+		t.Fatalf("a peer whose chain stops short was placed: %v", err)
+	}
+}
+
+// exited is a pidfd of a process that has exited and been reaped.
+func exited(t *testing.T) int {
+	t.Helper()
+	child, err := os.StartProcess("/proc/self/exe", []string{"exited", "-test.run=^$"}, &os.ProcAttr{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	pidfd, err := unix.PidfdOpen(child.Pid, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { unix.Close(pidfd) })
+	if _, err := child.Wait(); err != nil {
+		t.Fatal(err)
+	}
+	return pidfd
+}
+
+func TestAPeerGoneAsItWasReadIsUnknown(t *testing.T) {
+	proc := t.TempDir()
+	writeProc(t, proc, 30, 1, "/c")
+	if _, err := placeOf(proc, 30, exited(t)); !errors.Is(err, ErrPeerUnknown) {
+		t.Fatalf("a peer gone as it was read was placed: %v", err)
+	}
+}
+
+func TestALiveProcessIsStillThere(t *testing.T) {
+	pidfd, err := unix.PidfdOpen(os.Getpid(), 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(pidfd)
+	if !stillThere(pidfd) {
+		t.Error("a live process was taken as gone")
+	}
+}
+
+// The build's sandbox has no process of another account to signal, so
+// what signalling one says is judged here rather than met.
+func TestOnlyAnExitedProcessIsGone(t *testing.T) {
+	for _, c := range []struct {
+		err  error
+		gone bool
+	}{{nil, false}, {unix.EPERM, false}, {unix.ESRCH, true}} {
+		if gone(c.err) != c.gone {
+			t.Errorf("signalling that says %v was taken as gone %v", c.err, !c.gone)
+		}
+	}
+}
+
+func TestOnlyAKernelWithoutPidfdsHasAPidTrustedAlone(t *testing.T) {
+	if err := pidfdFailed(unix.ENOPROTOOPT); err != nil {
+		t.Errorf("a kernel without SO_PEERPIDFD refused its peer: %v", err)
+	}
+	for _, err := range []error{unix.EINVAL, unix.ESRCH, unix.EBADF} {
+		if pidfdFailed(err) == nil {
+			t.Errorf("a pidfd failing with %v left the pid trusted alone", err)
+		}
+	}
+}
+
+func TestAWatchingGateServesEveryRefusal(t *testing.T) {
+	for _, why := range []error{ErrRefusedPlace, ErrPeerUnknown} {
+		if !(gate{watching: true}).serves(why) {
+			t.Errorf("a watching gate refused for %v", why)
+		}
+		if (gate{}).serves(why) {
+			t.Errorf("a gate not watching served what it refused for %v", why)
+		}
+	}
+}
+
+// TestMachineGate judges the cases a machine gives beside its gate, which the
+// build puts in testdata: each line a verdict, refuse or serve, then the
+// cgroups of the peer and of its ancestors in turn. Either file missing fails
+// it, so a build that lost them can't pass judging nothing.
+func TestMachineGate(t *testing.T) {
+	text, err := os.ReadFile("testdata/gate")
+	if err != nil {
+		t.Fatal(err)
+	}
+	g := mustGate(t, string(text))
+	cases, err := os.ReadFile("testdata/gate-cases")
+	if err != nil {
+		t.Fatal(err)
+	}
+	judged := 0
+	for _, line := range strings.Split(string(cases), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 0 || strings.HasPrefix(fields[0], "#") {
+			continue
+		}
+		verdict, cgroups := fields[0], fields[1:]
+		if verdict != "refuse" && verdict != "serve" || len(cgroups) == 0 {
+			t.Fatalf("case %q is neither refuse nor serve with a place", line)
+		}
+		if refused, _ := g.judge(places(cgroups...)); refused != (verdict == "refuse") {
+			t.Errorf("%s was judged otherwise", line)
+		}
+		judged++
+	}
+	if judged == 0 {
+		t.Fatal("no case was judged")
+	}
+}
