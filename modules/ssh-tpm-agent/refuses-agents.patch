diff --git a/agent/gate.go b/agent/gate.go
new file mode 100644
index 0000000..63bdf2a
--- /dev/null
+++ b/agent/gate.go
@@ -0,0 +1,209 @@
+package agent
+
+import (
+	"errors"
+	"fmt"
+	"log/slog"
+	"net"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"golang.org/x/crypto/ssh"
+	"golang.org/x/crypto/ssh/agent"
+	"golang.org/x/sys/unix"
+)
+
+// GateVariable names the file of places whose processes the agent refuses.
+// Where it's unset, the agent serves everyone, as upstream does.
+const GateVariable = "SSH_TPM_AGENT_GATE"
+
+// maxGateChain is how far up a peer's ancestors the gate looks for a place.
+const maxGateChain = 32
+
+// ErrRefusedPlace is what a refused process hears for every request.
+var ErrRefusedPlace = errors.New("agent: refused, as the process asking runs where agents' work runs")
+
+// A gateRule says what a process in a cgroup matching place is: allowed,
+// which ends the search, or refused.
+type gateRule struct {
+	allow bool
+	place *regexp.Regexp
+}
+
+// A gate is the file named by GateVariable, read again for each connection
+// so that a change takes hold without a restart, which would lose the PINs
+// the agent holds. Each line is `allow <pattern>` or `refuse <pattern>`,
+// a regular expression over a cgroup's path, or `watch`, which journals what
+// would be refused and serves it.
+type gate struct {
+	watching bool
+	rules    []gateRule
+}
+
+func parseGate(text string) (gate, error) {
+	var g gate
+	for n, line := range strings.Split(text, "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		word, pattern, _ := strings.Cut(line, " ")
+		pattern = strings.TrimSpace(pattern)
+		switch {
+		case word == "watch" && pattern == "":
+			g.watching = true
+		case (word == "allow" || word == "refuse") && pattern != "":
+			place, err := regexp.Compile(pattern)
+			if err != nil {
+				return gate{}, fmt.Errorf("line %d: %w", n+1, err)
+			}
+			g.rules = append(g.rules, gateRule{allow: word == "allow", place: place})
+		default:
+			return gate{}, fmt.Errorf("line %d: %q is neither allow, refuse nor watch", n+1, line)
+		}
+	}
+	return g, nil
+}
+
+// A gatePlace is one process of a peer's chain and the cgroup it runs in.
+type gatePlace struct {
+	pid    int
+	cgroup string
+}
+
+// judge finds the first process of chain, the peer first, whose cgroup a
+// rule names, and says whether that rule refuses it. A chain no rule names
+// is served; an empty one, a peer whose place couldn't be read, is refused.
+func (g gate) judge(chain []gatePlace) (refused bool, at gatePlace) {
+	if len(chain) == 0 {
+		return true, gatePlace{}
+	}
+	for _, place := range chain {
+		for _, rule := range g.rules {
+			if rule.place.MatchString(place.cgroup) {
+				return !rule.allow, place
+			}
+		}
+	}
+	return false, chain[0]
+}
+
+// chainOf reads pid's cgroup and each of its ancestors' from the proc
+// filesystem at proc, stopping at the first it can't read. The peer's own
+// place missing gives an empty chain.
+func chainOf(proc string, pid int) []gatePlace {
+	var chain []gatePlace
+	for i := 0; i < maxGateChain && pid > 1; i++ {
+		cgroup, ok := unifiedCgroup(proc, pid)
+		if !ok {
+			break
+		}
+		chain = append(chain, gatePlace{pid: pid, cgroup: cgroup})
+		_, pid = procStatusAt(proc, pid)
+	}
+	return chain
+}
+
+// unifiedCgroup is the path on the "0::" line of pid's cgroup file.
+func unifiedCgroup(proc string, pid int) (string, bool) {
+	b, err := os.ReadFile(filepath.Join(proc, strconv.Itoa(pid), "cgroup"))
+	if err != nil {
+		return "", false
+	}
+	for line := range strings.SplitSeq(string(b), "\n") {
+		if path, ok := strings.CutPrefix(line, "0::"); ok {
+			return path, true
+		}
+	}
+	return "", false
+}
+
+// procStatusAt is procStatus over a proc filesystem at proc.
+func procStatusAt(proc string, pid int) (name string, ppid int) {
+	b, err := os.ReadFile(filepath.Join(proc, strconv.Itoa(pid), "status"))
+	if err != nil {
+		return
+	}
+	for line := range strings.SplitSeq(string(b), "\n") {
+		if v, ok := strings.CutPrefix(line, "Name:"); ok {
+			name = strings.TrimSpace(v)
+		} else if v, ok := strings.CutPrefix(line, "PPid:"); ok {
+			ppid, _ = strconv.Atoi(strings.TrimSpace(v))
+			return
+		}
+	}
+	return
+}
+
+// peerPid is the pid the kernel gives for the process at c's other end.
+func peerPid(c *net.UnixConn) (int, bool) {
+	rc, err := c.SyscallConn()
+	if err != nil {
+		return 0, false
+	}
+	var ucred *unix.Ucred
+	if cerr := rc.Control(func(fd uintptr) {
+		ucred, err = unix.GetsockoptUcred(int(fd), unix.SOL_SOCKET, unix.SO_PEERCRED)
+	}); cerr != nil || err != nil {
+		return 0, false
+	}
+	return int(ucred.Pid), true
+}
+
+// refuses says whether the gate refuses c's peer, and journals each refusal
+// with the unit and folder it came from. Where GateVariable is unset it
+// refuses nothing; where its file can't be read or parsed, everything, since
+// a gate that fails open looks just like one that works.
+func refuses(c *net.UnixConn, peer string) bool {
+	file := os.Getenv(GateVariable)
+	if file == "" {
+		return false
+	}
+	text, err := os.ReadFile(file)
+	if err != nil {
+		slog.Error("refused a request, as the gate's file can't be read", "file", file, "error", err.Error())
+		return true
+	}
+	g, err := parseGate(string(text))
+	if err != nil {
+		slog.Error("refused a request, as the gate's file doesn't parse", "file", file, "error", err.Error())
+		return true
+	}
+	pid, ok := peerPid(c)
+	if !ok {
+		slog.Error("refused a request, as the kernel didn't say who asked")
+		return true
+	}
+	refused, at := g.judge(chainOf("/proc", pid))
+	if !refused {
+		return false
+	}
+	folder, _ := os.Readlink(fmt.Sprintf("/proc/%d/cwd", pid))
+	unit := at.cgroup[strings.LastIndex(at.cgroup, "/")+1:]
+	if g.watching {
+		slog.Warn("would refuse a request from agents' work", "unit", unit, "folder", folder, "peer", peer)
+		return false
+	}
+	slog.Warn("refused a request from agents' work", "unit", unit, "folder", folder, "peer", peer)
+	return true
+}
+
+// refusing answers every request of a refused peer with ErrRefusedPlace, so
+// its ssh says the agent refused rather than that it went away.
+type refusing struct{}
+
+func (refusing) List() ([]*agent.Key, error)                        { return nil, ErrRefusedPlace }
+func (refusing) Sign(ssh.PublicKey, []byte) (*ssh.Signature, error) { return nil, ErrRefusedPlace }
+func (refusing) Add(agent.AddedKey) error                           { return ErrRefusedPlace }
+func (refusing) Remove(ssh.PublicKey) error                         { return ErrRefusedPlace }
+func (refusing) RemoveAll() error                                   { return ErrRefusedPlace }
+func (refusing) Lock([]byte) error                                  { return ErrRefusedPlace }
+func (refusing) Unlock([]byte) error                                { return ErrRefusedPlace }
+func (refusing) Signers() ([]ssh.Signer, error)                     { return nil, ErrRefusedPlace }
+func (refusing) SignWithFlags(ssh.PublicKey, []byte, agent.SignatureFlags) (*ssh.Signature, error) {
+	return nil, ErrRefusedPlace
+}
+func (refusing) Extension(string, []byte) ([]byte, error) { return nil, ErrRefusedPlace }
diff --git a/agent/gate_serve_test.go b/agent/gate_serve_test.go
