diff --git a/agent/gate.go b/agent/gate.go
new file mode 100644
index 0000000..16bac1c
--- /dev/null
+++ b/agent/gate.go
@@ -0,0 +1,373 @@
+package agent
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"log/slog"
+	"net"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"sync"
+
+	"golang.org/x/crypto/ssh"
+	"golang.org/x/crypto/ssh/agent"
+	"golang.org/x/sys/unix"
+)
+
+// GateVariable names the file of places whose processes the agent refuses.
+// Where it's unset, the agent serves everyone, as upstream does.
+const GateVariable = "SSH_TPM_AGENT_GATE"
+
+// maxGateChain is how far up a peer's ancestors the gate looks for a place.
+const maxGateChain = 32
+
+// The three refusals below are what the agent journals and answers with;
+// the agent protocol carries no reason, so the process asking hears only
+// that the agent refused, and the journal says why.
+
+// ErrRefusedPlace refuses every request of a process where agents' work runs.
+var ErrRefusedPlace = errors.New("agent: refused, as the process asking runs where agents' work runs")
+
+// ErrGateUnread refuses every process while the gate can't be read or
+// parsed, so a broken gate isn't mistaken for a refused place.
+var ErrGateUnread = errors.New("agent: refused, as its gate can't be read")
+
+// ErrPeerUnknown refuses a process when who it is, or where its chain runs,
+// couldn't be read to the end.
+var ErrPeerUnknown = errors.New("agent: refused, as where the process asking runs couldn't be read")
+
+// A gateRule says what a process in a cgroup matching place is: allowed,
+// which ends the search, or refused.
+type gateRule struct {
+	allow bool
+	place *regexp.Regexp
+}
+
+// A gate is the file named by GateVariable, read again for each connection
+// so that a change takes hold without a restart, which would lose the PINs
+// the agent holds. Each line is `allow <pattern>` or `refuse <pattern>`,
+// a regular expression over a cgroup's path, or `watch`, which journals what
+// would be refused and serves it.
+type gate struct {
+	watching bool
+	rules    []gateRule
+}
+
+func parseGate(text string) (gate, error) {
+	var g gate
+	for n, line := range strings.Split(text, "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		word, pattern, _ := strings.Cut(line, " ")
+		pattern = strings.TrimSpace(pattern)
+		switch {
+		case word == "watch" && pattern == "":
+			g.watching = true
+		case (word == "allow" || word == "refuse") && pattern != "":
+			place, err := regexp.Compile(pattern)
+			if err != nil {
+				return gate{}, fmt.Errorf("line %d: %w", n+1, err)
+			}
+			g.rules = append(g.rules, gateRule{allow: word == "allow", place: place})
+		default:
+			return gate{}, fmt.Errorf("line %d: %q is neither allow, refuse nor watch", n+1, line)
+		}
+	}
+	// A gate refusing no place would serve everyone, which looks just like
+	// a gate that works; an emptied file, or one left only allowing, is a
+	// broken one.
+	refusing := false
+	for _, rule := range g.rules {
+		refusing = refusing || !rule.allow
+	}
+	if !refusing {
+		return gate{}, errors.New("it refuses no place")
+	}
+	return g, nil
+}
+
+// A gatePlace is one process of a peer's chain and the cgroup it runs in.
+type gatePlace struct {
+	pid    int
+	cgroup string
+}
+
+// judge finds the first process of chain, the peer first, whose cgroup a
+// rule names, and says whether that rule refuses it. A chain no rule names
+// is served; an empty one, a peer whose place couldn't be read, is refused.
+func (g gate) judge(chain []gatePlace) (refused bool, at gatePlace) {
+	if len(chain) == 0 {
+		return true, gatePlace{}
+	}
+	for _, place := range chain {
+		for _, rule := range g.rules {
+			if rule.place.MatchString(place.cgroup) {
+				return !rule.allow, place
+			}
+		}
+	}
+	return false, chain[0]
+}
+
+// chainOf reads pid's cgroup and each of its ancestors' from the proc
+// filesystem at proc, up to init, at most maxGateChain of them. It says
+// whether it read the whole chain: a process that exits as it's read, or a
+// chain past maxGateChain, leaves part of it unseen, and an unseen part may
+// be the one a rule refuses.
+func chainOf(proc string, pid int) (chain []gatePlace, whole bool) {
+	for pid != 1 {
+		if len(chain) == maxGateChain {
+			return chain, false
+		}
+		cgroup, ok := unifiedCgroup(proc, pid)
+		if !ok {
+			return chain, false
+		}
+		chain = append(chain, gatePlace{pid: pid, cgroup: cgroup})
+		if _, pid = procStatusAt(proc, pid); pid < 1 {
+			return chain, false
+		}
+	}
+	return chain, true
+}
+
+// unifiedCgroup is the path on the "0::" line of pid's cgroup file.
+func unifiedCgroup(proc string, pid int) (string, bool) {
+	b, err := os.ReadFile(filepath.Join(proc, strconv.Itoa(pid), "cgroup"))
+	if err != nil {
+		return "", false
+	}
+	for line := range strings.SplitSeq(string(b), "\n") {
+		if path, ok := strings.CutPrefix(line, "0::"); ok {
+			return path, true
+		}
+	}
+	return "", false
+}
+
+// procStatusAt is procStatus over a proc filesystem at proc.
+func procStatusAt(proc string, pid int) (name string, ppid int) {
+	b, err := os.ReadFile(filepath.Join(proc, strconv.Itoa(pid), "status"))
+	if err != nil {
+		return
+	}
+	for line := range strings.SplitSeq(string(b), "\n") {
+		if v, ok := strings.CutPrefix(line, "Name:"); ok {
+			name = strings.TrimSpace(v)
+		} else if v, ok := strings.CutPrefix(line, "PPid:"); ok {
+			ppid, _ = strconv.Atoi(strings.TrimSpace(v))
+			return
+		}
+	}
+	return
+}
+
+// peerPid is the pid the kernel gives for the process at c's other end,
+// and a pidfd for that process where the kernel gives one (6.5 on), or -1
+// where the kernel doesn't know SO_PEERPIDFD. Any other failure to give one,
+// a peer already gone among them, isn't ok, so a pid alone is trusted only
+// on a kernel that can't pin it.
+func peerPid(c *net.UnixConn) (pid int, pidfd int, ok bool) {
+	rc, err := c.SyscallConn()
+	if err != nil {
+		return 0, -1, false
+	}
+	var ucred *unix.Ucred
+	pidfd = -1
+	if cerr := rc.Control(func(fd uintptr) {
+		ucred, err = unix.GetsockoptUcred(int(fd), unix.SOL_SOCKET, unix.SO_PEERCRED)
+		if got, ferr := unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_PEERPIDFD); ferr == nil {
+			pidfd = got
+		} else if err == nil {
+			err = pidfdFailed(ferr)
+		}
+	}); cerr != nil || err != nil {
+		if pidfd >= 0 {
+			unix.Close(pidfd)
+		}
+		return 0, -1, false
+	}
+	return int(ucred.Pid), pidfd, true
+}
+
+// stillThere says whether the process pidfd pins is alive, so a chain read
+// by its pid was read of it, and not of another given the pid once it
+// exited. With no pidfd, the pid alone is trusted. Only ESRCH says it's
+// gone: a process of another account, root's ssh under sudo, is there
+// but can't be signalled, which is EPERM.
+func stillThere(pidfd int) bool {
+	if pidfd < 0 {
+		return true
+	}
+	return !gone(unix.PidfdSendSignal(pidfd, 0, nil, 0))
+}
+
+// gone says whether signalling a process failed for its having exited,
+// ESRCH, rather than for its being another account's, EPERM.
+func gone(err error) bool {
+	return errors.Is(err, unix.ESRCH)
+}
+
+// pidfdFailed is what failing to get a peer's pidfd costs: nothing on a
+// kernel that doesn't know SO_PEERPIDFD, ENOPROTOOPT, where the pid alone
+// is trusted, and the peer's refusal for any other failure.
+func pidfdFailed(err error) error {
+	if errors.Is(err, unix.ENOPROTOOPT) {
+		return nil
+	}
+	return err
+}
+
+// placeOf is the chain of pid, read from proc, or ErrPeerUnknown where it
+// couldn't be read to init, or the process pidfd pins went as it was read.
+func placeOf(proc string, pid, pidfd int) ([]gatePlace, error) {
+	chain, whole := chainOf(proc, pid)
+	if !whole || !stillThere(pidfd) {
+		return nil, ErrPeerUnknown
+	}
+	return chain, nil
+}
+
+// lastRead holds the last gate each file parsed into, so a file gone
+// since is judged by what it last said, and why each file is judged so,
+// journalled once as it starts rather than at every connection, which
+// would bury the refusals the journal is watched for.
+var lastRead = struct {
+	sync.Mutex
+	gates  map[string]gate
+	judged map[string]string
+}{gates: map[string]gate{}, judged: map[string]string{}}
+
+// readGate is the gate the file named by GateVariable holds, or ok false
+// where none is set. A file this agent has read once that is gone, can't
+// be read or doesn't parse since, as a rollback past the gate, a removed
+// config folder or a later gate in a format this agent predates leaves it
+// with, is judged by what it last said: Joel's places stay served, so he
+// isn't shut out until a restart asks for his PIN, and agents' work stays
+// refused. Refusing no place counts as not parsing. One this agent never
+// read whole is ErrGateUnread, since a gate that fails open looks just
+// like one that works. Each is read again at the next connection, so
+// putting the file back serves Joel again with no restart.
+func readGate() (g gate, ok bool, err error) {
+	file := os.Getenv(GateVariable)
+	if file == "" {
+		return gate{}, false, nil
+	}
+	text, err := os.ReadFile(file)
+	why := ""
+	switch {
+	case errors.Is(err, fs.ErrNotExist):
+		why = "is gone"
+	case err != nil:
+		why = "can't be read: " + err.Error()
+	default:
+		if g, err = parseGate(string(text)); err != nil {
+			why = "doesn't parse: " + err.Error()
+		}
+	}
+	lastRead.Lock()
+	defer lastRead.Unlock()
+	if why == "" {
+		lastRead.gates[file] = g
+		if _, was := lastRead.judged[file]; was {
+			delete(lastRead.judged, file)
+			slog.Info("read the gate's file again, so it judges requests itself", "file", file)
+		}
+		return g, true, nil
+	}
+	if last, read := lastRead.gates[file]; read {
+		if lastRead.judged[file] != why {
+			lastRead.judged[file] = why
+			slog.Warn("judging requests by the gate last read, as its file "+why, "file", file)
+		}
+		return last, true, nil
+	}
+	slog.Error("refused a request, as the gate's file "+why+" and was never read; "+
+		"putting it back serves Joel at the next connection, with no restart",
+		"file", file)
+	return gate{}, false, ErrGateUnread
+}
+
+// refuses says why the gate refuses c's peer, or nil when it's served, and
+// journals each refusal with the unit and folder it came from. With no
+// gate (readGate) it refuses nothing, and with one it can't read it
+// refuses everything. A peer whose chain can't be read to init is refused
+// too. A watching gate serves each peer it would refuse, saying it would.
+func refuses(c *net.UnixConn, peer string) error {
+	g, ok, err := readGate()
+	if err != nil {
+		return err
+	}
+	if !ok {
+		return nil
+	}
+	why, pid, at := g.verdict(c)
+	if why == nil {
+		return nil
+	}
+	folder, _ := os.Readlink(fmt.Sprintf("/proc/%d/cwd", pid))
+	unit := at.cgroup[strings.LastIndex(at.cgroup, "/")+1:]
+	said := "refused a request from agents' work"
+	switch {
+	case errors.Is(why, ErrPeerUnknown) && pid == 0:
+		said = "refused a request, as the kernel didn't say who asked"
+	case errors.Is(why, ErrPeerUnknown):
+		said = "refused a request, as where its process runs couldn't be read"
+	}
+	if g.serves(why) {
+		slog.Warn("would have "+said, "unit", unit, "pid", pid, "folder", folder, "peer", peer)
+		return nil
+	}
+	slog.Warn(said, "unit", unit, "pid", pid, "folder", folder, "peer", peer)
+	return why
+}
+
+// serves says whether g serves a peer it judged refused for why: only a
+// watching gate does, whatever the refusal.
+func (g gate) serves(why error) bool {
+	return why == nil || g.watching
+}
+
+// verdict is why g refuses c's peer, or nil, with the peer's pid, 0 where
+// the kernel didn't give one, and the place in its chain a rule named.
+func (g gate) verdict(c *net.UnixConn) (why error, pid int, at gatePlace) {
+	pid, pidfd, ok := peerPid(c)
+	if !ok {
+		return ErrPeerUnknown, 0, gatePlace{}
+	}
+	if pidfd >= 0 {
+		defer unix.Close(pidfd)
+	}
+	chain, err := placeOf("/proc", pid, pidfd)
+	if err != nil {
+		return err, pid, gatePlace{}
+	}
+	if refused, at := g.judge(chain); refused {
+		return ErrRefusedPlace, pid, at
+	}
+	return nil, pid, gatePlace{}
+}
+
+// refusing answers every request of a refused peer with a failure, all the
+// agent protocol can say, so its ssh says the agent refused rather than
+// that it went away.
+type refusing struct{ why error }
+
+func (r refusing) List() ([]*agent.Key, error)                        { return nil, r.why }
+func (r refusing) Sign(ssh.PublicKey, []byte) (*ssh.Signature, error) { return nil, r.why }
+func (r refusing) Add(agent.AddedKey) error                           { return r.why }
+func (r refusing) Remove(ssh.PublicKey) error                         { return r.why }
+func (r refusing) RemoveAll() error                                   { return r.why }
+func (r refusing) Lock([]byte) error                                  { return r.why }
+func (r refusing) Unlock([]byte) error                                { return r.why }
+func (r refusing) Signers() ([]ssh.Signer, error)                     { return nil, r.why }
+func (r refusing) SignWithFlags(ssh.PublicKey, []byte, agent.SignatureFlags) (*ssh.Signature, error) {
+	return nil, r.why
+}
+func (r refusing) Extension(string, []byte) ([]byte, error) { return nil, r.why }
diff --git a/agent/gate_serve_test.go b/agent/gate_serve_test.go
new file mode 100644
index 0000000..7ebd12d
--- /dev/null
+++ b/agent/gate_serve_test.go
@@ -0,0 +1,275 @@
+package agent_test
+
+import (
+	"log/slog"
+	"net"
+	"os"
+	"path"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/foxboron/ssh-tpm-agent/agent"
+	"github.com/foxboron/ssh-tpm-agent/internal/keyring"
+	"github.com/foxboron/ssh-tpm-agent/key"
+	"github.com/google/go-tpm/tpm2/transport"
+	sshagent "golang.org/x/crypto/ssh/agent"
+)
+
+// gated starts an agent whose gate is the file it returns, holding
+// gateText, or none when gateText is empty, and returns how to list its keys
+// as this test's own process, whatever cgroup the build runs it in.
+func gated(t *testing.T, gateText string) (file string, list func() error) {
+	t.Helper()
+	dir := t.TempDir()
+	file = path.Join(dir, "gate")
+	if gateText != "" {
+		if err := os.WriteFile(file, []byte(gateText), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		t.Setenv(agent.GateVariable, file)
+	}
+	socket := path.Join(dir, "socket")
+	listener, err := net.ListenUnix("unix", &net.UnixAddr{Net: "unix", Name: socket})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { listener.Close() })
+	ag := agent.NewAgent(listener,
+		[]sshagent.ExtendedAgent{},
+		func() *keyring.ThreadKeyring { return &keyring.ThreadKeyring{} },
+		func() transport.TPMCloser { return nil },
+		func() ([]byte, error) { return []byte(""), nil },
+		func(_ key.SSHTPMKeys) ([]byte, error) { return []byte(""), nil },
+	)
+	t.Cleanup(ag.Stop)
+	return file, func() error {
+		conn, err := net.Dial("unix", socket)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close()
+		_, err = sshagent.NewClient(conn).List()
+		return err
+	}
+}
+
+// listWith lists the keys of an agent whose gate reads gateText.
+func listWith(t *testing.T, gateText string) error {
+	t.Helper()
+	_, list := gated(t, gateText)
+	return list()
+}
+
+func TestAGatedPlaceIsRefused(t *testing.T) {
+	if err := listWith(t, "refuse .\n"); err == nil {
+		t.Fatal("a refused place listed the keys")
+	}
+}
+
+func TestAnAllowedPlaceIsServed(t *testing.T) {
+	if err := listWith(t, "allow .\nrefuse .\n"); err != nil {
+		t.Fatalf("an allowed place was refused: %v", err)
+	}
+}
+
+func TestAWatchedPlaceIsServed(t *testing.T) {
+	if err := listWith(t, "watch\nrefuse .\n"); err != nil {
+		t.Fatalf("a watched place was refused: %v", err)
+	}
+}
+
+func TestNoGateServesEveryone(t *testing.T) {
+	if err := listWith(t, ""); err != nil {
+		t.Fatalf("an agent with no gate refused: %v", err)
+	}
+}
+
+func TestAGateThatCantBeReadRefuses(t *testing.T) {
+	t.Setenv(agent.GateVariable, t.TempDir())
+	if err := listWith(t, ""); err == nil {
+		t.Fatal("a gate that can't be read served")
+	}
+}
+
+// saidBy gathers what the agent journals while a test runs.
+type saidBy struct {
+	sync.Mutex
+	text strings.Builder
+}
+
+func (s *saidBy) Write(b []byte) (int, error) {
+	s.Lock()
+	defer s.Unlock()
+	return s.text.Write(b)
+}
+
+func (s *saidBy) String() string {
+	s.Lock()
+	defer s.Unlock()
+	return s.text.String()
+}
+
+func journalled(t *testing.T) *saidBy {
+	t.Helper()
+	said := &saidBy{}
+	was := slog.Default()
+	slog.SetDefault(slog.New(slog.NewTextHandler(said, nil)))
+	t.Cleanup(func() { slog.SetDefault(was) })
+	return said
+}
+
+// A gate gone before this agent read it can't say who it served, so it
+// refuses everyone until the file is back, and a file put back is read at
+// the next connection, with no restart to ask for Joel's PIN.
+func TestAGateGoneBeforeItWasReadRefusesUntilItIsBack(t *testing.T) {
+	said := journalled(t)
+	file, list := gated(t, "allow .\nrefuse .\n")
+	if err := os.Remove(file); err != nil {
+		t.Fatal(err)
+	}
+	if err := list(); err == nil {
+		t.Fatal("a gate taken away before it was read served")
+	}
+	if !strings.Contains(said.String(), "gate's file is gone and was never read") {
+		t.Fatalf("refusing with no gate read went unsaid: %q", said.String())
+	}
+	if err := os.WriteFile(file, []byte("allow .\nrefuse .\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := list(); err != nil {
+		t.Fatalf("a gate put back didn't serve what it allows: %v", err)
+	}
+}
+
+// A gate gone after it was read keeps serving what it served, so a
+// rollback past the gate doesn't shut Joel out until a restart.
+func TestAGateGoneAfterItWasReadServesWhatItServed(t *testing.T) {
+	said := journalled(t)
+	file, list := gated(t, "allow .\nrefuse .\n")
+	if err := list(); err != nil {
+		t.Fatalf("an allowed place was refused: %v", err)
+	}
+	if err := os.Remove(file); err != nil {
+		t.Fatal(err)
+	}
+	if err := list(); err != nil {
+		t.Fatalf("a gate taken away after it was read refused what it served: %v", err)
+	}
+	if !strings.Contains(said.String(), "gate last read, as its file is gone") {
+		t.Fatalf("judging by the last gate went unsaid: %q", said.String())
+	}
+}
+
+func TestAGateGoneAfterItWasReadJudgesByWhatItSaid(t *testing.T) {
+	file, list := gated(t, "refuse .\n")
+	if err := list(); err == nil {
+		t.Fatal("a refused place listed the keys")
+	}
+	if err := os.Remove(file); err != nil {
+		t.Fatal(err)
+	}
+	if err := list(); err == nil {
+		t.Fatal("a gate taken away after it was read served what it refused")
+	}
+}
+
+// A gate read once that no longer parses, as a later gate in a format
+// this agent predates would, is judged by what it last said, both ways.
+func TestAGateGarbledAfterItWasReadJudgesByWhatItSaid(t *testing.T) {
+	said := journalled(t)
+	file, list := gated(t, "allow .\nrefuse .\n")
+	if err := list(); err != nil {
+		t.Fatalf("an allowed place was refused: %v", err)
+	}
+	if err := os.WriteFile(file, []byte("serve nothing\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := list(); err != nil {
+		t.Fatalf("a gate garbled after it was read refused what it served: %v", err)
+	}
+	if !strings.Contains(said.String(), "gate last read, as its file doesn't parse") {
+		t.Fatalf("judging by the last gate went unsaid: %q", said.String())
+	}
+	refusing, refused := gated(t, "refuse .\n")
+	if err := refused(); err == nil {
+		t.Fatal("a refused place listed the keys")
+	}
+	if err := os.WriteFile(refusing, []byte("# emptied\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := refused(); err == nil {
+		t.Fatal("a gate emptied after it was read served what it refused")
+	}
+}
+
+// A gate read once that can't be read since, a folder in its place, is
+// judged by what it last said, both ways, and says so once rather than
+// at every connection, until a read of the file comes back.
+func TestAGateUnreadableSinceJudgesByItsLast(t *testing.T) {
+	said := journalled(t)
+	file, list := gated(t, "allow .\nrefuse .\n")
+	if err := list(); err != nil {
+		t.Fatalf("an allowed place was refused: %v", err)
+	}
+	unreadable(t, file)
+	for range 3 {
+		if err := list(); err != nil {
+			t.Fatalf("a gate unreadable after it was read refused what it served: %v", err)
+		}
+	}
+	if n := strings.Count(said.String(), "gate last read, as its file can't be read"); n != 1 {
+		t.Fatalf("judging by the last gate was said %d times, not once: %q", n, said.String())
+	}
+	if err := os.Remove(file); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(file, []byte("allow .\nrefuse .\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := list(); err != nil {
+		t.Fatalf("a gate put back didn't serve what it allows: %v", err)
+	}
+	if !strings.Contains(said.String(), "read the gate's file again") {
+		t.Fatalf("the gate's return went unsaid: %q", said.String())
+	}
+	refusing, refused := gated(t, "refuse .\n")
+	if err := refused(); err == nil {
+		t.Fatal("a refused place listed the keys")
+	}
+	unreadable(t, refusing)
+	if err := refused(); err == nil {
+		t.Fatal("a gate unreadable after it was read served what it refused")
+	}
+}
+
+// unreadable puts a folder where the gate's file was, which no read of a
+// file gets past whoever runs the test, root included.
+func unreadable(t *testing.T, file string) {
+	t.Helper()
+	if err := os.Remove(file); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(file, 0o755); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestAGateNamingNoPlaceRefuses(t *testing.T) {
+	if err := listWith(t, "# emptied\n"); err == nil {
+		t.Fatal("a gate naming no place served")
+	}
+}
+
+func TestTheGateIsReadAgainForEachConnection(t *testing.T) {
+	file, list := gated(t, "refuse .\n")
+	if err := list(); err == nil {
+		t.Fatal("a refused place listed the keys")
+	}
+	if err := os.WriteFile(file, []byte("allow .\nrefuse .\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := list(); err != nil {
+		t.Fatalf("the gate's change didn't hold for the next connection: %v", err)
+	}
+}
