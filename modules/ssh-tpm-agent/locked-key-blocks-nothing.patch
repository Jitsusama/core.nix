diff -ruN a/cmd/ssh-tpm-agent/prompts.go b/cmd/ssh-tpm-agent/prompts.go
--- a/cmd/ssh-tpm-agent/prompts.go	1969-12-31 19:00:00.000000000 -0500
+++ b/cmd/ssh-tpm-agent/prompts.go	2026-11-09 03:25:32.801843202 -0500
@@ -0,0 +1,75 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"log/slog"
+	"sync"
+	"time"
+
+	"github.com/foxboron/ssh-tpm-agent/askpass"
+)
+
+// promptTimeout is how long a PIN or confirmation prompt waits for an
+// answer. Answering takes seconds; a prompt still up after a minute has
+// nobody in front of it.
+const promptTimeout = time.Minute
+
+// quietAfterUnanswered is how long a key whose prompt went unanswered is
+// refused without another, so a program trying it again and again overnight
+// puts up one prompt rather than one a minute.
+const quietAfterUnanswered = 10 * time.Minute
+
+// errNotAsked is a refusal made without a prompt.
+var errNotAsked = errors.New("not asked")
+
+// prompts asks for each key's PIN or confirmation one prompt at a time, and
+// remembers when a key's prompt went unanswered.
+type prompts struct {
+	mu    sync.Mutex
+	keys  map[string]*keyPrompts
+	quiet time.Duration
+	now   func() time.Time
+}
+
+type keyPrompts struct {
+	mu         sync.Mutex
+	unanswered time.Time
+}
+
+func newPrompts(quiet time.Duration, now func() time.Time) *prompts {
+	return &prompts{keys: map[string]*keyPrompts{}, quiet: quiet, now: now}
+}
+
+// ask runs read, which may put up a prompt, for the key with this
+// fingerprint. A request arriving while one for the same key is asking
+// waits for it, and so finds the PIN it cached or the refusal it left. A
+// key whose prompt went unanswered within the quiet spell is refused at
+// once, saying which key and until when.
+func (p *prompts) ask(fingerprint, description string, read func() ([]byte, error)) ([]byte, error) {
+	p.mu.Lock()
+	k, ok := p.keys[fingerprint]
+	if !ok {
+		k = &keyPrompts{}
+		p.keys[fingerprint] = k
+	}
+	p.mu.Unlock()
+
+	k.mu.Lock()
+	defer k.mu.Unlock()
+	if !k.unanswered.IsZero() && p.now().Sub(k.unanswered) < p.quiet {
+		err := fmt.Errorf("%w: nobody answered a prompt for %s at %s, so it isn't asked for again until %s",
+			errNotAsked, description, k.unanswered.Format("15:04"), k.unanswered.Add(p.quiet).Format("15:04"))
+		slog.Warn("refused a key without a prompt", slog.String("key", description), slog.String("error", err.Error()))
+		return nil, err
+	}
+	pin, err := read()
+	switch {
+	case errors.Is(err, askpass.ErrNoAnswer):
+		k.unanswered = p.now()
+		slog.Warn("nobody answered a key's prompt", slog.String("key", description), slog.String("error", err.Error()))
+	case err == nil:
+		k.unanswered = time.Time{}
+	}
+	return pin, err
+}
diff -ruN a/cmd/ssh-tpm-agent/prompts_test.go b/cmd/ssh-tpm-agent/prompts_test.go
--- a/cmd/ssh-tpm-agent/prompts_test.go	1969-12-31 19:00:00.000000000 -0500
+++ b/cmd/ssh-tpm-agent/prompts_test.go	2026-11-09 03:25:32.804843219 -0500
@@ -0,0 +1,125 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/foxboron/ssh-tpm-agent/askpass"
+)
+
+type clock struct {
+	mu sync.Mutex
+	at time.Time
+}
+
+func (c *clock) now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.at
+}
+
+func (c *clock) pass(d time.Duration) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.at = c.at.Add(d)
+}
+
+func unanswered() ([]byte, error) {
+	return nil, fmt.Errorf("%w within 1m0s", askpass.ErrNoAnswer)
+}
+
+func TestAnUnansweredKeyIsRefusedWithoutAnotherPrompt(t *testing.T) {
+	c := &clock{at: time.Date(2026, 11, 8, 23, 30, 0, 0, time.UTC)}
+	p := newPrompts(10*time.Minute, c.now)
+
+	if _, err := p.ask("gce", "gce (tpm)", unanswered); !errors.Is(err, askpass.ErrNoAnswer) {
+		t.Fatalf("the first prompt went unanswered, but ask said: %v", err)
+	}
+	c.pass(9 * time.Minute)
+	prompted := false
+	_, err := p.ask("gce", "gce (tpm)", func() ([]byte, error) { prompted = true; return []byte("1234"), nil })
+	if prompted {
+		t.Fatal("a key whose prompt went unanswered nine minutes ago was prompted for again")
+	}
+	if !errors.Is(err, errNotAsked) {
+		t.Fatalf("the refusal wasn't one made without a prompt: %v", err)
+	}
+	want := "nobody answered a prompt for gce (tpm) at 23:30, so it isn't asked for again until 23:40"
+	if got := err.Error(); got != "not asked: "+want {
+		t.Fatalf("the refusal says %q, not which key and until when (%q)", got, want)
+	}
+
+	c.pass(time.Minute)
+	pin, err := p.ask("gce", "gce (tpm)", func() ([]byte, error) { return []byte("1234"), nil })
+	if err != nil || string(pin) != "1234" {
+		t.Fatalf("after the quiet spell the key wasn't asked for again: %q, %v", pin, err)
+	}
+}
+
+func TestAnotherKeyIsStillAskedFor(t *testing.T) {
+	c := &clock{at: time.Date(2026, 11, 8, 23, 30, 0, 0, time.UTC)}
+	p := newPrompts(10*time.Minute, c.now)
+	if _, err := p.ask("gce", "gce (tpm)", unanswered); !errors.Is(err, askpass.ErrNoAnswer) {
+		t.Fatalf("the first prompt went unanswered, but ask said: %v", err)
+	}
+	pin, err := p.ask("login", "login", func() ([]byte, error) { return []byte("5678"), nil })
+	if err != nil || string(pin) != "5678" {
+		t.Fatalf("one key's unanswered prompt kept another from being asked for: %q, %v", pin, err)
+	}
+}
+
+func TestARefusalOtherThanSilenceAsksAgainNextTime(t *testing.T) {
+	c := &clock{at: time.Date(2026, 11, 8, 23, 30, 0, 0, time.UTC)}
+	p := newPrompts(10*time.Minute, c.now)
+	if _, err := p.ask("gce", "gce (tpm)", func() ([]byte, error) { return nil, errors.New("cancelled") }); err == nil {
+		t.Fatal("a cancelled prompt gave a PIN")
+	}
+	prompted := false
+	if _, err := p.ask("gce", "gce (tpm)", func() ([]byte, error) { prompted = true; return []byte("1234"), nil }); err != nil || !prompted {
+		t.Fatalf("a key whose prompt was cancelled, not left unanswered, wasn't asked for again: %v", err)
+	}
+}
+
+func TestOnePromptPerKeyAtATime(t *testing.T) {
+	c := &clock{at: time.Date(2026, 11, 8, 23, 30, 0, 0, time.UTC)}
+	p := newPrompts(10*time.Minute, c.now)
+	started := make(chan struct{})
+	release := make(chan struct{})
+	var mu sync.Mutex
+	reads := 0
+	read := func() ([]byte, error) {
+		mu.Lock()
+		reads++
+		first := reads == 1
+		mu.Unlock()
+		if first {
+			close(started)
+			<-release
+		}
+		return unanswered()
+	}
+
+	results := make(chan error, 2)
+	go func() { _, err := p.ask("gce", "gce (tpm)", read); results <- err }()
+	<-started
+	go func() { _, err := p.ask("gce", "gce (tpm)", read); results <- err }()
+	close(release)
+	var errs []error
+	for range 2 {
+		select {
+		case err := <-results:
+			errs = append(errs, err)
+		case <-time.After(10 * time.Second):
+			t.Fatal("a request for the key never finished")
+		}
+	}
+	if reads != 1 {
+		t.Fatalf("two requests for one key put up %d prompts", reads)
+	}
+	if !errors.Is(errs[0], askpass.ErrNoAnswer) || !errors.Is(errs[1], errNotAsked) {
+		t.Fatalf("the waiting request wasn't refused with the first's silence: %v", errs)
+	}
+}
