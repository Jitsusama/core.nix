+// GateConfirmations has every confirmation the agent asks for go through
+// gate, which is handed the key and the prompt to run, so it can ask one
+// prompt per key at a time or refuse a key without asking.
+func (a *Agent) GateConfirmations(gate func(k key.SSHTPMKeys, confirm func() error) error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	a.confirms = gate
