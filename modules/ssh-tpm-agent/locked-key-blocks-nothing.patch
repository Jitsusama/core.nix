diff -ruN a/askpass/timeout_test.go b/askpass/timeout_test.go
--- a/askpass/timeout_test.go	1969-12-31 19:00:00.000000000 -0500
+++ b/askpass/timeout_test.go	2026-11-09 00:47:31.041186188 -0500
@@ -0,0 +1,51 @@
+package askpass
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// An askpass nobody answers is stopped once Timeout passes, with a TERM it
+// can take its prompt down on, and counts as unanswered.
+func TestAnUnansweredAskpassIsStopped(t *testing.T) {
+	dir := t.TempDir()
+	taken := filepath.Join(dir, "taken-down")
+	script := filepath.Join(dir, "askpass")
+	body := "#!/bin/sh\ntrap 'touch " + taken + "; exit 1' TERM\nsleep 60 &\nwait\n"
+	if err := os.WriteFile(script, []byte(body), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("SSH_ASKPASS", script)
+	defer func(was time.Duration) { Timeout = was }(Timeout)
+	Timeout = 200 * time.Millisecond
+
+	start := time.Now()
+	_, err := SshAskPass("Enter passphrase for (gce): ", "")
+	if !errors.Is(err, ErrNoAnswer) {
+		t.Fatalf("an askpass left unanswered wasn't counted so: %v", err)
+	}
+	if waited := time.Since(start); waited > 10*time.Second {
+		t.Fatalf("the askpass ran %s, long past its limit", waited)
+	}
+	if _, err := os.Stat(taken); err != nil {
+		t.Fatal("the askpass wasn't stopped with a TERM it could take its prompt down on")
+	}
+}
+
+func TestAnAnsweredAskpassGivesItsAnswer(t *testing.T) {
+	script := filepath.Join(t.TempDir(), "askpass")
+	if err := os.WriteFile(script, []byte("#!/bin/sh\necho 1234\n"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("SSH_ASKPASS", script)
+	defer func(was time.Duration) { Timeout = was }(Timeout)
+	Timeout = 10 * time.Second
+
+	pin, err := SshAskPass("Enter passphrase for (gce): ", "")
+	if err != nil || string(pin) != "1234" {
+		t.Fatalf("an answered askpass gave %q, %v", pin, err)
+	}
+}
