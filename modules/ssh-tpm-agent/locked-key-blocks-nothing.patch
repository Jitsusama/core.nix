--- a/agent/locked_key_test.go	1969-12-31 19:00:00.000000000 -0500
+++ b/agent/locked_key_test.go	2026-11-09 03:26:37.723224871 -0500
@@ -0,0 +1,165 @@
+package agent_test
+
+import (
+	"errors"
+	"net"
+	"path"
+	"testing"
+	"time"
+
+	"github.com/foxboron/ssh-tpm-agent/agent"
+	"github.com/foxboron/ssh-tpm-agent/internal/keyring"
+	"github.com/foxboron/ssh-tpm-agent/internal/keytest"
+	"github.com/foxboron/ssh-tpm-agent/key"
+	"github.com/google/go-tpm/tpm2"
+	"github.com/google/go-tpm/tpm2/transport"
+	"github.com/google/go-tpm/tpm2/transport/simulator"
+	sshagent "golang.org/x/crypto/ssh/agent"
+)
+
+// A key whose PIN prompt nobody answers holds up only the request that
+// needs it: the other keys still sign, and the keys can still be listed.
+func TestAPromptHoldsUpOnlyItsOwnKey(t *testing.T) {
+	tpm := openSimulator(t)
+	locked := makeKey(t, tpm, "1234", "locked")
+	open := makeKey(t, tpm, "", "open")
+
+	asked := make(chan struct{})
+	answer := make(chan struct{})
+	ag := startAgent(t, tpm,
+		// The PIN prompt: it waits until the test answers it.
+		func(k key.SSHTPMKeys) ([]byte, error) {
+			close(asked)
+			<-answer
+			return []byte("1234"), nil
+		},
+		locked, open,
+	)
+
+	waiting := signInBackground(ag, locked, "waits for its PIN")
+	within(t, asked, "signing with the key that has a PIN never asked for it")
+	listAndSign(t, ag, open, "listing and signing with another key waited on the unanswered PIN prompt")
+
+	close(answer)
+	if err := <-waiting; err != nil {
+		t.Fatalf("the key signed with the PIN it was given: %v", err)
+	}
+}
+
+// A key confirmed on every use whose confirmation nobody answers holds up
+// only its own request too, and its gate's refusal is what the asker gets.
+func TestAConfirmationHoldsUpOnlyItsOwnKey(t *testing.T) {
+	tpm := openSimulator(t)
+	confirmed := makeKey(t, tpm, "", "confirmed")
+	confirmed.ConfirmBeforeUse = true
+	open := makeKey(t, tpm, "", "open")
+
+	asked := make(chan string, 1)
+	answer := make(chan struct{})
+	refusal := errors.New("refused by the gate")
+	ag := startAgent(t, tpm,
+		func(k key.SSHTPMKeys) ([]byte, error) { return nil, nil },
+		confirmed, open,
+	)
+	// The gate stands in for the confirmation prompt: it waits until the
+	// test answers, then refuses.
+	ag.GateConfirmations(func(k key.SSHTPMKeys, confirm func() error) error {
+		asked <- k.GetDescription()
+		<-answer
+		return refusal
+	})
+
+	waiting := signInBackground(ag, confirmed, "waits for its confirmation")
+	select {
+	case description := <-asked:
+		if description != "confirmed" {
+			t.Fatalf("the gate was asked about %q, not the key confirmed on use", description)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("signing with the key confirmed on use never asked the gate")
+	}
+	listAndSign(t, ag, open, "listing and signing with another key waited on the unanswered confirmation")
+
+	close(answer)
+	if err := <-waiting; !errors.Is(err, refusal) {
+		t.Fatalf("the refused key's signature ended with %v, not the gate's refusal", err)
+	}
+}
+
+func openSimulator(t *testing.T) transport.TPMCloser {
+	t.Helper()
+	tpm, err := simulator.OpenSimulator()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { tpm.Close() })
+	return tpm
+}
+
+func makeKey(t *testing.T, tpm transport.TPMCloser, pin, description string) *key.SSHTPMKey {
+	t.Helper()
+	k, err := keytest.MkKey(t, tpm, tpm2.TPMAlgECC, 256, []byte(pin), description)
+	if err != nil {
+		t.Fatalf("making the %s key: %v", description, err)
+	}
+	return k
+}
+
+func startAgent(t *testing.T, tpm transport.TPMCloser, pin func(key.SSHTPMKeys) ([]byte, error), keys ...key.SSHTPMKeys) *agent.Agent {
+	t.Helper()
+	unixList, err := net.ListenUnix("unix", &net.UnixAddr{Net: "unix", Name: path.Join(t.TempDir(), "socket")})
+	if err != nil {
+		t.Fatalf("failed listening: %v", err)
+	}
+	ag := agent.NewAgent(unixList,
+		[]sshagent.ExtendedAgent{},
+		func() *keyring.ThreadKeyring { return &keyring.ThreadKeyring{} },
+		func() transport.TPMCloser { return tpm },
+		func() ([]byte, error) { return []byte(""), nil },
+		pin,
+		keys...,
+	)
+	t.Cleanup(ag.Stop)
+	return ag
+}
+
+func signInBackground(ag *agent.Agent, k *key.SSHTPMKey, data string) <-chan error {
+	done := make(chan error, 1)
+	go func() {
+		_, err := ag.Sign(*k.PublicKey, []byte(data))
+		done <- err
+	}()
+	return done
+}
+
+func within(t *testing.T, happened <-chan struct{}, failure string) {
+	t.Helper()
+	select {
+	case <-happened:
+	case <-time.After(10 * time.Second):
+		t.Fatal(failure)
+	}
+}
+
+// listAndSign lists the agent's keys and signs with k, failing with failure
+// when that doesn't finish within ten seconds.
+func listAndSign(t *testing.T, ag *agent.Agent, k *key.SSHTPMKey, failure string) {
+	t.Helper()
+	done := make(chan error, 1)
+	go func() {
+		if _, err := ag.List(); err != nil {
+			done <- err
+			return
+		}
+		_, err := ag.Sign(*k.PublicKey, []byte("needs nothing asked"))
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatalf("the key needing nothing asked failed to sign while another waited: %v", err)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal(failure)
+	}
+}
