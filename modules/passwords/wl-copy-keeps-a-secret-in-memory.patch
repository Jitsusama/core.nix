+/* A sensitive copy read from stdin is held here, rather than in a temp
+ * file any process of the user's could open and served by a cat found on
+ * PATH: in pages locked out of swap, left out of core dumps and wiped on
+ * every way out that runs code. A copy past the cap is refused whole.
+ */
+#define SENSITIVE_CAP (1024 * 1024)
+static char *sensitive_buffer;
+static size_t sensitive_capacity;
+
+static void wipe_sensitive_buffer(void) {
+    if (sensitive_buffer != NULL) {
+        explicit_bzero(sensitive_buffer, sensitive_capacity);
+    }
+}
+
+static void wipe_and_exit(int signum) {
+    wipe_sensitive_buffer();
+    _exit(128 + signum);
+}
+
+static void refuse_sensitive_copy(const char *why) {
+    wipe_sensitive_buffer();
+    fprintf(stderr, "wl-copy: refused a sensitive copy: %s\n", why);
+    exit(1);
+}
+
+/* Map pages for a sensitive copy, locked and left out of core dumps,
+ * refusing the copy where they can't be.
+ */
+static char *locked_pages(size_t length) {
+    char *pages = mmap(
+        NULL, length, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0
+    );
+    if (pages == MAP_FAILED) {
+        refuse_sensitive_copy(strerror(errno));
+    }
+    if (madvise(pages, length, MADV_DONTDUMP) < 0 || mlock(pages, length) < 0) {
+        int error = errno;
+        munmap(pages, length);
+        refuse_sensitive_copy(strerror(error));
+    }
+    return pages;
+}
+
+/* Read all of stdin into locked pages, growing them by doubling up to
+ * the cap, and answer how much was read. Any error ends the copy: there
+ * is no falling back to a temp file.
+ */
+static size_t read_sensitive_stdin(void) {
+    size_t length = 0;
+    sensitive_capacity = 4096;
+    sensitive_buffer = locked_pages(sensitive_capacity);
+    while (1) {
+        if (length == sensitive_capacity) {
+            size_t grown = sensitive_capacity * 2;
+            if (grown > SENSITIVE_CAP + 1) {
+                grown = SENSITIVE_CAP + 1;
+            }
+            char *pages = locked_pages(grown);
+            char *old = sensitive_buffer;
+            size_t old_capacity = sensitive_capacity;
+            memcpy(pages, old, length);
+            explicit_bzero(old, old_capacity);
+            /* Point at the new pages before letting the old
+             * ones go, so a wipe on a signal never touches
+             * pages no longer mapped.
+             */
+            sensitive_buffer = pages;
+            sensitive_capacity = grown;
+            munmap(old, old_capacity);
+        }
+        ssize_t got = read(
+            STDIN_FILENO,
+            sensitive_buffer + length,
+            sensitive_capacity - length
+        );
+        if (got < 0 && errno == EINTR) {
+            continue;
+        }
+        if (got < 0) {
+            refuse_sensitive_copy(strerror(errno));
+        }
+        if (got == 0) {
+            break;
+        }
+        length += got;
+        if (length > SENSITIVE_CAP) {
+            refuse_sensitive_copy("it is past 1 MiB");
+        }
+    }
+    /* Let go of stdin, so nothing more can reach the copy through it */
+    int devnull = open("/dev/null", O_RDONLY);
+    if (devnull < 0) {
+        close(STDIN_FILENO);
+    } else {
+        dup2(devnull, STDIN_FILENO);
+        close(devnull);
+    }
+    return length;
+}
+
+/* Say a line on stdout for --say-held, whole or not at all, answering
+ * whether it was said.
+ */
+static int say(const char *line) {
+    size_t left = strlen(line);
+    while (left > 0) {
+        ssize_t wrote = write(STDOUT_FILENO, line, left);
+        if (wrote < 0 && errno == EINTR) {
+            continue;
+        }
+        if (wrote < 0) {
+            return 0;
+        }
+        line += wrote;
+        left -= wrote;
+    }
+    return 1;
+}
