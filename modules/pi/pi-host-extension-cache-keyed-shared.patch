+// pi-host: a package that declares its per-session state keyed, with
+// `"pi": { "sessionStateKeyed": true }` in its manifest, shares one factory
+// for each of its files across every folder. Its modules are evaluated once
+// for the host, and held whether or not a conversation is awake, so a host
+// whose conversations have all parked wakes them without evaluating its
+// modules. Every other package keeps a copy for each folder, as above,
+// because module-scope state, such as a pairing kept in a module, would
+// otherwise cross from one folder's conversation to another's. The
+// declaration covers what the package's modules import. A package's
+// manifest is the nearest package.json above the file that has a `pi`
+// field. Shared factories are keyed by the file a path resolves to, so once
+// a link moves on, the copy it pointed at leaves the cache.
+const sharedFactories = new Map<string, ExtensionFactory>();
+// The file each shared extension path last resolved to.
+const sharedFiles = new Map<string, string>();
+// Whether the package a folder belongs to declares its state keyed.
+const keyedFolders = new Map<string, boolean>();
+
+function packageKeepsStateKeyed(folder: string): boolean {
+	const known = keyedFolders.get(folder);
+	if (known !== undefined) return known;
+	let keyed = false;
+	let manifest: unknown;
+	try {
+		manifest = JSON.parse(fs.readFileSync(path.join(folder, "package.json"), "utf-8"));
+	} catch {
+		// No package.json here, or one that isn't JSON: not a manifest.
+	}
+	const pi = typeof manifest === "object" && manifest !== null ? (manifest as { pi?: unknown }).pi : undefined;
+	if (typeof pi === "object" && pi !== null) {
+		keyed = (pi as { sessionStateKeyed?: unknown }).sessionStateKeyed === true;
+	} else {
+		const parent = path.dirname(folder);
+		keyed = parent !== folder && packageKeepsStateKeyed(parent);
+	}
+	keyedFolders.set(folder, keyed);
+	return keyed;
+}
+
+// The file a shared extension's path resolves to now, or undefined when its
+// package keeps a copy for each folder.
+function sharedFileOf(extensionPath: string): string | undefined {
+	let file: string;
+	try {
+		file = fs.realpathSync(extensionPath);
+	} catch {
+		// A path that doesn't resolve fails its import, which says so.
+		return undefined;
+	}
+	if (!packageKeepsStateKeyed(path.dirname(file))) return undefined;
+	const before = sharedFiles.get(extensionPath);
+	if (before !== undefined && before !== file) sharedFactories.delete(before);
+	sharedFiles.set(extensionPath, file);
+	return file;
+}
+
+function cachedFactoryOf(extensionPath: string, cacheToken: ExtensionCacheToken): ExtensionFactory | undefined {
+	const shared = sharedFileOf(extensionPath);
+	if (shared !== undefined) return sharedFactories.get(shared);
+	return cacheToken.cache.get(extensionPath)?.deref();
+}
+
+function cacheFactory(extensionPath: string, cacheToken: ExtensionCacheToken, factory: ExtensionFactory): void {
+	const shared = sharedFileOf(extensionPath);
+	if (shared !== undefined) sharedFactories.set(shared, factory);
+	else cacheToken.cache.set(extensionPath, new WeakRef(factory));
+}
+
 export function clearExtensionCache(): void {
 	extensionCaches.length = 0;
+	sharedFactories.clear();
+	sharedFiles.clear();
+	keyedFolders.clear();
 	extensionCacheGeneration++;
 }
 
