+/** Apply an already committed host decision; a continuation adds no fabricated user message. */
+async function finishCommittedAnswer(runtime: Runtime, assistant: EntryId, action: "end" | "continue", context: Context): Promise<void> {
+	const afterRun = action === "end" && await asksAfterRun(runtime, context);
+	const conversationId = runtime.conversationId;
+	await runtime.commit(async (tx): Promise<Next> => {
+		const boundary = await prepareBoundary(tx, conversationId, runtime.settings);
