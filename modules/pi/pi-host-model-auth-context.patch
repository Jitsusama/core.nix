+/**
+ * Refuse a header naming a variable the auth context lacks or holds empty. Resolving it would read
+ * the process's environment, which in a host running many conversations belongs to none of them.
+ */
+function refuseHeadersOutsideContext(
+	headers: Record<string, string> | undefined,
+	description: string,
+	env: Record<string, string> | undefined,
+): void {
+	for (const [key, value] of Object.entries(headers ?? {})) {
+		const missing = getConfigValueEnvVarNames(value).filter((name) => !env?.[name]);
+		if (missing.length === 0) continue;
+		const variables = missing.length === 1 ? "variable" : "variables";
+		throw new Error(
+			`Failed to resolve ${description} header "${key}" from environment ${variables}: ${missing.join(", ")}`,
+		);
+	}
+}
+
+/** Resolve headers from an auth context and explicit values alone, never the process's environment. */
+async function resolveContextHeaders(
+	headers: Record<string, string> | undefined,
+	description: string,
+	ctx: AuthContext,
+	explicit?: Record<string, string>,
+): Promise<Record<string, string> | undefined> {
+	const env = await configContextEnv(Object.values(headers ?? {}), ctx, explicit);
+	refuseHeadersOutsideContext(headers, description, env);
+	return resolveHeadersOrThrow(headers, description, env);
+}
