+// Claude Code's own words when a plan limit is used up, such as "You've hit
+// your usage limit · resets 3pm".
+const PLAN_LIMIT = /You've (?:hit|reached) your ([^·\n]+?)\s*(?:·\s*resets ([^·\n]+?))?\s*(?:·|$)/imu;
+
+/**
+ * Rewrite Claude Code's plan-limit error into a plain one that says which
+ * limit, when it resets, and that nothing went to extra usage. It carries
+ * "billing", which Pi's retry classifier never retries.
+ */
+export function describePlanLimit(message: string): string | undefined {
+  const hit = PLAN_LIMIT.exec(message);
+  if (!hit) return undefined;
+  const [, limit, resets] = hit;
+  return (
+    `Claude plan limit reached: your ${limit.trim()} is used up` +
+    (resets ? ` until it resets ${resets.trim()}` : "") +
+    ". Pi stopped here and will not retry, and nothing is charged to extra usage. " +
+    `(Claude Code billing: ${message})`
+  );
+}
