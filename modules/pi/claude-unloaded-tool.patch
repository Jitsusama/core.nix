diff --git a/tests/unavailable-tool.test.ts b/tests/unavailable-tool.test.ts
new file mode 100644
index 0000000..9a28116
--- /dev/null
+++ b/tests/unavailable-tool.test.ts
@@ -0,0 +1,130 @@
+import assert from "node:assert/strict";
+import * as http from "node:http";
+import { chmod, mkdtemp, realpath, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import type { AssistantMessage, Model, TranscriptContext } from "@earendil-works/pi-ai";
+import { closeClaudeProcesses } from "../src/claude-cli.ts";
+import { streamClaudeCode } from "../src/stream.ts";
+import { TurnRelay } from "../src/turn-relay.ts";
+
+// A model that reaches for a pi tool it read about but that isn't loaded (a
+// tool loaded on demand, say) used to end its turn with "relay failure Error",
+// on every turn it reached for it, with nothing saying which tool.
+
+test("a relay failure says what was thrown, not only its class", async () => {
+  const upstream = http.createServer(async (request, response) => {
+    for await (const _chunk of request);
+    response.writeHead(200, { "content-type": "text/event-stream" });
+    const usage = { input_tokens: 2, output_tokens: 1 };
+    response.end(
+      [
+        { type: "message_start", message: { id: "m1", role: "assistant", content: [], usage } },
+        { type: "content_block_start", index: 0, content_block: { type: "text", text: "" } },
+      ]
+        .map((event) => `data: ${JSON.stringify(event)}\n\n`)
+        .join(""),
+    );
+  });
+  await new Promise<void>((resolve) => upstream.listen(0, "127.0.0.1", () => resolve()));
+  const address = upstream.address();
+  if (!address || typeof address === "string") throw new Error("missing address");
+  const relay = new TurnRelay(`http://127.0.0.1:${address.port}`, 5_000, (event) => {
+    if (event.type === "content_block_start") throw new Error("Claude Code returned unavailable tool jobs");
+  });
+
+  try {
+    const baseUrl = await relay.start();
+    // The relay drops the connection as it fails, as it did under Claude Code.
+    await fetch(`${baseUrl}/v1/messages`, { method: "POST", body: "{}" })
+      .then((response) => response.text())
+      .catch(() => "");
+    await relay.settled();
+
+    assert.equal(relay.failure, "Error: Claude Code returned unavailable tool jobs");
+  } finally {
+    await relay.close();
+    await new Promise<void>((resolve) => upstream.close(() => resolve()));
+  }
+});
+
+test("a call to a pi tool not loaded now goes to pi to answer", async () => {
+  const root = await mkdtemp(join(tmpdir(), "pi-claude-code-unloaded-"));
+  const executable = join(root, "fake-claude.mjs");
+  await writeFile(
+    executable,
+    `#!/usr/bin/env node
+import readline from "node:readline";
+if (process.argv.includes("auth") && process.argv.includes("status")) {
+  console.log(JSON.stringify({loggedIn: true, authMethod: "claude.ai", subscriptionType: "test"}));
+  process.exit(0);
+}
+const input = readline.createInterface({input: process.stdin, crlfDelay: Infinity});
+for await (const line of input) {
+  const frame = JSON.parse(line);
+  if (frame.type !== "user") continue;
+  const usage = {input_tokens: 3, output_tokens: 24, cache_read_input_tokens: 0, cache_creation_input_tokens: 0};
+  const content = [{type: "tool_use", id: "toolu_jobs", name: "mcp__pi__jobs", input: {action: "list"}}];
+  const events = [
+    {type: "message_start", message: {id: "m_jobs", role: "assistant", content: [], usage}},
+    {type: "content_block_start", index: 0, content_block: {type: "tool_use", id: "toolu_jobs", name: "mcp__pi__jobs", input: {}}},
+    {type: "content_block_delta", index: 0, delta: {type: "input_json_delta", partial_json: '{"action":"list"}'}},
+    {type: "content_block_stop", index: 0},
+    {type: "message_delta", delta: {stop_reason: "tool_use"}, usage},
+    {type: "message_stop"}
+  ];
+  for (const event of events) console.log(JSON.stringify({type: "stream_event", event}));
+  console.log(JSON.stringify({type: "assistant", message: {id: "m_jobs", role: "assistant", content, stop_reason: "tool_use", usage}}));
+  console.log(JSON.stringify({type: "result", subtype: "error_max_turns", is_error: true, usage}));
+}
+`,
+    "utf8",
+  );
+  await chmod(executable, 0o755);
+  const model = {
+    id: "claude-sonnet-5",
+    name: "Sonnet",
+    api: "claude-code",
+    provider: "claude-code",
+    baseUrl: "",
+    input: ["text"],
+    cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+    reasoning: false,
+    contextWindow: 200_000,
+    maxTokens: 8_000,
+  } as unknown as Model<any>;
+  const bash = {
+    name: "bash",
+    description: "Run a command",
+    parameters: { type: "object", properties: { command: { type: "string" } } },
+  };
+  const context = {
+    messages: [
+      { role: "system", content: "system", toolsAdded: [bash], timestamp: 0 },
+      { role: "user", content: "status?", timestamp: 1 },
+    ],
+  } as unknown as TranscriptContext;
+
+  try {
+    const stream = streamClaudeCode(model, context, {
+      env: { PI_CLAUDE_CODE_COMMAND: executable },
+      cwd: await realpath(root),
+    } as never);
+    let ended: AssistantMessage | undefined;
+    for await (const event of stream) {
+      if (event.type === "done") ended = event.message;
+      if (event.type === "error") ended = event.error;
+    }
+
+    assert.equal(ended?.errorMessage, undefined);
+    assert.equal(ended?.stopReason, "toolUse");
+    assert.deepEqual(
+      ended?.content.map((block) => (block.type === "toolCall" ? [block.name, block.arguments] : block.type)),
+      [["jobs", { action: "list" }]],
+    );
+  } finally {
+    await closeClaudeProcesses();
+    await rm(root, { recursive: true, force: true });
+  }
+});
