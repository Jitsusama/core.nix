+// What a pi host loads beside the coding agent's main entry, emitted as the
+// bundle's host entry. Built in the main split build, it shares the bundle's
+// chunks, so the host, the durable runtime it drives and the extensions pi
+// loads hold one copy of pi-ai, pi-tui and pi-agent-core, and of the state
+// some of their modules keep (pi-ai's session cleanups, its UUIDv7
+// sequence). Loaded beside the bundle instead, durable would bring copies of
+// its own. Each path is the file a host loads from an unbundled install.
+const durableDistDir = join(repoRoot, "packages", "durable", "dist");
+const chordDistDir = join(repoRoot, "packages", "chord", "dist");
+const extensionsDistDir = join(codingAgentDistDir, "core", "extensions");
+const hostEntryVersion = 1;
+const hostEntryExports = [
+	["VIRTUAL_MODULES", join(extensionsDistDir, "virtual-modules.js")],
+	["builtInExtensions", join(codingAgentDistDir, "extensions", "index.js")],
+	["resolveProjectTrusted", join(codingAgentDistDir, "core", "project-trust.js")],
+];
+const hostEntryNamespaces = [
+	["durable", join(durableDistDir, "index.js")],
+	["durableSqlite", join(durableDistDir, "storage", "sqlite", "node.js")],
+	["durableNodeEnv", join(durableDistDir, "env", "node.js")],
+	["chordContext", join(chordDistDir, "context", "index.js")],
+];
+const hostEntrySource = hostEntryExports
+	.map(([name, file]) => `export { ${name} } from ${JSON.stringify(file)};`)
+	.concat(hostEntryNamespaces.map(([name, file]) => `export * as ${name} from ${JSON.stringify(file)};`))
+	.concat(`export const hostEntryVersion = ${hostEntryVersion};`)
+	.join("\n");
+
+// The host's own code imports some of these libraries too, the viewers'
+// terminal pi-tui among them, and a second copy would split the state they
+// keep: pi-tui's kitty flag, set on one copy, goes unread by pi's key reader
+// on the other. So each library VIRTUAL_MODULES hands extensions under
+// @earendil-works/ gets a file of its own, host-modules/<name>.js, that
+// re-exports the copy VIRTUAL_MODULES holds, imported as virtual-modules.js
+// imports it, for the host to resolve its imports to. None of them has a
+// default export for `export *` to drop.
+const hostModules = {
+	"pi-agent-core": "@earendil-works/pi-agent-core",
+	"pi-tui": "@earendil-works/pi-tui",
+	"pi-ai": "./pi-ai-extension-view.js",
+	"pi-ai/compat": "./pi-ai-extension-view.js",
+	"pi-ai/models": "@earendil-works/pi-ai/models",
+	"pi-ai/oauth": "@earendil-works/pi-ai/oauth",
+	"pi-ai/providers/all": "@earendil-works/pi-ai/providers/all",
+	"pi-coding-agent": "../../index.js",
+};
+
+const hostEntryPlugin = {
+	name: "pi-host-entry",
+	setup(build) {
+		build.onResolve({ filter: /^pi-host-entry$/ }, () => ({ namespace: "pi-host-entry", path: "pi-host-entry" }));
+		build.onLoad({ filter: /.*/, namespace: "pi-host-entry" }, () => ({
+			contents: hostEntrySource,
+			loader: "js",
+			resolveDir: codingAgentDir,
+		}));
+		build.onResolve({ filter: /^pi-host-module:/ }, ({ path }) => ({
+			namespace: "pi-host-module",
+			path: path.slice("pi-host-module:".length),
+		}));
+		build.onLoad({ filter: /.*/, namespace: "pi-host-module" }, ({ path }) => ({
+			contents: `export * from ${JSON.stringify(hostModules[path])};`,
+			loader: "js",
+			resolveDir: extensionsDistDir,
+		}));
+	},
+};
+
+// A module that finds a file beside itself through import.meta.url finds
+// nothing once bundled, so none of durable's or chord's may enter the
+// bundle: Photon's images, which start a worker that way, would fail only
+// at first use.
+function refuseBundledAssetReaders(metafile) {
+	const readers = Object.keys(metafile.inputs).filter(
+		(input) =>
+			/(?:^|\/)packages\/(?:durable|chord)\/dist\//.test(input) &&
+			readFileSync(resolve(repoRoot, input), "utf8").includes("import.meta.url"),
+	);
+	if (readers.length > 0) {
+		throw new Error(`The host entry bundled modules that find files beside themselves: ${readers.join(", ")}`);
+	}
+}
+
