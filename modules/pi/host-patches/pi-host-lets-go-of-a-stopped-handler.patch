+	private async awaitHandler<T>(ext: Extension, event: string, run: () => T | Promise<T>): Promise<T> {
+		const signal = this.getSignalFn();
+		const started = Date.now();
+		const pending = Promise.resolve(run());
+		let naming: ReturnType<typeof setTimeout> | undefined;
+		const name = (): void => {
+			const seconds = Math.round((Date.now() - started) / 1000);
+			console.warn(`pi-host: extension ${ext.path}'s ${event} handler still pending after ${seconds} s`);
+			// Named again each minute it stays pending; unref'd, so it never keeps a process up.
+			naming = setTimeout(name, HANDLER_NAMED_EVERY_MS);
+			naming.unref?.();
+		};
+		// Named first once it has been pending 5 s; unref'd, so it never keeps a process up.
+		naming = setTimeout(name, HANDLER_NAMED_AFTER_MS);
+		naming.unref?.();
+		let onAbort: (() => void) | undefined;
+		try {
+			if (signal === undefined || signal.aborted) return await pending;
+			const stopped = new Promise<never>((_, reject) => {
+				onAbort = () => {
+					const message = `extension ${ext.path}'s ${event} handler was let go, as its run stopped while it was pending`;
+					reject(Object.assign(new Error(message), { [handlerLetGo]: true }));
+				};
+				signal.addEventListener("abort", onAbort, { once: true });
+			});
+			return await Promise.race([pending, stopped]);
+		} catch (err) {
+			if (isHandlerLetGo(err)) {
+				pending.then(undefined, (late: unknown) => {
+					this.emitError({
+						extensionPath: ext.path,
+						event,
+						error: `after it was let go: ${late instanceof Error ? late.message : String(late)}`,
+						stack: late instanceof Error ? late.stack : undefined,
+					});
+				});
+			}
+			throw err;
+		} finally {
+			clearTimeout(naming);
+			if (onAbort !== undefined) signal?.removeEventListener("abort", onAbort);
+		}
+	}
