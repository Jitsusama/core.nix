+function finishedBefore(evaluation: Evaluation, file: string): CachedModule | undefined {
+	for (let from = evaluation.parent; from !== undefined; from = from.parent) {
+		const module = from.own.get(file);
+		if (module?.loaded) return module;
+	}
+	return evaluation.modules.finished.get(file);
