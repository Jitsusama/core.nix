+type Jiti = ReturnType<typeof createJiti>;
+type ModuleCache = NonNullable<NonNullable<Parameters<Jiti["evalModule"]>[1]>["cache"]>;
+type CachedModule = ModuleCache[string];
+interface PackageModules {
+	// The package's folder.
+	root: string;
+	// Each module its loads and their imports have finished, by file.
+	finished: Map<string, CachedModule>;
+	// Settles once the package's latest load gives up its turn: as it ends,
+	// or as it goes on without waiting its turn.
+	turn: Promise<void>;
+	// Whether these modules have been let go.
+	dropped: boolean;
+	// Whether a load has run past TURN_HELD_MS and not yet ended.
+	overdue: boolean;
+	// Starts each load still waiting for its turn.
+	waiting: Set<() => void>;
+	// Each import a finished module makes, evaluating in an evaluation of
+	// its own, by file, for another import of it from the same evaluation
+	// to join.
+	alone: Map<string, { from: Evaluation; imported: Promise<unknown> }>;
+}
+
+// What one load, or one import a finished module makes, evaluates.
+interface Evaluation {
+	modules: PackageModules;
+	// The evaluation that finished the module making this one's import.
+	parent: Evaluation | undefined;
+	// The modules it has evaluated, finished or not, by file.
+	own: Map<string, CachedModule>;
+	ended: boolean;
+	// Whether what it finished joined its package's.
+	kept: boolean;
+	// What jiti is given as its cache: its own modules, then those finished
+	// before it.
+	cache: ModuleCache;
+}
+
+// How long a load may hold its package's turn before the loads after it
+// go on without waiting theirs: long past what evaluating one extension
+// takes.
+const TURN_HELD_MS = 10_000;
+
+function newPackageModules(root: string): PackageModules {
+	return {
+		root,
+		finished: new Map(),
+		turn: Promise.resolve(),
+		dropped: false,
+		overdue: false,
+		waiting: new Set(),
+		alone: new Map(),
+	};
+}
+
+function newEvaluation(modules: PackageModules, parent?: Evaluation): Evaluation {
+	const own = new Map<string, CachedModule>();
+	const evaluation: Evaluation = { modules, parent, own, ended: false, kept: false, cache: {} };
+	evaluation.cache = new Proxy(Object.create(null), {
+		get: (_, file) => (typeof file === "string" ? (own.get(file) ?? finishedBefore(evaluation, file)) : undefined),
+		set: (_, file, module: unknown) => {
+			if (typeof file === "string" && isCachedModule(module)) {
+				own.set(file, module);
+				importsAlone(module, evaluation);
+			}
