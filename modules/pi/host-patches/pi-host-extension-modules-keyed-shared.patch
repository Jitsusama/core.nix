+// pi-host: a keyed package's extensions share the modules they import, too.
+// jiti gives each import of an extension a module cache of its own, so a
+// library its extensions share was evaluated once for each extension
+// importing it. A keyed package's loads share one cache instead, which
+// jiti's evalModule takes and hands to every module it evaluates, so each
+// file they reach, inside the package or not, is evaluated once for the
+// host. The cache is the package's own and never Node's, so no other
+// package's load reads what it holds, and its loads read nothing the host
+// put in Node's. An import an extension makes later, as it runs, goes in the
+// same cache. A reload, or the package's last shared extension resolving
+// elsewhere, gives its next load a new cache. A load keeps the cache it
+// began with, so its own modules stay one graph, and nothing it reads
+// reaches a load begun after. The package's loads take turns, so none is
+// given a module another is still evaluating; a load that never ends holds
+// up its package's loads until a reload. A failed load forgets the modules
+// it left unfinished, so the next load evaluates them again, and keeps those
+// it finished, as Node's require does.
+type Jiti = ReturnType<typeof createJiti>;
+type ModuleCache = NonNullable<NonNullable<Parameters<Jiti["evalModule"]>[1]>["cache"]>;
+interface PackageModules {
+	cache: ModuleCache;
+	// Settles once the package's latest load has.
+	turn: Promise<void>;
+}
+// Each keyed package's modules, by its folder.
+const packageModules = new Map<string, PackageModules>();
+// The folder of each keyed manifest found since the last reload.
+const keyedRoots = new Set<string>();
+
+function keyedRootOf(file: string): string | undefined {
+	for (let folder = path.dirname(file); ; folder = path.dirname(folder)) {
+		if (keyedRoots.has(folder)) return folder;
+		if (path.dirname(folder) === folder) return undefined;
+	}
+}
+
+function isUnder(file: string, root: string): boolean {
+	return file.startsWith(root.endsWith(path.sep) ? root : root + path.sep);
+}
+
+// Lets go of the keyed package at `root`'s modules once no shared extension
+// resolves into it.
+function forgetModulesOfUnusedRoot(root: string | undefined): void {
+	if (root === undefined) return;
+	for (const file of sharedFiles.values()) if (isUnder(file, root)) return;
+	packageModules.delete(root);
+}
+
+// The modules of the keyed package a shared extension's file belongs to.
+function packageModulesOf(file: string): PackageModules | undefined {
+	const root = keyedRootOf(file);
+	if (root === undefined) return undefined;
+	let modules = packageModules.get(root);
+	if (modules === undefined) {
+		modules = { cache: {}, turn: Promise.resolve() };
+		packageModules.set(root, modules);
+	}
+	return modules;
 }
 
+// Whether jiti's import of `file` would evaluate it itself: a file of a kind
+// it compiles, with no native import tried first. Any other file is imported
+// as pi imports it.
+function evaluatesItself(jiti: Jiti, file: string): boolean {
+	return !jiti.options.tryNative && (jiti.options.extensions ?? []).includes(path.extname(file));
+}
+
+// What jiti's import with `default: true` gives for a module's exports.
+function defaultOf(module: unknown): unknown {
+	if ((typeof module !== "object" && typeof module !== "function") || module === null) return module;
+	return Reflect.get(module, "default") ?? module;
+}
+
+// Imports the shared extension at `file` through its package's modules, in
+// the package's turn.
+async function importShared(jiti: Jiti, file: string, modules: PackageModules): Promise<unknown> {
+	const { cache } = modules;
+	const imported = modules.turn.then(async () => {
+		const known = cache[file];
