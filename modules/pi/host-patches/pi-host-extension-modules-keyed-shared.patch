+// finished to its package's, so what it finishes may join too. Each has
+// ended, since an import evaluates alone only once its evaluation has.
+function stands(evaluation: Evaluation): boolean {
+	for (let from = evaluation.parent; from !== undefined; from = from.parent) {
+		if (!from.kept) return false;
+	}
+	return true;
