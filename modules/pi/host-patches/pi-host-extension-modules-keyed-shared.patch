+// pi-host: a keyed package's extensions share the modules they import, too.
+// Each import of an extension starts a module cache of its own, so a library
+// its extensions share was evaluated once for each extension importing it.
+// A keyed package's loads use Node's module cache instead, which every load
+// reads, so each of its files is evaluated once for the host. A load of any
+// other package, or one with no cache, neither reads nor writes it, so its
+// modules stay its own. What a package's loads left there goes at a reload,
+// and once no shared extension resolves into its folder, as when a link has
+// moved on or a load begun before a reload ends. jiti reads a file it
+// compiles and caches it in one synchronous step, so what a load begun
+// before a reload caches after it was read after it too; only a .js or .mjs
+// file whose native import fails, compiled from what jiti read before, can
+// be older.
+const moduleCache = require.cache;
+// The folder of each keyed manifest found since the last reload.
+const keyedRoots = new Set<string>();
+
+function keyedRootOf(file: string): string | undefined {
+	for (let folder = path.dirname(file); ; folder = path.dirname(folder)) {
+		if (keyedRoots.has(folder)) return folder;
+		if (path.dirname(folder) === folder) return undefined;
+	}
+}
+
+function isUnder(file: string, root: string): boolean {
+	return file.startsWith(root.endsWith(path.sep) ? root : root + path.sep);
+}
+
+function forgetModulesUnder(root: string): void {
+	for (const file of Object.keys(moduleCache)) {
+		if (isUnder(file, root)) delete moduleCache[file];
+	}
+}
+
+// Forgets what loads left under `root` once no shared extension resolves
+// into it.
+function forgetModulesOfUnusedRoot(root: string | undefined): void {
+	if (root === undefined) return;
+	for (const file of sharedFiles.values()) if (isUnder(file, root)) return;
+	forgetModulesUnder(root);
+}
+
+// The jiti its extension's load uses: one that reads and writes Node's module
+// cache when the extension belongs to the keyed package whose folder is
+// `root`, and forgets what the load left there once it ends, if no shared
+// extension resolves into that folder by then. Any other load's jiti is as
+// pi makes it. jiti's import reads the instance it closes over, never `this`,
+// so it is called as it was taken.
+function sharingModulesUnder(root: string | undefined, create: typeof createJiti): typeof createJiti {
+	if (root === undefined) return create;
+	return (id, options) => {
+		const jiti = create(id, { ...options, moduleCache: true });
+		const importOf = jiti.import;
+		jiti.import = async <T = unknown>(module: string, opts?: Parameters<typeof importOf>[1]): Promise<T> => {
+			try {
+				return await importOf<T>(module, opts);
+			} finally {
+				forgetModulesOfUnusedRoot(root);
+			}
+		};
+		return jiti;
+	};
