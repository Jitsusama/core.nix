+			for (const [name, module] of Object.entries(cache)) if (!module.loaded) delete cache[name];
+			throw error;
+		}
+	});
+	modules.turn = imported.then(
+		() => undefined,
+		() => {
+			// The load that failed says why; the next takes its turn regardless.
+		},
+	);
+	return defaultOf(await imported);
+}
