+// pi-host: an event's handlers run one extension after another, so a conversation's
+// session_start costs the sum of every extension's, and one slow extension holds every
+// open, reload and wake behind it. The runner keeps its extensions private, so nothing
+// outside it can say which one is slow: say it here, on stderr, which a host's
+// conversation sends to its journal, for each extension whose handlers for one event
+// took this long or longer. Only emit, which sends session_start, and
+// emitResourcesDiscover are timed; the events with loops of their own are not. The time
+// is the wall's, awaits included, since that is what the open waited on it, so it counts
+// whatever else the thread ran meanwhile; each line stands for this much time waited.
+const SLOW_HANDLERS_MS = 250;
+
+function sayIfSlow(ext: Extension, event: ExtensionEvent["type"], startedAt: number): void {
+	const took = performance.now() - startedAt;
+	if (took < SLOW_HANDLERS_MS) return;
+	process.stderr.write(`pi-host: ${JSON.stringify(ext.path)} ${event} took ${Math.round(took)} ms\n`);
+}
+
 function sameMessages(left: AgentMessage[], right: AgentMessage[]): boolean {
 	return left.length === right.length && left.every((message, index) => message === right[index]);
