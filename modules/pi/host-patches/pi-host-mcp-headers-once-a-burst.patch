+// pi-host: a host opens every conversation's MCP connections in its one
+// process, and each resolves its headers afresh, running any command they
+// name while the whole host waits. Run the command without holding the
+// host, and let the connections opened within FRESH_COMMAND_MS share its one
+// run, so a burst of wakes runs it once. A run that resolved nothing isn't
+// kept, so the next connection tries again.
+const FRESH_COMMAND_MS = 30_000;
+const freshCommandRuns = new Map<string, { at: number; value: Promise<string | undefined> }>();
+
+function executeCommandAsync(commandConfig: string): Promise<string | undefined> {
+	if (process.platform === "win32") return Promise.resolve(executeCommandUncached(commandConfig));
+	return new Promise((resolve) => {
+		const child = exec(commandConfig.slice(1), { encoding: "utf-8", timeout: 10000 }, (error, stdout) => {
+			resolve(error ? undefined : stdout.trim() || undefined);
+		});
+		child.stdin?.end();
+	});
+}
+
+function executeCommandFresh(commandConfig: string): Promise<string | undefined> {
+	const now = Date.now();
+	const held = freshCommandRuns.get(commandConfig);
+	if (held && now - held.at < FRESH_COMMAND_MS) return held.value;
+	const run = { at: now, value: executeCommandAsync(commandConfig) };
+	freshCommandRuns.set(commandConfig, run);
+	void run.value.then((value) => {
+		if (value === undefined && freshCommandRuns.get(commandConfig) === run) freshCommandRuns.delete(commandConfig);
+	});
+	return run.value;
+}
+
+/**
+ * pi-host: resolve a config value as resolveConfigValueUncached does, but run a command without
+ * blocking, sharing a run made within the last FRESH_COMMAND_MS.
+ */
+export function resolveConfigValueFresh(config: string, env?: Record<string, string>): Promise<string | undefined> {
+	const reference = parseConfigValueReference(config);
+	if (reference.type === "command") {
+		return executeCommandFresh(reference.config);
+	}
+	return Promise.resolve(resolveTemplate(reference.parts, env));
+}
+
+/** pi-host: resolveConfigValueOrThrow through resolveConfigValueFresh. */
+export async function resolveConfigValueFreshOrThrow(
+	config: string,
+	description: string,
+	env?: Record<string, string>,
+): Promise<string> {
+	const resolvedValue = await resolveConfigValueFresh(config, env);
+	if (resolvedValue !== undefined) {
+		return resolvedValue;
+	}
+	throw unresolvedError(config, description, env);
+}
+
+/** pi-host: resolveHeadersOrThrow through resolveConfigValueFresh. */
+export async function resolveHeadersFreshOrThrow(
+	headers: Record<string, string> | undefined,
+	description: string,
+	env?: Record<string, string>,
+): Promise<Record<string, string> | undefined> {
+	if (!headers) return undefined;
+	const resolved: Record<string, string> = {};
+	for (const [key, value] of Object.entries(headers)) {
+		resolved[key] = await resolveConfigValueFreshOrThrow(value, `${description} header "${key}"`, env);
+	}
+	return Object.keys(resolved).length > 0 ? resolved : undefined;
+}
