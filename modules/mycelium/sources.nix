# The sources mycelium's receptors read, as its `Source::name` names them.
# Kept in a file of its own so a check can hold it to the locked mycelium's
# source: a name the node no longer knows makes it refuse the whole table,
# which silences every source with nothing failing.
[
  "slack"
  "mail"
  "calendar"
  "calls"
  "reviews"
  "github"
  "messages"
]
