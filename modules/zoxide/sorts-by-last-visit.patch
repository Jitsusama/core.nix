+    #[test]
+    fn last_accessed_lists_the_newest_first() {
+        let db = &mut Database::new(PathBuf::new(), Vec::new(), |_| Vec::new(), false);
+        db.add("/often", 100.0, 10);
+        db.add("/lately", 1.0, 30);
+        db.add("/once", 1.0, 20);
+        let options = StreamOptions::new(40).sort_by(Some(Ordering::LastAccessed));
+        let mut stream = Stream::new(db, options);
+        let mut paths = Vec::new();
+        while let Some(dir) = stream.next() {
+            paths.push(dir.path.to_string());
+        }
+        assert_eq!(paths, ["/lately", "/once", "/often"]);
+    }
