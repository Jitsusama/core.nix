# The script face: Noto, script by script, for the scripts the theme's own
# faces lack. Without it Hebrew and Arabic fell back to the machine's
# default sans, drawn for neither. CJK's Japanese cut, since its kana and
# kanji serve the Japanese calendar and its Han serve the Chinese one. The
# theme's font.script.families defaults to these, and the machine's fonts
# install them, so their names live here alone.
[
  "Noto Sans Hebrew"
  "Noto Naskh Arabic"
  "Noto Sans CJK JP"
]
