# shellcheck shell=bash
use flake ../..
# The scenarios make, settle and delete thousands of files, so they run on
# the account's runtime tmpfs rather than commit the machine's own disk.
if [ -d "${XDG_RUNTIME_DIR:-}" ]; then
  TMPDIR="$XDG_RUNTIME_DIR/disk-guard-scenarios"
  mkdir -p "$TMPDIR"
  export TMPDIR
fi
