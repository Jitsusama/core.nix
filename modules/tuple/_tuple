#compdef tuple
# Tuple's command line ships no completion, so this one completes its
# commands, and asks Tuple what an argument can be as it's wanted: a copied
# call's link for join, a contact for favorite and unfavorite, found by any
# part of a name or an email and put in as the ID Tuple takes, and for set,
# a setting's name and then the values Tuple says it takes.

# A call link on the clipboard, as one copied from a chat arrives.
(( $+functions[_tuple_link] )) || _tuple_link() {
  local expl
  local -a links
  links=(${(f)"$(@wlPaste@ --no-newline --type text 2>/dev/null |
    @grep@ -oE 'https://(production\.)?tuple\.app/c/[A-Za-z0-9_-]+')"})
  if (( $#links )); then
    _wanted links expl 'copied call link' compadd -a links
  else
    _message 'a call link (none is copied)'
  fi
}

# Contacts as tuple ls lists them, "ID Name <email> [status]", favourites
# ending "(favorite)": the favourites for unfavorite and the rest for
# favorite, matched on what's typed anywhere in the name or email.
(( $+functions[_tuple_contact] )) || _tuple_contact() {
  local favourites=$1 expl line MATCH MBEGIN MEND
  local -a match mbegin mend ids shown
  for line in ${(f)"$(tuple ls 2>/dev/null | @grep@ -iF -- "$PREFIX")"}; do
    [[ $line =~ '^ *([0-9]+) (.*) \[[^]]*\]( \(favorite\))?$' ]] || continue
    if [[ -n $match[3] && -n $favourites || -z $match[3] && -z $favourites ]]; then
      ids+=($match[1])
      shown+=("$match[1]  $match[2]")
    fi
  done
  if (( $#ids )); then
    # What's typed is a name, and what goes in is the ID, so the matches
    # aren't held to what's typed, and are gone through one by one rather
    # than cut to what their IDs share.
    (( $#ids > 1 )) && compstate[insert]=menu
    _wanted contacts expl contact compadd -U -l -d shown -a ids
  else
    _message 'a contact, by name or email'
  fi
}

# The settings as tuple settings lists them, "name | value | what it is
# (choices)", for the name, said with what it is now, and then the value.
(( $+functions[_tuple_setting] )) || _tuple_setting() {
  local line name now what
  local -a names
  for line in ${(f)"$(tuple settings 2>/dev/null)"}; do
    name=${${line%% |*}// /}
    now=${${${line#* | }%% |*}// /}
    what=${${line##*| }% \(*\)}
    names+=("$name:$what, now ${now:-unset}")
  done
  _describe -t settings setting names
}

(( $+functions[_tuple_value] )) || _tuple_value() {
  local line name=$1 now what expl
  local -a choices
  line=${(M)${(f)"$(tuple settings 2>/dev/null)"}:#${name} |*}
  [[ -n $line ]] || { _message value; return }
  now=${${${line#* | }%% |*}// /}
  what=${line##*| }
  if [[ $what == *'('*'|'*')' ]]; then
    choices=(${(s:|:)${${what##*\(}%\)}})
    _wanted values expl "value (now ${now:-unset})" compadd -a choices
  elif [[ $what == (#i)*file* ]]; then
    _files
  else
    _message "value (now ${now:-unset})"
  fi
}

_tuple() {
  local -a commands=(
    'login:start logging in'
    'auth:finish logging in with the code the browser gives'
    'logout:log out'
    'call:call someone'
    'join:join a call by its link'
    'new:start a call in your own room and join it'
    'end:end or leave the call'
    'ls:list contacts'
    'favorite:make a contact a favourite'
    'unfavorite:stop a contact being a favourite'
    'share:share your screen'
    'unshare:stop sharing your screen'
    'mute:mute your microphone'
    'unmute:unmute your microphone'
    'on:start the daemon, so calls reach you'
    'off:stop the daemon'
    'ui:show the debugging window'
    'settings:list the settings and their values'
    'set:change a setting'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'tuple command' commands
    return
  fi
  case $words[2] in
    join) (( CURRENT == 3 )) && _tuple_link ;;
    auth) (( CURRENT == 3 )) && _message 'the code the browser gives' ;;
    favorite) (( CURRENT == 3 )) && _tuple_contact ;;
    unfavorite) (( CURRENT == 3 )) && _tuple_contact favourites ;;
    set)
      case $CURRENT in
        3) _tuple_setting ;;
        4) _tuple_value $words[3] ;;
      esac
      ;;
  esac
}

_tuple "$@"
