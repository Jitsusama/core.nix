+static void wpas_scan_after_failure(struct wpa_supplicant *wpa_s,
+				    const u8 *bssid)
+{
+	int timeout;
+
+	wpa_s->consecutive_conn_failures++;
+
+	if (wpa_s->consecutive_conn_failures > 3 && wpa_s->current_ssid) {
+		wpa_printf(MSG_DEBUG, "Continuous association failures - "
+			   "consider temporary network disabling");
+		wpas_auth_failed(wpa_s, "CONN_FAILED", bssid);
+	}
+	/*
+	 * Multiple consecutive connection failures mean that other APs are
+	 * either not available or have already been tried, so we can start
+	 * increasing the delay here to avoid constant scanning.
+	 */
+	switch (wpa_s->consecutive_conn_failures) {
+	case 1:
+		timeout = 100;
+		break;
+	case 2:
+		timeout = 500;
+		break;
+	case 3:
+		timeout = 1000;
+		break;
+	case 4:
+		timeout = 5000;
+		break;
+	default:
+		timeout = 10000;
+		break;
+	}
+
+	wpa_dbg(wpa_s, MSG_DEBUG,
+		"Consecutive connection failures: %d --> request scan in %d ms",
+		wpa_s->consecutive_conn_failures, timeout);
+
+	/* speed up the connection attempt with normal scan */
+	wpa_s->normal_scans = 0;
+	wpa_supplicant_req_scan(wpa_s, timeout / 1000,
+				1000 * (timeout % 1000));
+}
+
+
+/*
+ * Whether the last scan heard another BSS with the SSID of the one that
+ * failed, and that BSS isn't being ignored itself.
+ */
+static bool wpas_ess_has_another_bss(struct wpa_supplicant *wpa_s,
+				     const u8 *failed_bssid)
+{
+	struct wpa_bss *failed = wpa_bss_get_bssid_latest(wpa_s, failed_bssid);
+	size_t i;
+
+	if (!failed)
+		return false;
+	for (i = 0; i < wpa_s->last_scan_res_used; i++) {
+		struct wpa_bss *bss = wpa_s->last_scan_res[i];
+
+		if (bss == failed || bss->ssid_len != failed->ssid_len ||
+		    os_memcmp(bss->ssid, failed->ssid, failed->ssid_len) != 0 ||
+		    wpa_bssid_ignore_is_listed(wpa_s, bss->bssid))
+			continue;
+		return true;
+	}
+	return false;
+}
+
+
+/*
+ * Picks the next BSS from the last scan once the caller has marked the
+ * failed attempt over. Picked while it still stands, the BSS just tried
+ * reads as the one being joined, so nothing is tried, no scan is asked for
+ * either, and the interface waits with nothing pending. Nothing is picked
+ * if the interface was disconnected or another attempt began meanwhile.
+ *
+ * Where the last scan heard another BSS of the same ESS, that one is tried
+ * rather than the one that just failed: an access point that ignores a
+ * station's first authentication after a boot otherwise costs a second
+ * failure and a full scan before its neighbour is tried.
+ */
+static void wpas_retry_failed_bss(void *eloop_ctx, void *timeout_ctx)
+{
+	struct wpa_supplicant *wpa_s = eloop_ctx;
+
+	if (wpa_s->disconnected || wpa_s->connect_work ||
+	    radio_work_pending(wpa_s, "sme-connect") ||
+	    radio_work_pending(wpa_s, "connect"))
+		return;
+	if (!is_zero_ether_addr(wpa_s->retry_failed_bssid) &&
+	    wpas_ess_has_another_bss(wpa_s, wpa_s->retry_failed_bssid)) {
+		wpa_dbg(wpa_s, MSG_DEBUG,
+			"Another BSS of the ESS was heard; trying it before "
+			MACSTR " again", MAC2STR(wpa_s->retry_failed_bssid));
+		wpa_bssid_ignore_add(wpa_s, wpa_s->retry_failed_bssid);
+	}
+	if (wpa_supplicant_fast_associate(wpa_s) == 1)
+		return;
+	wpas_scan_after_failure(wpa_s,
+				is_zero_ether_addr(wpa_s->retry_failed_bssid) ?
+				NULL : wpa_s->retry_failed_bssid);
+}
