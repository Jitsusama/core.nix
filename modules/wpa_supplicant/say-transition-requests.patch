+/**
+ * wpas_dbus_signal_bss_tm_request - Signals a BSS Transition Management
+ * request from the access point
+ * @wpa_s: %wpa_supplicant network interface data
+ * @disassociating: Whether the request warns the station is about to be
+ *	disassociated, from this BSS or from the whole ESS
+ * @disassociation_ms: In how long, where it warns
+ * @valid_ms: How long the candidate list holds
+ * @candidates: The candidates, in the order the access point gave them
+ * @num_candidates: How many there are
+ *
+ * Said as one dictionary: Disassociating (b), DisassociationMs (u),
+ * ValidMs (u) and Candidates (a(ayn)), each candidate its BSSID and its
+ * preference, or -1 where the access point gave none.
+ */
+void wpas_dbus_signal_bss_tm_request(struct wpa_supplicant *wpa_s,
+				     bool disassociating,
+				     unsigned int disassociation_ms,
+				     unsigned int valid_ms,
+				     const struct neighbor_report *candidates,
+				     unsigned int num_candidates)
+{
+	struct wpas_dbus_priv *iface;
+	DBusMessage *msg;
+	DBusMessageIter iter, dict, entry, value, array, candidate, bssid;
+	unsigned int i;
+
+	iface = wpa_s->global->dbus;
+
+	/* Do nothing if the control interface is not turned on */
+	if (!iface || !wpa_s->dbus_new_path)
+		return;
+
+	msg = dbus_message_new_signal(wpa_s->dbus_new_path,
+				      WPAS_DBUS_NEW_IFACE_INTERFACE,
+				      "BSSTransitionRequested");
+	if (!msg)
+		return;
+
+	dbus_message_iter_init_append(msg, &iter);
+	if (!wpa_dbus_dict_open_write(&iter, &dict) ||
+	    !wpa_dbus_dict_append_bool(&dict, "Disassociating",
+				       disassociating) ||
+	    !wpa_dbus_dict_append_uint32(&dict, "DisassociationMs",
+					 disassociation_ms) ||
+	    !wpa_dbus_dict_append_uint32(&dict, "ValidMs", valid_ms) ||
+	    !wpa_dbus_dict_begin_array(&dict, "Candidates", "(ayn)",
+				       &entry, &value, &array))
+		goto fail;
+	for (i = 0; i < num_candidates; i++) {
+		const u8 *address = candidates[i].bssid;
+		dbus_int16_t preference = candidates[i].preference_present ?
+			candidates[i].preference : -1;
+
+		if (!dbus_message_iter_open_container(&array, DBUS_TYPE_STRUCT,
+						      NULL, &candidate) ||
+		    !dbus_message_iter_open_container(&candidate,
+						      DBUS_TYPE_ARRAY,
+						      DBUS_TYPE_BYTE_AS_STRING,
+						      &bssid) ||
+		    !dbus_message_iter_append_fixed_array(&bssid, DBUS_TYPE_BYTE,
+							  &address,
+							  ETH_ALEN) ||
+		    !dbus_message_iter_close_container(&candidate, &bssid) ||
+		    !dbus_message_iter_append_basic(&candidate, DBUS_TYPE_INT16,
+						    &preference) ||
+		    !dbus_message_iter_close_container(&array, &candidate))
+			goto fail;
+	}
+	if (!wpa_dbus_dict_end_array(&dict, &entry, &value, &array) ||
+	    !wpa_dbus_dict_close_write(&iter, &dict))
+		goto fail;
+
+	dbus_connection_send(iface->con, msg, NULL);
+	dbus_message_unref(msg);
+	return;
+
+fail:
+	wpa_printf(MSG_ERROR, "dbus: Failed to construct signal");
+	dbus_message_unref(msg);
+}
