# The boot's screen, laid out as the lock screen lays itself out
# (../quickshell/Lock.qml): the picture, the machine's name where the lock
# screen has the time, what's happening under it where the lock screen has
# the day, and the prompt's panel in the same place. Everything but a
# message is drawn when the theme is built (./nixos.nix), at one and two
# device pixels to a logical one, so this only places pictures.

# Plymouth draws one canvas as large as the largest screen in each
# direction, and each screen shows the part of it centred on its own size,
# so a smaller screen sees only the canvas's middle. The picture covers the
# whole canvas, so every screen is covered; everything else is placed in the
# rectangle every screen shows, the smallest width by the smallest height,
# centred on the canvas. A screen can come after this starts, as a monitor
# behind a hub does once its link is up, so all of it is laid out again
# whenever a screen comes or goes.

fun drawn(name)
  {
    return Image(name + "-" + global.scale + ".png");
  }

fun placed(image, x, y, z)
  {
    local.sprite = Sprite(image);
    sprite.SetPosition(Math.Int(x), Math.Int(y), z);
    return sprite;
  }

# A sprite showing an image at a place, made the first time it's needed.
fun sprite_at(sprite, image, x, y, z)
  {
    if (!sprite)
      sprite = Sprite();
    sprite.SetImage(image);
    sprite.SetPosition(Math.Int(x), Math.Int(y), z);
    return sprite;
  }

Window.SetBackgroundTopColor(@deepest@);
Window.SetBackgroundBottomColor(@deepest@);

picture.image = Image("picture.png");
scale = 0;

# Plymouth draws at the screens' own pixels here, so the scale is chosen by
# the shared rectangle's height: screens with more rows than a 16:10
# laptop's at one to one take the pictures drawn at two. These are the
# pictures and the sizes that follow from it.
fun drawn_at_scale()
  {
    global.pad = @pad@ * global.scale;
    global.apart = @apart@ * global.scale;

    global.name.image = drawn("name");
    global.under.images["starting"] = drawn("starting");
    global.under.images["locked"] = drawn("locked");
    global.under.images["restarting"] = drawn("restarting");
    global.under.images["stopping"] = drawn("stopping");
    global.under.height = global.under.images["starting"].GetHeight() - 2 * global.pad;
    global.about.image = drawn("about");
    global.about.numbered = drawn("about-generation");
@digitImages@
    global.about.advance = (drawn("digits").GetWidth() - 2 * global.pad) / 10;

    global.panel.calm = drawn("panel");
    global.panel.urgent = drawn("panel-urgent");
    global.panel.reach = @reach@ * global.scale;
    global.lock.image = drawn("lock");
    global.hints["pin"] = drawn("hint-pin");
    global.hints["passphrase"] = drawn("hint-passphrase");
    global.hints["recovery"] = drawn("hint-recovery");
    global.hints["again"] = drawn("hint-again");
    global.dot = drawn("dot");
    global.step = global.dot.GetWidth() + @dotSpacing@ * global.scale;
    global.caret.image = drawn("caret");

    global.halo.left = drawn("halo-left");
    global.halo.middle = drawn("halo-middle");
    global.halo.right = drawn("halo-right");
    global.halo.inner = @haloInner@ * global.scale;
  }

# What's happening, under the name, as the boot or shutdown goes.
fun says(what)
  {
    global.under.showing = what;
    local.image = global.under.images[what];
    global.under.sprite = sprite_at(global.under.sprite, image,
                                    global.middle - image.GetWidth() / 2,
                                    global.under.top - global.pad, 10);
  }

# Everything placed for the screens there are now: the canvas, the shared
# rectangle, the scale, then each picture from the bottom of that rectangle
# up, as Lock.qml stacks its column: a line for what the boot says, the
# prompt's panel, then the name over what's happening, each a step of space
# apart, and what the boot is, small at the bottom left.
fun lay_out()
  {
    global.width = Window.GetWidth();
    global.height = Window.GetHeight();
    local.across = global.width;
    local.down = global.height;
    for (index = 0; Window.GetWidth(index); index++)
      {
        across = Math.Min(across, Window.GetWidth(index));
        down = Math.Min(down, Window.GetHeight(index));
      }
    global.shared.left = Math.Int((global.width - across) / 2);
    global.shared.top = Math.Int((global.height - down) / 2);
    global.shared.width = across;
    global.shared.height = down;

    # While no screen is there, the scale stays as it was.
    if (!global.width && global.scale)
      local.wanted = global.scale;
    else if (down >= 1600)
      local.wanted = 2;
    else
      local.wanted = 1;
    if (wanted != global.scale)
      {
        global.scale = wanted;
        drawn_at_scale();
      }

    # The picture covers the canvas, centred, and fades in over the
    # firmware's black as the lock screen's does. With no screen, as for a
    # moment while one is replaced, there's no canvas to cover.
    if (global.picture.image && global.width)
      {
        local.cover = Math.Max(global.width / global.picture.image.GetWidth(),
                               global.height / global.picture.image.GetHeight());
        local.scaled = global.picture.image.Scale(
          Math.Int(global.picture.image.GetWidth() * cover + 0.5),
          Math.Int(global.picture.image.GetHeight() * cover + 0.5));
        local.fresh = !global.picture.sprite;
        global.picture.sprite = sprite_at(global.picture.sprite, scaled,
                                          (global.width - scaled.GetWidth()) / 2,
                                          (global.height - scaled.GetHeight()) / 2, 0);
        if (fresh)
          global.picture.sprite.SetOpacity(0);
      }

    global.middle = global.shared.left + Math.Int(across / 2);
    global.bottom = global.shared.top + down - Math.Int(down / 12);
    global.said.top = global.bottom - @said@ * global.scale;
    global.panel.top = global.said.top - global.apart - @panelHeight@ * global.scale;
    global.head.bottom = global.panel.top - global.apart;
    global.under.top = global.head.bottom - global.under.height;
    global.name.top = global.under.top - (global.name.image.GetHeight() - 2 * global.pad);
    global.name.sprite = sprite_at(global.name.sprite, global.name.image,
                                   global.middle - global.name.image.GetWidth() / 2,
                                   global.name.top - global.pad, 10);
    says(global.under.showing);

    global.about.left = global.shared.left + @aboutLeft@ * global.scale - global.pad;
    global.about.top = global.shared.top + down - @aboutBottom@ * global.scale
                       - global.about.image.GetHeight() + global.pad;
    about_shown();

    # The prompt's panel and what's inside it.
    global.panel.left = global.middle - @panelWidth@ * global.scale / 2;
    global.centre = global.panel.top + @panelHeight@ * global.scale / 2;
    if (global.panel.urging)
      local.frame = global.panel.urgent;
    else
      local.frame = global.panel.calm;
    global.panel.sprite = sprite_at(global.panel.sprite, frame,
                                    global.panel.left - global.panel.reach,
                                    global.panel.top - global.panel.reach, 20);

    global.lock.x = global.panel.left + @glyphLeft@ * global.scale;
    global.lock.sprite = sprite_at(global.lock.sprite, global.lock.image, global.lock.x,
                                   global.centre - global.lock.image.GetHeight() / 2, 21);
    global.typed = global.lock.x + global.lock.image.GetWidth() + @glyphGap@ * global.scale;

    local.hint = global.hints[global.hint.which];
    global.hint.sprite = sprite_at(global.hint.sprite, hint,
                                   global.typed + @hintGap@ * global.scale,
                                   global.centre - hint.GetHeight() / 2, 21);

    for (index = 0; global.dots[index]; index++)
      {
        global.dots[index].SetImage(global.dot);
        global.dots[index].SetPosition(Math.Int(global.typed + index * global.step),
                                       Math.Int(global.centre - global.dot.GetHeight() / 2), 21);
      }
    global.caret.sprite = sprite_at(global.caret.sprite, global.caret.image,
                                    global.typed + global.typing * global.step,
                                    global.centre - global.caret.image.GetHeight() / 2, 22);

    # The words drawn as the boot goes, lifted again at the new places.
    global.status.said = "";
    status_shown();
    if (global.said.text)
      global.said.words = lifted(global.said.text, global.said.top + @said@ * global.scale / 2);
  }

# What the boot is, small at the bottom left, and once the boot says which
# generation it started, the line that goes on to it and its number, each
# digit a digit's width on from the one before. The number starts a space
# after the word, and a space is a digit's width too.
fun about_shown()
  {
    if (global.generation == "")
      local.image = global.about.image;
    else
      local.image = global.about.numbered;
    global.about.sprite = sprite_at(global.about.sprite, image,
                                    global.about.left, global.about.top, 10);
    local.start = global.about.left + image.GetWidth() - 2 * global.pad + global.about.advance;
    for (index = 0; global.generation.CharAt(index) != ""; index++)
      global.about.numbers[index] = sprite_at(global.about.numbers[index],
                                              global.about.digits[global.generation.CharAt(index)],
                                              start + index * global.about.advance,
                                              global.about.top, 10);
  }

# Words drawn as the boot goes, centred on a height, in the body face and
# lifted as the pictures' words are: over the halo drawn with the theme
# (./nixos.nix), stretched to their width, and a copy of them in the
# shadow's colour for the tight shadow.
fun lifted(text, centre)
  {
    local.face = "@sansFamily@ " + @sansBody@ * global.scale;
    local.ink = Image.Text(text, @textColour@, 1, face);
    local.shade = Image.Text(text, @shadowColour@, 1, face);
    local.x = global.middle - ink.GetWidth() / 2;
    local.y = centre - ink.GetHeight() / 2;

    local.box = Math.Max(ink.GetWidth(), global.halo.inner + 1);
    local.left = global.middle - box / 2 + global.halo.inner / 2;
    local.stretch = global.halo.middle.Scale(Math.Int(box - global.halo.inner),
                                             global.halo.middle.GetHeight());
    local.top = y - global.pad;
    local.drawn.halo[0] = placed(global.halo.left, left - global.halo.left.GetWidth(), top, 10);
    local.drawn.halo[1] = placed(stretch, left, top, 10);
    local.drawn.halo[2] = placed(global.halo.right, left + stretch.GetWidth(), top, 10);
    local.drawn.shade = placed(shade, x + @tightX@ * global.scale, y + @tightY@ * global.scale, 11);
    local.drawn.shade.SetOpacity(@tightOpacity@);
    local.drawn.ink = placed(ink, x, y, 12);
    return drawn;
  }

# What the boot or shutdown is waiting on, in the panel's place, which is
# empty but while something is asked. A job that runs long is named with
# the description systemd gives it (./waits); a shutdown's last stage is
# sent as a keyword, and says what it's doing until the end. Each unit
# systemd starts is sent too, and passes unsaid.
@stages@
status.waiting = "";
status.stage = "";
status.said = "";
asked = 0;
generation = "";

fun status_shown()
  {
    if (global.status.stage != "")
      local.text = global.stages[global.status.stage];
    else if (global.status.waiting != "")
      local.text = "waiting on " + global.status.waiting;
    else
      local.text = "";

    if (global.asked || text == "")
      {
        global.status.words = NULL;
        global.status.said = "";
      }
    else if (text != global.status.said)
      {
        global.status.words = lifted(text, global.panel.top + @panelHeight@ * global.scale / 2);
        global.status.said = text;
      }
  }

fun status_callback(text)
  {
    if (global.stages[text])
      global.status.stage = text;
    else if (text.SubString(0, 8) == "waiting:")
      global.status.waiting = text.SubString(8, text.Length());
    else if (text.SubString(0, 11) == "generation:")
      {
        generation_told(text.SubString(11, text.Length()));
        return;
      }
    else
      return;
    status_shown();
  }

# The generation, as ./nixos.nix sends it from the boot loader's entry, kept
# only when it's a number the digits can draw.
fun generation_told(number)
  {
    if (number == "")
      return;
    for (index = 0; number.CharAt(index) != ""; index++)
      if (!global.about.digits[number.CharAt(index)])
        return;
    global.generation = number;
    about_shown();
  }

Plymouth.SetUpdateStatusFunction(status_callback);

# The first layout, for the screens there as this starts.
mode = Plymouth.GetMode();
if (mode == "shutdown")
  under.showing = "stopping";
else if (mode == "reboot")
  under.showing = "restarting";
else
  under.showing = "starting";
hint.which = "pin";
typing = 0;
lay_out();
Plymouth.SetDisplayHotplugFunction(lay_out);

fun asking(shown)
  {
    global.asked = shown;
    status_shown();
    global.panel.sprite.SetOpacity(shown);
    global.lock.sprite.SetOpacity(shown);
    global.hint.sprite.SetOpacity(shown);
    global.caret.sprite.SetOpacity(shown);
    for (index = 0; global.dots[index]; index++)
      global.dots[index].SetOpacity(0);
  }
asking(0);

# Whether a secret has been sent, so that being asked again means it was
# wrong, as the lock screen says when PAM refuses one.
sent = 0;
wrong = 0;

fun holds(text, part)
  {
    for (index = 0; text.CharAt(index + part.Length() - 1) != ""; index++)
      if (text.SubString(index, index + part.Length()) == part)
        return 1;
    return 0;
  }

fun password_callback(prompt, bullets)
  {
    if (global.sent && bullets == 0)
      global.wrong = 1;
    if (bullets > 0)
      global.wrong = 0;
    global.sent = 0;
    global.typing = bullets;
    says("locked");
    asking(1);

    global.panel.urging = global.wrong;
    if (global.wrong)
      global.panel.sprite.SetImage(global.panel.urgent);
    else
      global.panel.sprite.SetImage(global.panel.calm);

    if (global.wrong)
      global.hint.which = "again";
    else if (holds(prompt, "PIN"))
      global.hint.which = "pin";
    else if (holds(prompt, "ecovery"))
      global.hint.which = "recovery";
    else
      global.hint.which = "passphrase";
    global.hint.sprite.SetImage(global.hints[global.hint.which]);
    if (bullets > 0)
      global.hint.sprite.SetOpacity(0);

    for (index = 0; global.dots[index] || index < bullets; index++)
      {
        if (!global.dots[index])
          global.dots[index] = placed(global.dot, global.typed + index * global.step,
                                      global.centre - global.dot.GetHeight() / 2, 21);
        if (index < bullets)
          global.dots[index].SetOpacity(1);
        else
          global.dots[index].SetOpacity(0);
      }
    global.caret.sprite.SetX(Math.Int(global.typed + bullets * global.step));
  }

fun normal_callback()
  {
    if (global.under.showing == "locked")
      {
        global.sent = 1;
        says("starting");
      }
    asking(0);
  }

Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayNormalFunction(normal_callback);

# What the boot says, such as a disk being checked, on the line below the
# panel, which nothing else uses.
fun message_callback(text)
  {
    global.said.text = text;
    global.said.words = lifted(text, global.said.top + @said@ * global.scale / 2);
  }

fun hide_message_callback(text)
  {
    global.said.text = NULL;
    global.said.words = NULL;
  }

Plymouth.SetDisplayMessageFunction(message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

# The fade, eased out over the lock screen's long motion; Plymouth calls
# this fifty times a second.
frames = @fadeFrames@;
frame = 0;

fun refresh_callback()
  {
    if (!global.picture.sprite || global.frame > global.frames)
      return;
    local.t = global.frame / global.frames;
    global.picture.sprite.SetOpacity(1 - (1 - t) * (1 - t) * (1 - t));
    global.frame++;
  }

Plymouth.SetRefreshFunction(refresh_callback);
