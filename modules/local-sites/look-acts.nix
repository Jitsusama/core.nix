# The launcher's acts on a look, by their words' ids, as Now.qml's
# lookActNames names them. The home module refuses a machine renaming one,
# and the-ask-row-reads-as-for-you holds this list to Now.qml's, so a new act
# there can't leave the refusal blind to it.
[
  "verb:on:look:open"
  "verb:on:look:answer"
  "verb:on:look:clear"
  "verb:on:waiting:go"
  "verb:on:waiting:explain"
  "verb:agent:talk"
]
