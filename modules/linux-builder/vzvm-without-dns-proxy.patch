+  /// Kept for the process's lifetime, as the attachment's network must outlive the guest.
+  private static var network: vmnet_network_ref?
+
+  /// The host's NAT. With its DNS proxy, macOS's Internet Sharing has mDNSResponder
+  /// answer on the host's port 53, where a VPN's own resolver can then no longer bind,
+  /// so without it the guest is put on a vmnet network of its own that serves none.
+  private static func networkAttachment(dnsProxy: Bool) throws -> VZNetworkDeviceAttachment {
+    if dnsProxy {
+      return VZNATNetworkDeviceAttachment()
+    }
+    guard #available(macOS 26.0, *) else {
+      throw VZVMError.config("dnsProxy: false needs macOS 26 or newer")
+    }
+    var status: vmnet_return_t = .VMNET_SUCCESS
+    guard let shared = vmnet_network_configuration_create(.VMNET_SHARED_MODE, &status) else {
+      throw VZVMError.runtime("vmnet network configuration failed: status \(status.rawValue)")
+    }
+    vmnet_network_configuration_disable_dns_proxy(shared)
+    guard let created = vmnet_network_create(shared, &status) else {
+      throw VZVMError.runtime("vmnet network failed: status \(status.rawValue)")
+    }
+    network = created
+    Log.info("guest network: shared vmnet, no DNS proxy")
+    return VZVmnetNetworkDeviceAttachment(network: created)
+  }
