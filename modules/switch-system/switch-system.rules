// The machine's administrators may start a switch to a system, and nothing
// else, without a password: modules/switch-system/nixos.nix says why that
// gives them nothing their password didn't. polkit's own engine reads this,
// in the JavaScript it knows.
polkit.addRule(function (action, subject) {
  if (
    action.id === "org.freedesktop.systemd1.manage-units" &&
    action.lookup("verb") === "start" &&
    /^switch-system@.+\.service$/.test(action.lookup("unit")) &&
    subject.isInGroup("wheel")
  ) {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
