diff --git a/src/tests/first_frame.rs b/src/tests/first_frame.rs
new file mode 100644
index 0000000..b5945f0
--- /dev/null
+++ b/src/tests/first_frame.rs
@@ -0,0 +1,123 @@
+use smithay::reexports::wayland_protocols_wlr::layer_shell::v1::client::zwlr_layer_shell_v1::Layer;
+use smithay::reexports::wayland_protocols_wlr::layer_shell::v1::client::zwlr_layer_surface_v1::Anchor;
+
+use super::*;
+use crate::tests::client::LayerConfigureProps;
+
+/// A niri holding its first frames, as one started with
+/// HOLD_FIRST_FRAME_VARIABLE set is, with one screen.
+fn holding() -> Fixture {
+    let mut f = Fixture::new();
+    f.niri().holds_first_frames = true;
+    f.niri().holding_first_frames = true;
+    f.add_output(1, (1920, 1080));
+    redraw(&mut f);
+    f
+}
+
+/// Draws what's queued, as niri does after each turn of its loop; the
+/// fixture's loop turns niri's only when a client has said something.
+fn redraw(f: &mut Fixture) {
+    f.niri_state().refresh_and_flush_clients();
+}
+
+fn first_frame_shown(f: &mut Fixture) -> bool {
+    let output = f.niri_output(1);
+    f.niri().output_state[&output].first_frame_shown
+}
+
+/// Maps a layer surface covering the screen on the given layer.
+fn map_layer(f: &mut Fixture, layer: Layer) {
+    let anchor = Anchor::Left | Anchor::Right | Anchor::Top | Anchor::Bottom;
+    map_part(f, layer, anchor, (1920, 1080));
+}
+
+/// Maps a layer surface on the given layer, anchored to the given edges,
+/// at the given size.
+fn map_part(f: &mut Fixture, layer: Layer, anchor: Anchor, (w, h): (u16, u16)) {
+    let id = f.add_client();
+    let created = f.client(id).create_layer(None, layer, "");
+    let surface = created.surface.clone();
+    let edges = Anchor::Left | Anchor::Right | Anchor::Top | Anchor::Bottom;
+    created.set_configure_props(LayerConfigureProps {
+        anchor: Some(anchor),
+        // A surface anchored to every edge takes the screen's size.
+        size: (anchor != edges).then_some((u32::from(w), u32::from(h))),
+        ..Default::default()
+    });
+    created.commit();
+    f.roundtrip(id);
+
+    let mapped = f.client(id).layer(&surface);
+    mapped.attach_new_buffer();
+    mapped.set_size(w, h);
+    mapped.ack_last_and_commit();
+    f.double_roundtrip(id);
+    redraw(f);
+}
+
+#[test]
+fn a_held_screen_waits_for_a_background_surface() {
+    let mut f = holding();
+    assert!(!first_frame_shown(&mut f));
+
+    map_layer(&mut f, Layer::Top);
+    assert!(!first_frame_shown(&mut f), "a top surface ended the hold");
+
+    map_layer(&mut f, Layer::Background);
+    assert!(first_frame_shown(&mut f), "the background surface never ended the hold");
+}
+
+#[test]
+fn an_overlay_surface_covering_only_part_never_ends_the_hold() {
+    let mut f = holding();
+
+    // A closed launcher keeps a single pixel mapped in a corner.
+    map_part(&mut f, Layer::Overlay, Anchor::Top | Anchor::Left, (1, 1));
+    assert!(!first_frame_shown(&mut f), "a pixel in a corner ended the hold");
+
+    // The margin is a strip along the top.
+    let top = Anchor::Left | Anchor::Right | Anchor::Top;
+    map_part(&mut f, Layer::Overlay, top, (1920, 40));
+    assert!(!first_frame_shown(&mut f), "a strip along the top ended the hold");
+
+    map_part(&mut f, Layer::Background, top, (1920, 1079));
+    assert!(!first_frame_shown(&mut f), "a background a line short ended the hold");
+
+    map_layer(&mut f, Layer::Background);
+    assert!(first_frame_shown(&mut f), "the wallpaper never ended the hold");
+}
+
+#[test]
+fn an_overlay_surface_ends_the_hold_as_a_greeter_would() {
+    let mut f = holding();
+    map_layer(&mut f, Layer::Overlay);
+    assert!(first_frame_shown(&mut f));
+}
+
+#[test]
+fn the_hold_runs_out() {
+    let mut f = holding();
+    assert!(!first_frame_shown(&mut f));
+
+    f.niri().holding_first_frames = false;
+    f.niri().queue_redraw_all();
+    redraw(&mut f);
+    assert!(first_frame_shown(&mut f));
+
+    // A screen plugged in later, as at a dock, is drawn at once.
+    f.add_output(2, (1920, 1080));
+    let docked = f.niri_output(2);
+    assert!(
+        f.niri().output_state[&docked].first_frame_shown,
+        "a screen that came after the hold was held"
+    );
+}
+
+#[test]
+fn nothing_waits_without_the_setting() {
+    let mut f = Fixture::new();
+    f.add_output(1, (1920, 1080));
+    redraw(&mut f);
+    assert!(first_frame_shown(&mut f));
+}
