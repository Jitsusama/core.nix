From: Joel Gerber <Jitsusama@users.noreply.github.com>
Subject: [PATCH] ipc: report tiled windows' positions in the workspace view

WindowLayout::tile_pos_in_workspace_view was only filled for floating
windows, so a client placing something over a tiled window, such as a
notification kept inside the window under it, couldn't tell where that
window was.

Tiled windows now report it too, taken where the view comes to rest
rather than where it's drawn this frame, and without column or tile
render offsets, so an animation or a gesture in progress sends no layout
change on every frame: the position changes once, when the target does.

---
diff --git a/niri-ipc/src/lib.rs b/niri-ipc/src/lib.rs
index 0aa3cb4..317f84b 100644
--- a/niri-ipc/src/lib.rs
+++ b/niri-ipc/src/lib.rs
@@ -1383,6 +1383,9 @@ pub struct WindowLayout {
     /// Tile position within the current view of the workspace.
     ///
     /// This is the same "workspace view" as in gradients' `relative-to` in the niri config.
+    ///
+    /// For tiled windows, this is where the tile sits once the view comes to rest: it does not
+    /// follow view or tile animations, and changes when their targets change.
     pub tile_pos_in_workspace_view: Option<(f64, f64)>,
     /// Location of the window's visual geometry within its tile.
     ///
diff --git a/src/layout/scrolling.rs b/src/layout/scrolling.rs
index 007bcaf..7493ead 100644
--- a/src/layout/scrolling.rs
+++ b/src/layout/scrolling.rs
@@ -2418,18 +2418,32 @@ impl<W: LayoutElement> ScrollingSpace<W> {
     }
 
     pub fn tiles_with_ipc_layouts(&self) -> impl Iterator<Item = (&Tile<W>, WindowLayout)> {
+        let scale = self.scale;
+        // Positions are taken where the view comes to rest rather than where it is drawn this
+        // frame, so a view animation or a gesture in progress does not send a layout change on
+        // every frame; the position changes once, when the view's target does. Column and tile
+        // render offsets are left out for the same reason.
+        let view_off = -(self.column_x(self.active_column_idx) + self.view_offset.stationary());
+        let col_xs: Vec<f64> = self.column_xs(self.data.iter().copied()).collect();
         self.columns
             .iter()
             .enumerate()
             .flat_map(move |(col_idx, col)| {
-                col.tiles().enumerate().map(move |(tile_idx, (tile, _))| {
-                    let layout = WindowLayout {
-                        // Our indices are 1-based, consistent with the actions.
-                        pos_in_scrolling_layout: Some((col_idx + 1, tile_idx + 1)),
-                        ..tile.ipc_layout_template()
-                    };
-                    (tile, layout)
-                })
+                let col_x = col_xs[col_idx];
+                col.tiles()
+                    .enumerate()
+                    .map(move |(tile_idx, (tile, tile_off))| {
+                        let pos = Point::from((view_off + col_x, 0.)) + tile_off;
+                        // Round to physical pixels.
+                        let pos = pos.to_physical_precise_round(scale).to_logical(scale);
+                        let layout = WindowLayout {
+                            // Our indices are 1-based, consistent with the actions.
+                            pos_in_scrolling_layout: Some((col_idx + 1, tile_idx + 1)),
+                            tile_pos_in_workspace_view: Some(pos.into()),
+                            ..tile.ipc_layout_template()
+                        };
+                        (tile, layout)
+                    })
             })
     }
 
