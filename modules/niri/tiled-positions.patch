+/// Whether two layouts put the window in the same place at the same size, whatever they say
+/// moves it, which is compared by when it began instead.
+fn same_place(a: &WindowLayout, b: &WindowLayout) -> bool {
+    let at_rest = |layout: &WindowLayout| WindowLayout {
+        tile_animation: None,
+        tile_animation_began_ms_ago: None,
+        ..layout.clone()
+    };
+    at_rest(a) == at_rest(b)
+}
+
+/// What a layout says moves its tile, and when that began on the monotonic clock, `now` being
+/// when the layout is sent.
+fn tile_animation_began(layout: &WindowLayout, now: Duration) -> Option<(TileAnimation, Duration)> {
+    let kind = layout.tile_animation?;
+    let ago = Duration::from_secs_f64(layout.tile_animation_began_ms_ago?.max(0.) / 1000.);
+    Some((kind, now.saturating_sub(ago)))
+}
