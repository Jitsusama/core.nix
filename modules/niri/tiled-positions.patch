+/// Fills a tiled window's layout for IPC with the animation moving or resizing its tile that
+/// began last and still runs, and how long ago it began. Of animations that began together, as
+/// those started by one change do, the first given is said.
+pub fn with_ipc_animation<'a>(
+    mut layout: WindowLayout,
+    animations: impl IntoIterator<Item = Option<(TileAnimation, &'a Animation)>>,
+) -> WindowLayout {
+    let mut latest: Option<(TileAnimation, &Animation)> = None;
+    for (kind, anim) in animations.into_iter().flatten() {
+        if anim.is_done() {
+            continue;
+        }
+        let later = match latest {
+            None => true,
+            Some((_, last)) => anim.start_time() > last.start_time(),
+        };
+        if later {
+            latest = Some((kind, anim));
+        }
+    }
+
+    if let Some((kind, anim)) = latest {
+        if let Some(ago) = anim.began_ago() {
+            layout.tile_animation = Some(kind);
+            layout.tile_animation_began_ms_ago = Some(ago.as_secs_f64() * 1000.);
+        }
+    }
+    layout
+}
