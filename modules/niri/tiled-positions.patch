         self.clock.now() >= self.start_time + self.duration
     }
 
+    /// How long ago the animation began, in real time as of now, or `None` once it's done.
+    ///
+    /// The animation's clock runs slower under a slowdown and is set ahead to a frame's
+    /// presentation while it's drawn, so its time is divided back by its rate and put in step
+    /// with the monotonic clock, which is what a client reading niri's IPC has.
+    pub fn began_ago(&self) -> Option<Duration> {
+        if self.is_done() {
+            return None;
+        }
+
+        let rate = self.clock.rate().max(0.001);
+        let on_its_clock = self.clock.now().saturating_sub(self.start_time).div_f64(rate);
+        let clock = self.clock.now_unadjusted();
+        let now = get_monotonic_time();
+        Some(if now >= clock {
+            on_its_clock + (now - clock)
+        } else {
+            on_its_clock.saturating_sub(clock - now)
+        })
+    }
+
     pub fn is_clamped_done(&self) -> bool {
         if self.clock.should_complete_instantly() {
             return true;
