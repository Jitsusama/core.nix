                 };
-                self.render(ctx, output, false, &mut |elem| elements.push(elem.into()));
+                self.render(ctx, output, false, &mut |elem| {
+                    let elem = RescaleRenderElement::from_element(elem, origin, shrink);
+                    elements.push(elem.into())
