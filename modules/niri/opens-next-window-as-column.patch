+
+// The titles of a workspace's columns, left to right, by each one's first window.
+fn columns_of(f: &mut Fixture, workspace: WorkspaceId) -> Vec<String> {
+    let (_, _, ws) = f
+        .niri()
+        .layout
+        .workspaces()
+        .find(|(_, _, ws)| ws.id() == workspace)
+        .expect("the workspace is gone");
+    ws.scrolling()
+        .columns()
+        .filter_map(|column| column.tiles().next())
+        .map(|(tile, _)| {
+            with_toplevel_role(tile.window().toplevel(), |role| {
+                role.title.clone().unwrap_or_default()
+            })
+        })
+        .collect()
+}
+
+// Asks for the next window with an app ID on a workspace, as a column at an index from 1.
+fn expect_column(f: &mut Fixture, app_id: &str, workspace: WorkspaceId, column: usize) {
+    f.niri_state().do_action(
+        Action::OpenNextWindowOn {
+            app_id: String::from(app_id),
+            reference: WorkspaceReference::Id(workspace.get()),
+            column: Some(column),
+        },
+        false,
+    );
+}
+
+#[test]
+fn opens_as_the_column_asked_for_its_app_id() {
+    let mut f = Fixture::new();
+    f.add_output(1, (1920, 1080));
+    let id = f.add_client();
+
+    // Two columns on the first workspace, then the one below it focused.
+    open_with_app_id(&mut f, id, "left", "left");
+    open_with_app_id(&mut f, id, "right", "right");
+    let asked = workspace_of(&mut f, "left");
+    f.niri_state().do_action(Action::FocusWorkspaceDown, false);
+    let focused = f.niri().layout.active_workspace().unwrap().id();
+
+    // The first column asked for opens before both, the second between them, and one past
+    // the last opens last, each without the focus.
+    expect_column(&mut f, "spawned.1", asked, 1);
+    open_with_app_id(&mut f, id, "spawned.1", "first");
+    expect_column(&mut f, "spawned.2", asked, 3);
+    open_with_app_id(&mut f, id, "spawned.2", "third");
+    expect_column(&mut f, "spawned.3", asked, 9);
+    open_with_app_id(&mut f, id, "spawned.3", "last");
+    assert_eq!(
+        columns_of(&mut f, asked),
+        ["first", "left", "third", "right", "last"]
+    );
+    assert_eq!(f.niri().layout.active_workspace().unwrap().id(), focused);
+}
