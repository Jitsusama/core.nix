+/// Whether a client connected through a security context, as a sandbox's does, and so must never
+/// take the focus or open where it is seen.
+pub fn client_is_restricted(client: &Client) -> bool {
+    client
+        .get_data::<ClientState>()
+        .is_some_and(|state| state.restricted)
+}
+
+/// Whether the client with this id connected through a security context. A client that is gone
+/// is taken as unrestricted, since it can no longer open or focus anything.
+///
+/// Through the backend handle rather than `Client::from_id`, which wayland-server keeps to itself.
+pub fn client_id_is_restricted(display: &DisplayHandle, id: ClientId) -> bool {
+    display
+        .backend_handle()
+        .get_client_data(id)
+        .ok()
+        .and_then(|data| {
+            data.downcast_ref::<ClientState>()
+                .map(|state| state.restricted)
+        })
+        .unwrap_or(false)
+}
