+    /// The empty workspace at the end of the active monitor, for a window that opens behind
+    /// what is shown. When that workspace is the one shown, an empty one is added after it.
+    pub fn empty_workspace_behind(&mut self) -> Option<WorkspaceId> {
+        let monitor = self.active_monitor()?;
+        let last = monitor.workspaces.len() - 1;
+        if monitor.active_workspace_idx() == last || monitor.workspaces[last].has_windows_or_name()
+        {
+            monitor.add_workspace_bottom();
+        }
+        monitor.workspaces.last().map(Workspace::id)
+    }
+
+    /// Whether a monitor shows this workspace.
+    pub fn workspace_is_shown(&self, id: WorkspaceId) -> bool {
+        self.monitors()
+            .any(|monitor| monitor.active_workspace_ref().id() == id)
+    }
