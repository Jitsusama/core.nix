diff --git a/src/utils/frame_steps.rs b/src/utils/frame_steps.rs
new file mode 100644
index 00000000..939a9be5
--- /dev/null
+++ b/src/utils/frame_steps.rs
@@ -0,0 +1,139 @@
+//! What a frame drawn after an idle spell spent between being asked for and reaching the screen.
+//!
+//! A shell opening its launcher after a quiet moment saw its frame reach the screen five to seven
+//! refreshes after its swap, though niri queues a redraw the moment a commit lands and renders it
+//! at once. Each step's time is said, by the monotonic clock clients' presentation times use, so a
+//! client's own timings line up with niri's: how long the redraw waited to start, how long it took,
+//! and how long the frame waited for the screen once queued.
+
+use std::time::Duration;
+
+/// How long an output must have shown nothing new for a frame on it to be said.
+///
+/// It's well past any frame, so a steady stream of frames says nothing, and short enough that a
+/// keypress or a launcher opening after a moment's pause is said.
+pub const IDLE: Duration = Duration::from_millis(100);
+
+/// When each step of a frame after an idle spell happened, by the monotonic clock.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct FrameSteps {
+    /// When the redraw was asked of the output, with no frame of it in flight.
+    pub asked: Duration,
+    /// How long the output had gone since its last frame reached the screen.
+    pub idle: Duration,
+    /// When rendering the frame began.
+    pub rendering: Duration,
+    /// When the frame was queued to the display.
+    pub queued: Duration,
+}
+
+impl FrameSteps {
+    /// The steps of a frame asked for at `asked`, when the output had been idle long enough for
+    /// them to be said: none for an output whose last frame is recent, or that has shown none.
+    pub fn after_idle(
+        asked: Duration,
+        last_presented: Option<Duration>,
+        rendering: Duration,
+        queued: Duration,
+    ) -> Option<Self> {
+        let idle = asked.saturating_sub(last_presented?);
+        (idle >= IDLE).then_some(Self {
+            asked,
+            idle,
+            rendering,
+            queued,
+        })
+    }
+
+    /// What the frame spent, once it reached the screen at `presented`, in milliseconds, with the
+    /// refreshes from its ask to the screen when the output's refresh is known.
+    pub fn said(&self, presented: Duration, refresh: Option<Duration>) -> String {
+        let ms = |duration: Duration| duration.as_secs_f64() * 1000.;
+        let waited = self.rendering.saturating_sub(self.asked);
+        let rendered = self.queued.saturating_sub(self.rendering);
+        let shown = presented.saturating_sub(self.queued);
+        let refreshes = refresh
+            .filter(|refresh| !refresh.is_zero())
+            .map(|refresh| {
+                let taken = presented.saturating_sub(self.asked);
+                let frames = taken.as_secs_f64() / refresh.as_secs_f64();
+                // Presentation lies on the refresh grid, so a hair past a whole refresh is one.
+                let frames = (frames - 0.01).ceil().max(1.) as u64;
+                let plural = if frames == 1 { "" } else { "es" };
+                format!("; {frames} refresh{plural} from the ask")
+            })
+            .unwrap_or_default();
+        format!(
+            "a frame after {:.0} ms idle, asked for at {:.1} ms: its render began {:.1} ms later \
+             and took {:.1}, then it reached the screen {:.1} ms after being queued{refreshes}",
+            ms(self.idle),
+            ms(self.asked),
+            ms(waited),
+            ms(rendered),
+            ms(shown),
+        )
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn ms(value: f64) -> Duration {
+        Duration::from_secs_f64(value / 1000.)
+    }
+
+    /// A frame asked for 500 ms after the last, begun 1 ms later and queued 3 ms after that.
+    fn steps() -> FrameSteps {
+        FrameSteps::after_idle(ms(2000.), Some(ms(1500.)), ms(2001.), ms(2004.)).unwrap()
+    }
+
+    #[test]
+    fn a_frame_soon_after_the_last_says_nothing() {
+        assert_eq!(
+            FrameSteps::after_idle(ms(1050.), Some(ms(1000.)), ms(1051.), ms(1053.)),
+            None
+        );
+    }
+
+    #[test]
+    fn an_output_that_has_shown_nothing_says_nothing() {
+        assert_eq!(FrameSteps::after_idle(ms(1050.), None, ms(1051.), ms(1053.)), None);
+    }
+
+    #[test]
+    fn a_frame_after_an_idle_spell_keeps_its_steps() {
+        assert_eq!(
+            FrameSteps::after_idle(ms(2000.), Some(ms(1500.)), ms(2001.), ms(2004.)),
+            Some(FrameSteps {
+                asked: ms(2000.),
+                idle: ms(500.),
+                rendering: ms(2001.),
+                queued: ms(2004.),
+            })
+        );
+    }
+
+    #[test]
+    fn a_frame_says_each_step_and_its_refreshes() {
+        assert_eq!(
+            steps().said(ms(2008.3), Some(ms(8.333))),
+            "a frame after 500 ms idle, asked for at 2000.0 ms: its render began 1.0 ms later and \
+             took 3.0, then it reached the screen 4.3 ms after being queued; 1 refresh from the ask"
+        );
+    }
+
+    #[test]
+    fn a_frame_held_a_while_counts_its_refreshes() {
+        assert!(steps()
+            .said(ms(2050.), Some(ms(8.333)))
+            .ends_with("46.0 ms after being queued; 6 refreshes from the ask"));
+    }
+
+    #[test]
+    fn an_unknown_refresh_counts_none() {
+        assert!(steps()
+            .said(ms(2010.), None)
+            .ends_with("6.0 ms after being queued"));
+    }
+}
