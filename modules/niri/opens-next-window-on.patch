 impl Niri {
+    /// Expects the next window with this app ID to open on this workspace, in place of any
+    /// expectation for it before.
+    pub fn expect_window_on(&mut self, app_id: String, workspace: WorkspaceId) {
+        self.window_openings
+            .retain(|(id, _, at)| *id != app_id && at.elapsed() < WINDOW_OPENING_TIMEOUT);
+        self.window_openings.push((app_id, workspace, Instant::now()));
+    }
+
+    /// The workspace a window with this app ID was expected on, if it was asked for in time and
+    /// is still there. The expectation is used up.
+    pub fn take_window_opening(&mut self, app_id: &str) -> Option<WorkspaceId> {
+        self.window_openings
+            .retain(|(_, _, at)| at.elapsed() < WINDOW_OPENING_TIMEOUT);
+        let at = self.window_openings.iter().position(|(id, _, _)| id == app_id)?;
+        let (_, workspace, _) = self.window_openings.remove(at);
+        self.layout.find_workspace_by_id(workspace).map(|_| workspace)
+    }
+
