+
+// Opens a window with an app ID and a title, and maps it.
+fn open_with_app_id(f: &mut Fixture, id: ClientId, app_id: &str, title: &str) {
+    let window = f.client(id).create_window();
+    let surface = window.surface.clone();
+    window.set_app_id(app_id);
+    window.set_title(title);
+    window.commit();
+    f.roundtrip(id);
+
+    let window = f.client(id).window(&surface);
+    window.attach_new_buffer();
+    window.ack_last_and_commit();
+    f.double_roundtrip(id);
+}
+
+// The workspace a window is on, by its title.
+fn workspace_of(f: &mut Fixture, title: &str) -> WorkspaceId {
+    f.niri()
+        .layout
+        .workspaces()
+        .find(|(_, _, ws)| {
+            ws.windows().any(|w| {
+                with_toplevel_role(w.toplevel(), |role| role.title.as_deref() == Some(title))
+            })
+        })
+        .map(|(_, _, ws)| ws.id())
+        .expect("the window is on no workspace")
+}
+
+#[test]
+fn opens_on_the_workspace_asked_for_its_app_id() {
+    let mut f = Fixture::new();
+    f.add_output(1, (1920, 1080));
+    let id = f.add_client();
+
+    // A window on the first workspace, then the one below it focused.
+    open_with_app_id(&mut f, id, "first", "first");
+    let asked = workspace_of(&mut f, "first");
+    f.niri_state().do_action(Action::FocusWorkspaceDown, false);
+    let focused = f.niri().layout.active_workspace().unwrap().id();
+    assert_ne!(asked, focused);
+
+    // Asked for its app ID, it opens on the first, from its first configure, and the focused
+    // workspace stays focused.
+    f.niri_state().do_action(
+        Action::OpenNextWindowOn {
+            app_id: String::from("spawned.1"),
+            reference: WorkspaceReference::Id(asked.get()),
+        },
+        false,
+    );
+    open_with_app_id(&mut f, id, "spawned.1", "spawned");
+    assert_eq!(workspace_of(&mut f, "spawned"), asked);
+    assert_eq!(f.niri().layout.active_workspace().unwrap().id(), focused);
+
+    // It's used once: the next with that app ID opens where any would.
+    open_with_app_id(&mut f, id, "spawned.1", "again");
+    assert_eq!(workspace_of(&mut f, "again"), focused);
+
+    // And one asked for another app ID doesn't take a window it doesn't name.
+    f.niri_state().do_action(
+        Action::OpenNextWindowOn {
+            app_id: String::from("spawned.2"),
+            reference: WorkspaceReference::Id(asked.get()),
+        },
+        false,
+    );
+    open_with_app_id(&mut f, id, "spawned.3", "other");
+    assert_eq!(workspace_of(&mut f, "other"), focused);
+}
