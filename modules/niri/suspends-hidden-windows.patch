@@ -0,0 +1,117 @@
+//! A window no output drew is told it's suspended, and told again it isn't once one draws it,
+//! so a client that heeds the state stops drawing frames nobody sees. The headless backend
+//! draws nothing, so these cases say what each output drew, as a render would.
+
+use std::collections::HashMap;
+
+use client::ClientId;
+use smithay::backend::renderer::element::{
+    Id, RenderElementPresentationState, RenderElementState, RenderElementStates,
+};
+use smithay::reexports::wayland_protocols::xdg::shell::client::xdg_toplevel;
+use wayland_client::protocol::wl_surface::WlSurface;
+
+use super::*;
+
+/// A fixture with one output and a 100×100 window on it, its first configures read.
+fn set_up() -> (Fixture, ClientId, WlSurface) {
+    let mut f = Fixture::new();
+    f.add_output(1, (1920, 1080));
+
+    let id = f.add_client();
+    let window = f.client(id).create_window();
+    let surface = window.surface.clone();
+    window.commit();
+    f.roundtrip(id);
+
+    let window = f.client(id).window(&surface);
+    window.attach_new_buffer();
+    window.set_size(100, 100);
+    window.ack_last_and_commit();
+    f.double_roundtrip(id);
+    let _ = f.client(id).window(&surface).recent_configures();
+
+    (f, id, surface)
+}
+
+/// The output's frame drawn, holding every window on it where `shown`, else none of them,
+/// followed by the frame callbacks a render sends.
+fn draw(f: &mut Fixture, shown: bool) {
+    let output = f.niri_output(1);
+    let niri = f.niri();
+    let mut states = RenderElementStates {
+        states: HashMap::new(),
+    };
+    if shown {
+        for mapped in niri.layout.windows_for_output(&output) {
+            states.states.insert(
+                Id::from_wayland_resource(mapped.toplevel().wl_surface()),
+                RenderElementState {
+                    visible_area: 100 * 100,
+                    presentation_state: RenderElementPresentationState::Rendering { reason: None },
+                    needs_capture: false,
+                },
+            );
+        }
+    }
+    niri.update_primary_scanout_output(&output, &states);
+    niri.send_frame_callbacks(&output);
+}
+
+/// Whether the window's newest configure since the last look says it's suspended, or `None`
+/// where none came.
+fn suspended(f: &mut Fixture, id: ClientId, surface: &WlSurface) -> Option<bool> {
+    f.double_roundtrip(id);
+    let window = f.client(id).window(surface);
+    let newest = window.recent_configures().last().cloned();
+    newest.map(|configure| configure.states.contains(&xdg_toplevel::State::Suspended))
+}
+
+#[test]
+fn a_window_no_output_drew_is_suspended_until_one_does() {
+    let (mut f, id, surface) = set_up();
+
+    draw(&mut f, false);
+    f.niri().suspend_hidden_windows();
+    assert_eq!(
+        suspended(&mut f, id, &surface),
+        Some(true),
+        "a window no frame held wasn't told it's suspended"
+    );
+
+    draw(&mut f, true);
+    assert_eq!(
+        suspended(&mut f, id, &surface),
+        Some(false),
+        "a suspended window drawn again wasn't told it's shown"
+    );
+}
+
+#[test]
+fn a_window_drawn_is_left_alone() {
+    let (mut f, id, surface) = set_up();
+
+    draw(&mut f, true);
+    f.niri().suspend_hidden_windows();
+    assert_eq!(
+        suspended(&mut f, id, &surface),
+        None,
+        "a window the output drew was sent a configure, so its state changed"
+    );
+}
+
+#[test]
+fn a_window_cast_is_never_suspended() {
+    let (mut f, id, surface) = set_up();
+
+    f.niri()
+        .layout
+        .with_windows_mut(|mapped, _| mapped.set_is_window_cast_target(true));
+    draw(&mut f, false);
+    f.niri().suspend_hidden_windows();
+    assert_ne!(
+        suspended(&mut f, id, &surface),
+        Some(true),
+        "a window someone casts was told it's suspended, so its cast would freeze"
+    );
+}
