+
+    /// Says whether any output showed the window when it last drew. One that none did, and
+    /// that no cast shows either, is told it's suspended, as xdg-shell lets a compositor say of
+    /// a window nobody can see, so a client such as kitty stops drawing it. The state goes out
+    /// with the window's next configure, which a layout refresh sends within a frame.
+    pub fn set_shown(&mut self, shown: bool) {
+        let suspended = !shown && !self.is_window_cast_target;
+        self.toplevel().with_pending_state(|state| {
+            if suspended {
+                state.states.set(xdg_toplevel::State::Suspended)
+            } else {
+                state.states.unset(xdg_toplevel::State::Suspended)
+            }
+        });
     }
 
     /// Renders a snapshot of the window without popups.
