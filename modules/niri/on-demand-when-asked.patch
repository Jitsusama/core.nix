+#[test]
+fn a_click_elsewhere_forgets_which_layer_surfaces_asked() {
+    let mut f = Fixture::new();
+    f.add_output(1, (1920, 1080));
+    let id = f.add_client();
+
+    let launcher = map_on_overlay(&mut f, id, "launcher");
+    let notices = map_on_overlay(&mut f, id, "notices");
+    set_keys(&mut f, id, &launcher, KeyboardInteractivity::OnDemand);
+    assert_eq!(focused(&mut f), "launcher");
+
+    // A click on anything but an on-demand layer surface, as on a window.
+    f.niri().focus_layer_surface_if_on_demand(None);
+    assert_eq!(focused(&mut f), "layout");
+
+    // Another asking then letting go leaves focus with the layout, not the launcher, which
+    // still asks but lost focus to the click.
+    set_keys(&mut f, id, &notices, KeyboardInteractivity::OnDemand);
+    assert_eq!(focused(&mut f), "notices");
+    set_keys(&mut f, id, &notices, KeyboardInteractivity::None);
+    assert_eq!(focused(&mut f), "layout");
+}
