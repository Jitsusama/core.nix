+#[test]
+fn an_action_leaves_focus_with_the_layer_surface_that_asked() {
+    let mut f = Fixture::new();
+    f.add_output(1, (1920, 1080));
+    let id = f.add_client();
+
+    let launcher = map_on_overlay(&mut f, id, "launcher");
+    set_keys(&mut f, id, &launcher, KeyboardInteractivity::OnDemand);
+    assert_eq!(focused(&mut f), "launcher");
+
+    // A shell moves windows from its open launcher with actions, which clear on-demand focus;
+    // the launcher still asks, so it keeps focus.
+    f.niri_state().do_action(Action::FocusWorkspaceDown, false);
