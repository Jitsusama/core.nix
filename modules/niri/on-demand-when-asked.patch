+/// Maps a layer surface on the overlay layer, asking for no keyboard focus, as a shell keeps a
+/// launcher mapped while it's closed.
+fn map_on_overlay(f: &mut Fixture, id: ClientId, namespace: &str) -> WlSurface {
+    let layer = f.client(id).create_layer(None, Layer::Overlay, namespace);
+    let surface = layer.surface.clone();
+    layer.set_configure_props(LayerConfigureProps {
+        anchor: Some(Anchor::Left | Anchor::Top),
+        size: Some((100, 100)),
+        kb_interactivity: Some(KeyboardInteractivity::None),
+        ..Default::default()
+    });
+    layer.commit();
+    f.double_roundtrip(id);
+
+    let layer = f.client(id).layer(&surface);
+    layer.attach_new_buffer();
+    layer.set_size(100, 100);
+    layer.ack_last_and_commit();
+    f.double_roundtrip(id);
+    surface
+}
+
+/// Sets a mapped layer surface's keyboard interactivity, as a shell does opening and closing.
+fn set_keys(f: &mut Fixture, id: ClientId, surface: &WlSurface, keys: KeyboardInteractivity) {
+    let layer = f.client(id).layer(surface);
+    layer.set_configure_props(LayerConfigureProps {
+        kb_interactivity: Some(keys),
+        ..Default::default()
+    });
+    layer.commit();
+    f.double_roundtrip(id);
+}
+
+/// Names what has keyboard focus: a layer surface by its namespace, or the layout.
+fn focused(f: &mut Fixture) -> String {
+    f.niri_state().update_keyboard_focus();
+    let niri = f.niri();
+    match &niri.keyboard_focus {
+        KeyboardFocus::LayerShell { surface } => niri
+            .mapped_layer_surfaces
+            .keys()
+            .find(|layer| layer.wl_surface() == surface)
+            .map(|layer| layer.namespace().to_owned())
+            .unwrap_or_else(|| String::from("an unknown layer surface")),
+        KeyboardFocus::Layout { .. } => String::from("layout"),
+        other => format!("{other:?}"),
+    }
+}
