+
+// A sandbox is never told when the person goes idle or comes back: that would let a program in it
+// wait for nobody watching before it acts. smithay's idle notifier takes no client filter, so its
+// global is dispatched here, as delegate_idle_notify! would, with one that hides it.
+impl GlobalDispatch<ExtIdleNotifierV1, ()> for State {
+    fn bind(
+        state: &mut Self,
+        handle: &DisplayHandle,
+        client: &Client,
+        resource: New<ExtIdleNotifierV1>,
+        global_data: &(),
+        data_init: &mut DataInit<'_, Self>,
+    ) {
+        <IdleNotifierState<Self> as GlobalDispatch<ExtIdleNotifierV1, (), Self>>::bind(
+            state,
+            handle,
+            client,
+            resource,
+            global_data,
+            data_init,
+        );
+    }
+
+    fn can_view(client: Client, _global_data: &()) -> bool {
+        !client_is_restricted(&client)
+    }
+}
+delegate_dispatch!(State: [ExtIdleNotifierV1: ()] => IdleNotifierState<State>);
+delegate_dispatch!(
+    State: [ExtIdleNotificationV1: IdleNotificationUserData] => IdleNotifierState<State>
+);
 
