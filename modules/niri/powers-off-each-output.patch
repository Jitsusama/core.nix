+#[test]
+fn niri_msg_outputs_says_which_screen_is_off() {
+    let mut f = two_screens();
+    act(&mut f, Action::PowerOffMonitor(String::from("headless-1")));
+    redraw(&mut f);
+
+    let powered_off = |f: &mut Fixture, name: &str| {
+        let outputs = f.niri_state().backend.ipc_outputs();
+        let outputs = outputs.lock().unwrap();
+        outputs.values().find(|o| o.name == name).unwrap().powered_off
+    };
+    assert!(powered_off(&mut f, "headless-1"));
+    assert!(!powered_off(&mut f, "headless-2"));
+
+    act(&mut f, Action::PowerOnMonitor(String::from("headless-1")));
+    redraw(&mut f);
+    assert!(!powered_off(&mut f, "headless-1"));
+}
