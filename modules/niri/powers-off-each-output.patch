@@ -0,0 +1,242 @@
+use clap::Parser as _;
+use niri_config::{Action, Config};
+
+use super::*;
+use crate::cli::{Cli, Msg, Sub};
+
+/// A niri with two screens, each drawn once.
+fn two_screens() -> Fixture {
+    let mut f = Fixture::new();
+    f.add_output(1, (1920, 1080));
+    f.add_output(2, (1280, 720));
+    redraw(&mut f);
+    f
+}
+
+/// Draws every screen, as niri does after a turn of its loop with each queued.
+fn redraw(f: &mut Fixture) {
+    f.niri().queue_redraw_all();
+    f.niri_state().refresh_and_flush_clients();
+}
+
+/// How many frames the screen has had, as niri counts them for frame callbacks.
+fn frames(f: &mut Fixture, n: u8) -> u32 {
+    let output = f.niri_output(n);
+    f.niri().output_state[&output].frame_callback_sequence
+}
+
+fn off_by_name(f: &mut Fixture, n: u8) -> bool {
+    let output = f.niri_output(n);
+    f.niri().is_off_by_name(&output)
+}
+
+fn act(f: &mut Fixture, action: Action) {
+    f.niri_state().do_action(action, false);
+}
+
+#[test]
+fn binds_name_a_screen_to_power_off_and_on() {
+    let config = Config::parse_mem(
+        r#"
+        binds {
+            Mod+F1 { power-off-monitor "eDP-1"; }
+            Mod+F2 { power-on-monitor "Dell Inc. DELL U2723QE 1234"; }
+        }
+        "#,
+    )
+    .unwrap();
+
+    let actions: Vec<_> = config.binds.0.into_iter().map(|bind| bind.action).collect();
+    assert_eq!(
+        actions,
+        [
+            Action::PowerOffMonitor(String::from("eDP-1")),
+            Action::PowerOnMonitor(String::from("Dell Inc. DELL U2723QE 1234")),
+        ]
+    );
+}
+
+#[test]
+fn niri_msg_names_a_screen_to_power_off_and_on() {
+    for (verb, expected) in [
+        ("power-off-monitor", Action::PowerOffMonitor(String::from("eDP-1"))),
+        ("power-on-monitor", Action::PowerOnMonitor(String::from("eDP-1"))),
+    ] {
+        let cli = Cli::try_parse_from(["niri", "msg", "action", verb, "eDP-1"]).unwrap();
+        let Some(Sub::Msg {
+            msg: Msg::Action { action },
+            ..
+        }) = cli.subcommand
+        else {
+            panic!("niri msg action {verb} wasn't read as an action");
+        };
+        assert_eq!(Action::from(action), expected);
+    }
+}
+
+#[test]
+fn niri_msg_needs_the_screen_named() {
+    assert!(Cli::try_parse_from(["niri", "msg", "action", "power-off-monitor"]).is_err());
+}
+
+#[test]
+fn a_screen_off_by_name_isnt_drawn_while_the_other_is() {
+    let mut f = two_screens();
+    let (first, second) = (frames(&mut f, 1), frames(&mut f, 2));
+
+    act(&mut f, Action::PowerOffMonitor(String::from("headless-1")));
+    redraw(&mut f);
+
+    assert_eq!(frames(&mut f, 1), first);
+    assert!(frames(&mut f, 2) > second);
+    assert!(f.niri().monitors_active);
+    // It stays connected and in the layout.
+    let output = f.niri_output(1);
+    assert!(f.niri().layout.outputs().any(|o| *o == output));
+}
+
+#[test]
+fn a_screen_is_named_by_make_model_and_serial_too() {
+    let mut f = two_screens();
+
+    act(&mut f, Action::PowerOffMonitor(String::from("niri headless 2")));
+
+    assert!(!off_by_name(&mut f, 1));
+    assert!(off_by_name(&mut f, 2));
+}
+
+#[test]
+fn an_unknown_screen_powers_nothing_off() {
+    let mut f = two_screens();
+
+    act(&mut f, Action::PowerOffMonitor(String::from("DP-9")));
+
+    assert!(!off_by_name(&mut f, 1));
+    assert!(!off_by_name(&mut f, 2));
+}
