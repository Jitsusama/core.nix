diff --git a/src/utils/layer_wake.rs b/src/utils/layer_wake.rs
new file mode 100644
index 0000000..02b3ca4
--- /dev/null
+++ b/src/utils/layer_wake.rs
@@ -0,0 +1,243 @@
+//! What a layer surface's first new buffer after a quiet spell spent between the client's commit
+//! and the screen.
+//!
+//! A shell's launcher opening after a quiet moment reached the screen four to seven refreshes
+//! after its swap, yet niri's own frames after an idle spell reach it within two (frame_steps.rs),
+//! and none of those openings was among the frames that says. So the time goes before niri's
+//! redraw is asked: on the buffer's fence, which the client's own GPU work signals, or on a frame
+//! already in flight. This says each step by the monotonic clock clients' presentation times use,
+//! from niri reading the client's commit through niri taking the buffer and rendering and
+//! queueing the frame that carries it to the screen. It also says how fast the screen's vblanks
+//! came over the spell before, which would show a panel dropping its refresh rate while idle if
+//! the driver's vblank count follows the panel.
+
+use std::time::Duration;
+
+use super::frame_steps::refreshes;
+
+/// How long a surface must have committed no new buffer for its next to be said.
+///
+/// It's well past any frame, so an animation says nothing, and short enough that a launcher
+/// opening after a moment's pause is said.
+pub const QUIET: Duration = Duration::from_millis(100);
+
+/// How long a taken buffer may wait for a frame to carry it before it's dropped unsaid.
+///
+/// The slowest opening seen took seven refreshes, under 60 ms, so a wait this long means the
+/// output wasn't rendering, and the frame that finally comes would be blamed for it.
+pub const STALE: Duration = Duration::from_secs(1);
+
+/// The vblanks an output counted between its last two frames reaching the screen, and the time
+/// between them.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Spell {
+    pub vblanks: u32,
+    pub over: Duration,
+}
+
+/// When each step of a layer surface's first new buffer after a quiet spell happened.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct LayerWake {
+    /// The surface's namespace, as its client named it.
+    pub namespace: String,
+    /// How long since the surface's previous new buffer, or since it was mapped.
+    pub quiet: Duration,
+    /// Whether the buffer is a dmabuf, which niri takes only once its fence signals.
+    pub fenced: bool,
+    /// When niri read the client's commit, as it arrived and before waiting on its fence.
+    pub committed: Duration,
+    /// When niri took it, and what the output's redraw was doing then.
+    pub taken: Option<(Duration, &'static str)>,
+    /// When rendering the frame carrying it began, and when that frame was queued.
+    pub drawn: Option<(Duration, Duration)>,
+}
+
+impl LayerWake {
+    /// The wake of a buffer committed at `committed`, when the surface's last was at `last`:
+    /// none when that was too recent for this to be the first after a quiet spell.
+    pub fn after_quiet(
+        namespace: &str,
+        last: Duration,
+        committed: Duration,
+        fenced: bool,
+    ) -> Option<Self> {
+        let quiet = committed.saturating_sub(last);
+        if quiet < QUIET {
+            return None;
+        }
+        Some(Self {
+            namespace: namespace.to_owned(),
+            quiet,
+            fenced,
+            committed,
+            taken: None,
+            drawn: None,
+        })
+    }
+
+    /// Whether it has waited too long by `now` to be said against the frame that carries it.
+    pub fn stale(&self, now: Duration) -> bool {
+        now.saturating_sub(self.committed) > STALE
+    }
+
+    /// What it was, for a frame that reached the screen at a time the driver didn't give.
+    pub fn unseen(&self) -> String {
+        format!(
+            "{:?}'s first buffer after {:.0} ms quiet reached the screen at a time the driver \
+             didn't give",
+            self.namespace,
+            self.quiet.as_secs_f64() * 1000.
+        )
+    }
+
+    /// What it spent, once the frame carrying it reached the screen at `presented`, in
+    /// milliseconds, with the refreshes from the commit when the output's refresh is known.
+    pub fn said(
+        &self,
+        presented: Duration,
+        refresh: Option<Duration>,
+        spell: Option<Spell>,
+    ) -> String {
+        let ms = |duration: Duration| duration.as_secs_f64() * 1000.;
+        let kind = if self.fenced { "a dmabuf" } else { "unfenced" };
+        // The namespace is the client's, so it's quoted and escaped rather than trusted.
+        let mut said = format!(
+            "{:?}'s first buffer after {:.0} ms quiet, {kind}, committed at {:.1} ms:",
+            self.namespace,
+            ms(self.quiet),
+            ms(self.committed)
+        );
+        let mut last = self.committed;
+        if let Some((taken, redraw)) = self.taken {
+            said += &format!(
+                " niri took it {:.1} ms later, with {redraw};",
+                ms(taken.saturating_sub(last))
+            );
+            last = taken;
+        }
+        if let Some((rendering, queued)) = self.drawn {
+            said += &format!(
+                " its frame's render began {:.1} ms later and took {:.1},",
+                ms(rendering.saturating_sub(last)),
+                ms(queued.saturating_sub(rendering))
+            );
+            last = queued;
+        }
+        said += &format!(
+            " then it reached the screen {:.1} ms on",
+            ms(presented.saturating_sub(last))
+        );
+        if let Some(frames) = refreshes(presented.saturating_sub(self.committed), refresh) {
+            let plural = if frames == 1 { "" } else { "es" };
+            said += &format!("; {frames} refresh{plural} from the commit");
+        }
+        if let Some(spell) = spell.filter(|spell| spell.vblanks > 0) {
+            let each = ms(spell.over) / f64::from(spell.vblanks);
+            let plural = if spell.vblanks == 1 { "" } else { "s" };
+            said += &format!(
+                "; the screen's {} vblank{plural} since its last frame came every {each:.2} ms",
+                spell.vblanks
+            );
+        }
+        said
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn ms(value: f64) -> Duration {
+        Duration::from_secs_f64(value / 1000.)
+    }
+
+    /// A buffer committed 2 s after the last, taken 30 ms later, drawn 1 ms after that in 2 ms.
+    fn wake() -> LayerWake {
+        let mut wake = LayerWake::after_quiet("launcher", ms(1000.), ms(3000.), true).unwrap();
+        wake.taken = Some((ms(3030.), "the output idle"));
+        wake.drawn = Some((ms(3031.), ms(3033.)));
+        wake
+    }
+
+    #[test]
+    fn a_buffer_soon_after_the_last_says_nothing() {
+        assert_eq!(
+            LayerWake::after_quiet("launcher", ms(1000.), ms(1050.), true),
+            None
+        );
+    }
+
+    #[test]
+    fn a_buffer_after_a_quiet_spell_says_each_step() {
+        assert_eq!(
+            wake().said(
+                ms(3041.6),
+                Some(ms(8.333)),
+                Some(Spell {
+                    vblanks: 240,
+                    over: ms(2000.),
+                })
+            ),
+            "\"launcher\"'s first buffer after 2000 ms quiet, a dmabuf, committed at 3000.0 ms: \
+             niri took it 30.0 ms later, with the output idle; its frame's render began 1.0 ms \
+             later and took 2.0, then it reached the screen 8.6 ms on; 5 refreshes from the \
+             commit; the screen's 240 vblanks since its last frame came every 8.33 ms"
+        );
+    }
+
+    #[test]
+    fn a_buffer_not_yet_taken_says_only_the_screen() {
+        let wake = LayerWake::after_quiet("launcher", ms(0.), ms(500.), false).unwrap();
+        assert_eq!(
+            wake.said(ms(508.3), None, None),
+            "\"launcher\"'s first buffer after 500 ms quiet, unfenced, committed at 500.0 ms: \
+             then it reached the screen 8.3 ms on"
+        );
+    }
+
+    #[test]
+    fn a_panel_at_half_its_rate_shows_in_the_spell() {
+        let said = wake().said(
+            ms(3050.),
+            Some(ms(8.333)),
+            Some(Spell {
+                vblanks: 120,
+                over: ms(2000.),
+            }),
+        );
+        assert!(
+            said.ends_with("120 vblanks since its last frame came every 16.67 ms"),
+            "{said}"
+        );
+    }
+
+    #[test]
+    fn an_unknown_or_zero_refresh_and_an_empty_spell_count_none() {
+        let empty = Some(Spell {
+            vblanks: 0,
+            over: ms(5.),
+        });
+        for (refresh, spell) in [(None, empty), (Some(Duration::ZERO), None), (None, None)] {
+            let said = wake().said(ms(3040.), refresh, spell);
+            assert!(said.ends_with("reached the screen 7.0 ms on"), "{said}");
+        }
+    }
+
+    #[test]
+    fn a_namespace_cannot_write_a_line_of_its_own() {
+        let wake = LayerWake::after_quiet("a\nniri: forged", ms(0.), ms(500.), false).unwrap();
+        let said = wake.said(ms(508.), None, None);
+        assert!(!said.contains('\n'), "{said}");
+        assert!(
+            wake.unseen().starts_with("\"a\\nniri: forged\"'s"),
+            "{}",
+            wake.unseen()
+        );
+    }
+
+    #[test]
+    fn a_buffer_waiting_past_a_second_is_stale() {
+        assert!(!wake().stale(ms(3999.)), "a wait under a second is said");
+        assert!(wake().stale(ms(4001.)), "a wait past a second is dropped");
+    }
+}
