diff --git a/src/tests/refresh_pacing.rs b/src/tests/refresh_pacing.rs
new file mode 100644
index 0000000..e408106
--- /dev/null
+++ b/src/tests/refresh_pacing.rs
@@ -0,0 +1,154 @@
+//! niri's refresh, paced to once a frame: what a client's commits change waits for the next
+//! frame's refresh, and what input, an action, a focus change, a window coming or a commit
+//! resizing one needs is sent at once.
+
+use std::time::Duration;
+
+use client::ClientId;
+use niri_config::Action;
+use wayland_client::protocol::wl_surface::WlSurface;
+
+use super::*;
+use crate::utils::refresh_pacer::RefreshPacer;
+
+/// A frame no test outlasts, so nothing it does is refreshed for time alone.
+const FOREVER: Duration = Duration::from_secs(3600);
+
+/// A fixture with two outputs and a 100×100 window on the first, its refresh paced to once
+/// every `frame`, with the first refresh spent, so the next one waits for the frame or a hurry.
+fn set_up(frame: Duration) -> (Fixture, ClientId, WlSurface) {
+    let mut f = Fixture::new();
+    f.add_output(1, (1920, 1080));
+    f.add_output(2, (1280, 720));
+
+    let id = f.add_client();
+    let window = f.client(id).create_window();
+    let surface = window.surface.clone();
+    window.commit();
+    f.roundtrip(id);
+
+    let window = f.client(id).window(&surface);
+    window.attach_new_buffer();
+    window.set_size(100, 100);
+    window.ack_last_and_commit();
+    f.double_roundtrip(id);
+
+    f.niri().refresh_pacer = RefreshPacer::paced_every(frame);
+    f.double_roundtrip(id);
+    let _ = f.client(id).window(&surface).recent_configures();
+
+    (f, id, surface)
+}
+
+fn refreshes(f: &mut Fixture) -> u64 {
+    f.niri().refresh_pacer.refreshes()
+}
+
+fn configures(f: &mut Fixture, id: ClientId, surface: &WlSurface) -> String {
+    f.client(id).window(surface).format_recent_configures()
+}
+
+#[test]
+fn commits_within_a_frame_put_the_refresh_off() {
+    let (mut f, id, surface) = set_up(FOREVER);
+    let before = refreshes(&mut f);
+
+    // A fullscreen request's configure goes out in the refresh.
+    f.client(id).window(&surface).set_fullscreen(None);
+    for _ in 0..5 {
+        f.client(id).window(&surface).commit();
+        f.double_roundtrip(id);
+    }
+
+    assert_eq!(refreshes(&mut f), before);
+    assert!(f.niri().refresh_deferred.is_some());
+    assert_eq!(configures(&mut f, id, &surface), "");
+}
+
+#[test]
+fn the_refresh_put_off_runs_within_a_frame() {
+    let (mut f, id, surface) = set_up(Duration::from_millis(20));
+    let before = refreshes(&mut f);
+
+    f.client(id).window(&surface).set_fullscreen(None);
+    f.client(id).window(&surface).commit();
+
+    // Wait on the server's own loop, where its timer runs, until the configure arrives.
+    let mut sent = String::new();
+    for _ in 0..100 {
+        f.double_roundtrip(id);
+        sent = configures(&mut f, id, &surface);
+        if !sent.is_empty() {
+            break;
+        }
+        let server = &mut f.state.server;
+        server
+            .event_loop
+            .dispatch(Some(Duration::from_millis(20)), &mut server.state)
+            .unwrap();
+        server.state.refresh_and_flush_clients();
+    }
+
+    assert!(sent.contains("Fullscreen"), "{sent:?}");
+    assert!(refreshes(&mut f) > before);
+}
+
+#[test]
+fn a_focus_change_refreshes_at_once() {
+    let (mut f, id, surface) = set_up(FOREVER);
+
+    // Focusing the empty output takes the keyboard from the window, which loses Activated. The
+    // layout sends that a refresh after it makes it, so it takes both roundtrips' refreshes.
+    f.niri_focus_output(2);
+    f.double_roundtrip(id);
+
+    let sent = configures(&mut f, id, &surface);
+    assert!(sent.ends_with("states: []"), "{sent:?}");
+}
+
+#[test]
+fn an_action_refreshes_at_once() {
+    let (mut f, id, surface) = set_up(FOREVER);
+
+    f.niri_state().do_action(Action::FullscreenWindow, false);
+    f.double_roundtrip(id);
+
+    let sent = configures(&mut f, id, &surface);
+    assert!(sent.contains("Fullscreen"), "{sent:?}");
+}
+
+#[test]
+fn a_resize_commit_refreshes_at_once() {
+    let (mut f, id, surface) = set_up(FOREVER);
+    let before = refreshes(&mut f);
+
+    // A terminal acking a resize commits at its new size; the layout it moves goes out at once.
+    let window = f.client(id).window(&surface);
+    window.attach_new_buffer();
+    window.set_size(200, 100);
+    window.commit();
+    f.double_roundtrip(id);
+
+    assert!(refreshes(&mut f) > before);
+}
+
+#[test]
+fn a_window_coming_refreshes_at_once() {
+    let (mut f, id, first) = set_up(FOREVER);
+
+    let window = f.client(id).create_window();
+    let second = window.surface.clone();
+    window.commit();
+    f.roundtrip(id);
+    let _ = f.client(id).window(&second).recent_configures();
+
+    let window = f.client(id).window(&second);
+    window.attach_new_buffer();
+    window.set_size(100, 100);
+    window.ack_last_and_commit();
+    f.double_roundtrip(id);
+
+    // The new window takes the focus, so the first loses Activated.
+    let sent = configures(&mut f, id, &first);
+    assert!(sent.contains("states: []"), "{sent:?}");
+}
