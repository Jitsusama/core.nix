diff --git a/src/utils/refresh_pacer.rs b/src/utils/refresh_pacer.rs
new file mode 100644
index 0000000..072e524
--- /dev/null
+++ b/src/utils/refresh_pacer.rs
@@ -0,0 +1,230 @@
+//! Pacing of niri's refresh.
+//!
+//! After every wakeup of the event loop niri refreshes: it walks every window to update its
+//! states, the layout, the outputs each surface is on, foreign toplevels, window rules and what
+//! IPC reports. A busy client wakes niri on every commit, so with many windows open that walk
+//! ran hundreds of times a second for changes nobody could see sooner than the next frame. The
+//! pacer lets a refresh happen at once when the last one was at least a frame ago, or when
+//! something needs it at once (input, an action, a focus change, a window coming or going), and
+//! otherwise says how long to wait, so that every wakeup is followed by a refresh within one
+//! frame, and a burst of them by one refresh.
+
+use std::time::Duration;
+
+/// How long the tally counts before it reports.
+const TALLY_PERIOD: Duration = Duration::from_secs(1);
+
+#[derive(Debug)]
+pub struct RefreshPacer {
+    /// Whether refreshes are paced at all, rather than run after every wakeup.
+    paced: bool,
+    /// The frame interval, when fixed rather than the outputs', as niri's tests fix it.
+    frame: Option<Duration>,
+    /// Whether something needs the next refresh at once.
+    hurried: bool,
+    /// When the last refresh ran.
+    last: Option<Duration>,
+    /// Wakeups and refreshes since the tally began.
+    tally: Tally,
+    /// Refreshes since the pacer began.
+    refreshes: u64,
+}
+
+/// Wakeups and the refreshes they led to, counted for niri's trace log.
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub struct Tally {
+    pub since: Option<Duration>,
+    pub wakeups: u64,
+    pub refreshes: u64,
+}
+
+impl RefreshPacer {
+    /// A pacer that runs a refresh at most once a frame unless hurried.
+    pub fn paced() -> Self {
+        Self {
+            paced: true,
+            frame: None,
+            hurried: false,
+            last: None,
+            tally: Tally::default(),
+            refreshes: 0,
+        }
+    }
+
+    /// A pacer that runs a refresh after every wakeup, as niri did before pacing, which niri's
+    /// tests are written against.
+    pub fn unpaced() -> Self {
+        Self {
+            paced: false,
+            ..Self::paced()
+        }
+    }
+
+    /// A pacer that runs a refresh at most once every `frame`, whatever the outputs' frame
+    /// interval, so niri's tests can tell a refresh put off from one run at once.
+    pub fn paced_every(frame: Duration) -> Self {
+        Self {
+            frame: Some(frame),
+            ..Self::paced()
+        }
+    }
+
+    /// Something needs the next refresh at once: input, an action, a focus change, a window
+    /// mapping or going, or the deferred refresh's timer.
+    pub fn hurry(&mut self) {
+        self.hurried = true;
+    }
+
+    /// Whether a wakeup at `now` refreshes at once, as `None`, or waits for how long, given the
+    /// shortest frame interval of the outputs.
+    pub fn pace(&mut self, now: Duration, interval: Duration) -> Option<Duration> {
+        self.tally.wakeups += 1;
+        let interval = self.frame.unwrap_or(interval);
+
+        let wait = match self.last {
+            Some(last) if self.paced && !self.hurried => {
+                (last + interval).checked_sub(now).filter(|wait| !wait.is_zero())
+            }
+            _ => None,
+        };
+
+        if wait.is_none() {
+            self.hurried = false;
+            self.last = Some(now);
+            self.tally.refreshes += 1;
+            self.refreshes += 1;
+        }
+        wait
+    }
+
+    /// The tally of the last second, once a second has passed since it began, starting the next.
+    pub fn take_tally(&mut self, now: Duration) -> Option<Tally> {
+        let since = *self.tally.since.get_or_insert(now);
+        if now.saturating_sub(since) < TALLY_PERIOD {
+            return None;
+        }
+
+        let tally = self.tally;
+        self.tally = Tally {
+            since: Some(now),
+            ..Tally::default()
+        };
+        Some(tally)
+    }
+
+    /// Refreshes since the pacer began.
+    pub fn refreshes(&self) -> u64 {
+        self.refreshes
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const FRAME: Duration = Duration::from_millis(8);
+
+    fn ms(ms: u64) -> Duration {
+        Duration::from_millis(ms)
+    }
+
+    #[test]
+    fn the_first_wakeup_refreshes_at_once() {
+        let mut pacer = RefreshPacer::paced();
+        assert_eq!(pacer.pace(ms(100), FRAME), None);
+    }
+
+    #[test]
+    fn a_wakeup_within_a_frame_of_a_refresh_waits_for_the_rest_of_it() {
+        let mut pacer = RefreshPacer::paced();
+        pacer.pace(ms(100), FRAME);
+
+        assert_eq!(pacer.pace(ms(103), FRAME), Some(ms(5)));
+        assert_eq!(pacer.pace(ms(107), FRAME), Some(ms(1)));
+        assert_eq!(pacer.refreshes(), 1);
+    }
+
+    #[test]
+    fn a_wakeup_a_frame_after_a_refresh_refreshes_at_once() {
+        let mut pacer = RefreshPacer::paced();
+        pacer.pace(ms(100), FRAME);
+
+        assert_eq!(pacer.pace(ms(108), FRAME), None);
+        assert_eq!(pacer.pace(ms(150), FRAME), None);
+        assert_eq!(pacer.refreshes(), 3);
+    }
+
+    #[test]
+    fn a_frame_counts_from_the_last_refresh_not_the_last_wakeup() {
+        let mut pacer = RefreshPacer::paced();
+        pacer.pace(ms(100), FRAME);
+        pacer.pace(ms(104), FRAME);
+
+        assert_eq!(pacer.pace(ms(109), FRAME), None);
+    }
+
+    #[test]
+    fn a_hurried_wakeup_refreshes_at_once_and_only_the_once() {
+        let mut pacer = RefreshPacer::paced();
+        pacer.pace(ms(100), FRAME);
+
+        pacer.hurry();
+        assert_eq!(pacer.pace(ms(101), FRAME), None);
+        assert_eq!(pacer.pace(ms(102), FRAME), Some(ms(7)));
+    }
+
+    #[test]
+    fn a_hurry_before_any_refresh_is_spent_on_the_first() {
+        let mut pacer = RefreshPacer::paced();
+        pacer.hurry();
+        pacer.pace(ms(100), FRAME);
+
+        assert_eq!(pacer.pace(ms(101), FRAME), Some(ms(7)));
+    }
+
+    #[test]
+    fn the_frame_follows_the_fastest_output() {
+        let mut pacer = RefreshPacer::paced();
+        pacer.pace(ms(100), ms(16));
+
+        assert_eq!(pacer.pace(ms(104), ms(4)), None);
+    }
+
+    #[test]
+    fn a_fixed_frame_overrides_the_outputs() {
+        let mut pacer = RefreshPacer::paced_every(ms(50));
+        pacer.pace(ms(100), FRAME);
+
+        assert_eq!(pacer.pace(ms(120), FRAME), Some(ms(30)));
+    }
+
+    #[test]
+    fn unpaced_every_wakeup_refreshes() {
+        let mut pacer = RefreshPacer::unpaced();
+        for now in 100..110 {
+            assert_eq!(pacer.pace(ms(now), FRAME), None);
+        }
+        assert_eq!(pacer.refreshes(), 10);
+    }
+
+    #[test]
+    fn the_tally_reports_once_a_second_and_starts_again() {
+        let mut pacer = RefreshPacer::paced();
+        assert_eq!(pacer.take_tally(ms(0)), None);
+        for now in 0..100 {
