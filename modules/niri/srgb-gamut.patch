+        .ok()
+        .and_then(|edid| gamut::Primaries::from_edid(&edid))
+        .and_then(|primaries| primaries.srgb_to_screen());
+    match matrix {
+        Some(matrix) if gamut::changes_nothing(&matrix) => {
+            debug!("output {connector_name:?}: its primaries are sRGB's already");
