+fn create_blob<T: bytemuck::Pod>(
+    device: &DrmDevice,
+    data: &[T],
+) -> anyhow::Result<Option<NonZeroU64>> {
+    let mut data = data.to_vec();
+    let blob = drm_ffi::mode::create_property_blob(device.as_fd(), cast_slice_mut(&mut data))
+        .context("error creating property blob")?;
+    Ok(NonZeroU64::new(u64::from(blob.blob_id)))
+}
+
+/// Sets a CRTC's blob properties together, in one atomic commit where the
+/// device takes them, so no frame shows the screen with one curve and not
+/// the other.
+fn set_blobs(
+    device: &DrmDevice,
+    crtc: crtc::Handle,
+    sets: &[(property::Handle, Option<NonZeroU64>, &str)],
+) -> anyhow::Result<()> {
+    let _span = tracy_client::span!("set_property");
+
+    let value =
+        |blob: Option<NonZeroU64>| property::Value::Blob(blob.map(NonZeroU64::get).unwrap_or(0));
+
+    if device.is_atomic() && sets.len() > 1 {
+        let mut req = AtomicModeReq::new();
+        for &(property, blob, _) in sets {
+            req.add_property(crtc, property, value(blob));
+        }
+        match device.atomic_commit(AtomicCommitFlags::ALLOW_MODESET, req) {
+            Ok(()) => return Ok(()),
+            Err(err) => debug!("error setting colour properties at once, so one by one: {err:?}"),
+        }
+    }
+
+    for &(property, blob, name) in sets {
+        device
+            .set_property(crtc, property, value(blob).into())
+            .with_context(|| format!("error setting {name}"))?;
+    }
+    Ok(())
+}
+
+/// Keeps the blob now set, destroying the one it replaces.
+fn replace_blob(device: &DrmDevice, kept: &mut Option<NonZeroU64>, blob: Option<NonZeroU64>) {
+    if let Some(previous) = mem::replace(kept, blob) {
+        if let Err(err) = device.destroy_property_blob(previous.get()) {
+            warn!("error destroying previous property blob: {err:?}");
+        }
+    }
+}
