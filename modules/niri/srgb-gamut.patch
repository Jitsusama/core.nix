@@ -0,0 +1,440 @@
+//! Showing sRGB on a wide-gamut screen as sRGB.
+//!
+//! niri draws in sRGB and sends it to the screen as it is, so a panel whose
+//! primaries reach past sRGB's stretches every colour out to its own, and
+//! shows them oversaturated. The display engine can undo that at no cost to
+//! the GPU: its degamma curve takes the sRGB values back to light, its colour
+//! matrix (CTM) moves that light from sRGB's primaries to the panel's, and
+//! its gamma curve encodes it again. The matrix comes from the primaries the
+//! screen's EDID declares, and both sides keep the screen's own white, so
+//! white and every grey come out as they went in.
+
+/// A screen's primaries and white point, as CIE 1931 xy chromaticities.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Primaries {
+    pub red: (f64, f64),
+    pub green: (f64, f64),
+    pub blue: (f64, f64),
+    pub white: (f64, f64),
+}
+
+/// sRGB's primaries (IEC 61966-2-1), white given by the screen.
+const SRGB_RED: (f64, f64) = (0.640, 0.330);
+const SRGB_GREEN: (f64, f64) = (0.300, 0.600);
+const SRGB_BLUE: (f64, f64) = (0.150, 0.060);
+
+pub type Matrix = [[f64; 3]; 3];
+
+impl Primaries {
+    /// The primaries and white an EDID's base block declares in its colour
+    /// characteristics (bytes 25 to 34, ten bits each).
+    pub fn from_edid(edid: &[u8]) -> Option<Self> {
+        let bytes = edid.get(25..35)?;
+        let low = |byte: u8, shift: u8| u16::from((byte >> shift) & 0b11);
+        let value = |high: u8, low: u16| f64::from((u16::from(high) << 2) | low) / 1024.;
+
+        let primaries = Self {
+            red: (
+                value(bytes[2], low(bytes[0], 6)),
+                value(bytes[3], low(bytes[0], 4)),
+            ),
+            green: (
+                value(bytes[4], low(bytes[0], 2)),
+                value(bytes[5], low(bytes[0], 0)),
+            ),
+            blue: (
+                value(bytes[6], low(bytes[1], 6)),
+                value(bytes[7], low(bytes[1], 4)),
+            ),
+            white: (
+                value(bytes[8], low(bytes[1], 2)),
+                value(bytes[9], low(bytes[1], 0)),
+            ),
+        };
+
+        // A screen that leaves them out writes zeroes, and a y of zero has no
+        // colour to stand for.
+        let points = [
+            primaries.red,
+            primaries.green,
+            primaries.blue,
+            primaries.white,
+        ];
+        points
+            .iter()
+            .all(|&(x, y)| x > 0. && y > 0. && x + y < 1.)
+            .then_some(primaries)
+    }
+
+    /// The matrix from these primaries' linear RGB to CIE XYZ, scaled so
+    /// that full RGB is the white point at a luminance of one.
+    fn xyz(self) -> Option<Matrix> {
+        let xyz = |(x, y): (f64, f64)| [x / y, 1., (1. - x - y) / y];
+        let [r, g, b] = [xyz(self.red), xyz(self.green), xyz(self.blue)];
+        let columns = [[r[0], g[0], b[0]], [r[1], g[1], b[1]], [r[2], g[2], b[2]]];
+        let white = xyz(self.white);
+        let scale = multiply_vector(&invert(&columns)?, white);
+        Some(std::array::from_fn(|row| {
+            std::array::from_fn(|column| columns[row][column] * scale[column])
+        }))
+    }
+
+    /// The matrix taking sRGB's linear light to this screen's, both at this
+    /// screen's white, or nothing when its primaries can't stand for a
+    /// screen: a matrix with no inverse, or one that would send a colour
+    /// more than twice past full, which no real screen's primaries ask.
+    pub fn srgb_to_screen(self) -> Option<Matrix> {
+        let srgb = Self {
+            red: SRGB_RED,
+            green: SRGB_GREEN,
+            blue: SRGB_BLUE,
+            white: self.white,
+        };
+        let matrix = multiply(&invert(&self.xyz()?)?, &srgb.xyz()?);
+        matrix
+            .iter()
+            .flatten()
+            .all(|value| value.abs() <= 2.)
+            .then_some(matrix)
+    }
+}
+
+/// Whether the degamma curve and colour matrix need setting to hold a screen
+/// to `wanted`, given what they were last set for: none until they're first
+/// set. A gamma control client's every step changes the gamma curve alone, so
+/// it sets that alone, rather than the screen's whole colour pipeline again.
+pub fn colour_changes(set_for: Option<Option<Matrix>>, wanted: Option<Matrix>) -> bool {
+    set_for != Some(wanted)
+}
+
+/// Whether a matrix from sRGB is near enough the identity that it would
+/// change nothing anybody could see, as for a screen that is sRGB already.
+pub fn changes_nothing(matrix: &Matrix) -> bool {
+    matrix.iter().enumerate().all(|(row, values)| {
+        values.iter().enumerate().all(|(column, &value)| {
+            let identity = if row == column { 1. } else { 0. };
+            (value - identity).abs() < 0.01
+        })
+    })
+}
+
+fn multiply(a: &Matrix, b: &Matrix) -> Matrix {
+    std::array::from_fn(|row| {
+        std::array::from_fn(|column| (0..3).map(|k| a[row][k] * b[k][column]).sum())
+    })
+}
+
+fn multiply_vector(a: &Matrix, v: [f64; 3]) -> [f64; 3] {
+    std::array::from_fn(|row| (0..3).map(|k| a[row][k] * v[k]).sum())
+}
+
+fn invert(m: &Matrix) -> Option<Matrix> {
+    let cofactor = |row: usize, column: usize| {
+        let (r1, r2) = ((row + 1) % 3, (row + 2) % 3);
+        let (c1, c2) = ((column + 1) % 3, (column + 2) % 3);
+        m[r1][c1] * m[r2][c2] - m[r1][c2] * m[r2][c1]
+    };
+    let determinant: f64 = (0..3)
+        .map(|column| m[0][column] * cofactor(0, column))
+        .sum();
+    if determinant.abs() < 1e-12 {
+        return None;
+    }
+    Some(std::array::from_fn(|row| {
+        std::array::from_fn(|column| cofactor(column, row) / determinant)
+    }))
+}
+
+/// The matrix as the kernel's `drm_color_ctm` holds it: row by row, each in
+/// S31.32 sign-magnitude.
+pub fn ctm(matrix: &Matrix) -> [u64; 9] {
+    std::array::from_fn(|i| {
+        let value = matrix[i / 3][i % 3];
+        // A matrix from primaries stays well inside 2^31 either way.
+        #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss)]
+        let magnitude = (value.abs() * f64::from(1u32 << 31) * 2.).round() as u64;
+        if value < 0. {
+            magnitude | (1 << 63)
+        } else {
+            magnitude
+        }
+    })
+}
+
+/// sRGB's curve from an encoded value to light.
+fn decode(value: f64) -> f64 {
+    if value <= 0.04045 {
+        value / 12.92
+    } else {
+        ((value + 0.055) / 1.055).powf(2.4)
+    }
+}
+
+/// sRGB's curve from light to an encoded value.
+fn encode(light: f64) -> f64 {
+    if light <= 0.003_130_8 {
+        light * 12.92
+    } else {
+        1.055 * light.powf(1. / 2.4) - 0.055
+    }
+}
+
+fn to_u16(value: f64) -> u16 {
+    // Clamped to 0 to 1 first, so it fits.
+    #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss)]
+    let value = (value.clamp(0., 1.) * f64::from(u16::MAX)).round() as u16;
+    value
+}
+
+/// The degamma curve, one value for all three channels at each of `size`
+/// evenly spaced inputs.
+pub fn degamma(size: usize) -> Vec<u16> {
+    let last = (size.max(2) - 1) as f64;
+    (0..size).map(|i| to_u16(decode(i as f64 / last))).collect()
+}
+
+/// The gamma curve as niri's gamma ramps lay it out, `size` reds, then
+/// `size` greens, then `size` blues: sRGB's encoding, followed by a gamma
+/// control client's ramp when it has set one, so a night light still works
+/// on what the screen is sent.
+pub fn gamma(size: usize, client: Option<&[u16]>) -> Vec<u16> {
+    let last = (size.max(2) - 1) as f64;
+    let encoded = (0..size).map(|i| encode(i as f64 / last));
+    match client {
+        None => {
+            let channel: Vec<u16> = encoded.map(to_u16).collect();
+            channel.repeat(3)
+        }
+        Some(ramp) => {
+            let steps = ramp.len() / 3;
+            let encoded: Vec<f64> = encoded.collect();
+            (0..3)
+                .flat_map(|channel| {
+                    let ramp = &ramp[channel * steps..(channel + 1) * steps];
+                    encoded.iter().map(move |&value| sample(ramp, value))
+                })
+                .collect()
+        }
+    }
+}
+
+/// A ramp read at `value`, from 0 to 1, between its two nearest steps.
+fn sample(ramp: &[u16], value: f64) -> u16 {
+    match ramp {
+        [] => to_u16(value),
+        [only] => *only,
+        _ => {
+            let position = value.clamp(0., 1.) * (ramp.len() - 1) as f64;
+            // Clamped above, so it's an index into the ramp.
+            #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss)]
+            let below = (position.floor() as usize).min(ramp.len() - 2);
+            let fraction = position - below as f64;
+            let (a, b) = (f64::from(ramp[below]), f64::from(ramp[below + 1]));
+            to_u16((a + (b - a) * fraction) / f64::from(u16::MAX))
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The XPS 14 DA14260's OLED panel (LG Display), as its EDID gives it.
+    const PANEL: Primaries = Primaries {
+        red: (0.6894, 0.3095),
+        green: (0.2402, 0.7207),
+        blue: (0.1357, 0.0449),
+        white: (0.3134, 0.3291),
+    };
+
+    /// Its EDID's bytes 25 to 34, and an HP Z27k G3's, an sRGB monitor.
+    const PANEL_BYTES: [u8; 10] = [0x9a, 0xe5, 0xb0, 0x4f, 0x3d, 0xb8, 0x22, 0x0b, 0x50, 0x54];
+    const MONITOR_BYTES: [u8; 10] = [0xee, 0x95, 0xa3, 0x54, 0x4c, 0x99, 0x26, 0x0f, 0x50, 0x54];
+
+    fn edid(colours: [u8; 10]) -> Vec<u8> {
+        let mut edid = vec![0u8; 128];
+        edid[25..35].copy_from_slice(&colours);
+        edid
+    }
+
+    fn close(a: f64, b: f64, within: f64) -> bool {
+        (a - b).abs() <= within
+    }
+
+    #[test]
+    fn reads_the_panel_from_its_edid() {
+        // The panel's bytes 25 to 34, read from its connector.
+        let read = Primaries::from_edid(&edid(PANEL_BYTES)).unwrap();
+        for (got, want) in [
+            (read.red, PANEL.red),
+            (read.green, PANEL.green),
+            (read.blue, PANEL.blue),
+            (read.white, PANEL.white),
+        ] {
+            assert!(close(got.0, want.0, 0.001), "{got:?} against {want:?}");
+            assert!(close(got.1, want.1, 0.001), "{got:?} against {want:?}");
+        }
+    }
+
+    #[test]
+    fn an_edid_without_colours_has_no_primaries() {
+        assert_eq!(Primaries::from_edid(&[0u8; 128]), None);
+        assert_eq!(Primaries::from_edid(&[0u8; 20]), None);
+    }
+
+    #[test]
+    fn the_panel_takes_srgb_to_its_own_primaries() {
+        // X7FXPL's matrix for this panel, worked by hand.
+        let want = [
+            [0.7350, 0.2297, 0.0353],
+            [0.0473, 0.9363, 0.0164],
+            [0.0163, 0.0796, 0.9042],
+        ];
+        let got = PANEL.srgb_to_screen().unwrap();
+        for row in 0..3 {
+            for column in 0..3 {
+                assert!(
+                    close(got[row][column], want[row][column], 0.0005),
+                    "{got:?}"
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn the_colour_is_set_the_first_time_and_when_it_changes() {
+        let matrix = PANEL.srgb_to_screen().unwrap();
+        assert!(colour_changes(None, None), "never set, so a stale one stays");
+        assert!(colour_changes(None, Some(matrix)));
+        assert!(colour_changes(Some(None), Some(matrix)));
+        assert!(colour_changes(Some(Some(matrix)), None));
+    }
+
+    #[test]
+    fn a_gamma_step_leaves_the_colour_as_it_was() {
+        let matrix = PANEL.srgb_to_screen().unwrap();
+        assert!(!colour_changes(Some(Some(matrix)), Some(matrix)));
+        assert!(!colour_changes(Some(None), None));
+    }
+
+    #[test]
+    fn white_stays_white() {
+        let matrix = PANEL.srgb_to_screen().unwrap();
+        for row in matrix {
+            assert!(close(row.iter().sum(), 1., 1e-9), "{row:?}");
+        }
+    }
+
+    #[test]
+    fn an_srgb_screen_is_left_as_it_is() {
+        let srgb = Primaries {
+            red: SRGB_RED,
+            green: SRGB_GREEN,
+            blue: SRGB_BLUE,
+            white: (0.3127, 0.3290),
+        };
+        let matrix = srgb.srgb_to_screen().unwrap();
+        for (row, values) in matrix.iter().enumerate() {
+            for (column, &value) in values.iter().enumerate() {
+                let identity = if row == column { 1. } else { 0. };
+                assert!(close(value, identity, 1e-9), "{matrix:?}");
+            }
+        }
+    }
+
+    #[test]
+    fn an_srgb_monitor_barely_moves() {
+        let monitor = Primaries::from_edid(&edid(MONITOR_BYTES)).unwrap();
+        let matrix = monitor.srgb_to_screen().unwrap();
+        for (row, values) in matrix.iter().enumerate() {
+            for (column, &value) in values.iter().enumerate() {
+                let identity = if row == column { 1. } else { 0. };
+                assert!(close(value, identity, 0.01), "{matrix:?}");
+            }
+        }
+    }
+
+    #[test]
+    fn primaries_that_stand_for_no_screen_have_no_matrix() {
+        // In a line, so no three of them make a gamut.
+        let flat = Primaries {
+            red: (0.3, 0.3),
+            green: (0.4, 0.4),
+            blue: (0.45, 0.45),
+            white: (0.3134, 0.3291),
+        };
+        assert_eq!(flat.srgb_to_screen(), None);
+        // A gamut, but a sliver round white, which sRGB's colours would
+        // overflow many times over.
+        let sliver = Primaries {
+            red: (0.33, 0.33),
+            green: (0.31, 0.35),
+            blue: (0.30, 0.31),
+            white: (0.3134, 0.3291),
+        };
+        assert_eq!(sliver.srgb_to_screen(), None);
+    }
+
+    #[test]
+    fn only_an_srgb_screen_counts_as_srgb() {
+        let monitor = Primaries::from_edid(&edid(MONITOR_BYTES)).unwrap();
+        assert!(changes_nothing(&monitor.srgb_to_screen().unwrap()));
+        assert!(!changes_nothing(&PANEL.srgb_to_screen().unwrap()));
+    }
+
+    #[test]
+    fn the_kernel_reads_the_matrix_as_s31_32() {
+        let ctm = ctm(&[[1., -0.5, 0.25], [0., 2., -1.], [0.75, 0., 1.5]]);
+        assert_eq!(ctm[0], 1 << 32);
+        assert_eq!(ctm[1], (1 << 63) | (1 << 31));
+        assert_eq!(ctm[2], 1 << 30);
+        assert_eq!(ctm[3], 0);
+        assert_eq!(ctm[4], 2 << 32);
+        assert_eq!(ctm[5], (1 << 63) | (1 << 32));
+        assert_eq!(ctm[6], 3 << 30);
+        assert_eq!(ctm[8], 3 << 31);
+    }
+
+    #[test]
+    fn the_curves_undo_each_other() {
+        for i in 0..=1000 {
+            let value = f64::from(i) / 1000.;
+            assert!(close(encode(decode(value)), value, 1e-12), "{value}");
+        }
+        let degamma = degamma(129);
+        assert_eq!((degamma[0], degamma[128]), (0, u16::MAX));
+        // Half the encoded value is a fifth of the light.
+        assert!(close(f64::from(degamma[64]) / 65535., 0.2140, 0.001));
+    }
+
+    #[test]
+    fn the_gamma_curve_encodes_each_channel_alike() {
+        let gamma = gamma(1024, None);
+        assert_eq!(gamma.len(), 3072);
+        assert_eq!(&gamma[..1024], &gamma[1024..2048]);
+        assert_eq!(&gamma[..1024], &gamma[2048..]);
+        assert_eq!((gamma[0], gamma[1023]), (0, u16::MAX));
+        assert!(gamma[..1024].windows(2).all(|pair| pair[0] <= pair[1]));
+    }
+
+    #[test]
+    fn a_clients_ramp_follows_the_encoding() {
+        // A night light: full red, three quarters green, half blue.
+        let steps = 256;
+        let ramp: Vec<u16> = [1., 0.75, 0.5]
+            .iter()
+            .flat_map(|&gain: &f64| {
+                (0..steps).map(move |i| to_u16(gain * f64::from(i) / f64::from(steps - 1)))
+            })
+            .collect();
+        let gamma = gamma(1024, Some(&ramp));
+        let plain = super::gamma(1024, None);
+        assert_eq!(gamma.len(), 3072);
+        for i in [0, 100, 511, 1023] {
+            let encoded = f64::from(plain[i]);
+            assert!(close(f64::from(gamma[i]), encoded, 2.));
+            assert!(close(f64::from(gamma[1024 + i]), encoded * 0.75, 2.));
+            assert!(close(f64::from(gamma[2048 + i]), encoded * 0.5, 2.));
+        }
+    }
+}
