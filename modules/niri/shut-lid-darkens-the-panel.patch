+    /// Someone pressed a key, clicked or moved a pointer while the lid reads
+    /// shut and no screen is lit, which nobody can do with the lid shut. The
+    /// lid's switch is wrong, so the lid is taken as open, lighting the panel
+    /// again, until the switch next changes.
+    pub fn lid_proven_open(&mut self) {
+        if !self.niri.is_lid_closed || self.niri.global_space.outputs().next().is_some() {
+            return;
+        }
+
+        info!("laptop lid taken as open: used with no screen lit while it read shut");
+        self.set_lid_closed(false);
+    }
