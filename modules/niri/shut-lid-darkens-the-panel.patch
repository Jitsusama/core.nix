+/// Whether the event is one nobody can make with the lid shut: a key, a click
+/// or a pointer moved. A touch or a pen isn't, since a shut lid can press the
+/// screen.
+fn proves_the_lid_open<I: InputBackend>(event: &InputEvent<I>) -> bool {
+    match event {
+        InputEvent::TouchDown { .. }
+        | InputEvent::TouchMotion { .. }
+        | InputEvent::TabletToolAxis { .. }
+        | InputEvent::TabletToolProximity { .. }
+        | InputEvent::TabletToolTip { .. }
+        | InputEvent::TabletToolButton { .. } => false,
+        _ => should_activate_monitors(event),
+    }
+}
