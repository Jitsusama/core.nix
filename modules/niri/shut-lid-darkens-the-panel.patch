diff --git a/src/tests/lid.rs b/src/tests/lid.rs
new file mode 100644
index 0000000..2207cf1
--- /dev/null
+++ b/src/tests/lid.rs
@@ -0,0 +1,29 @@
+use super::*;
+
+#[test]
+fn a_shut_lid_with_no_screen_lit_is_taken_as_open_once_used() {
+    let mut f = Fixture::new();
+    f.niri_state().set_lid_closed(true);
+    assert!(f.niri().is_lid_closed);
+
+    f.niri_state().lid_proven_open();
+    assert!(!f.niri().is_lid_closed);
+}
+
+#[test]
+fn a_shut_lid_beside_a_lit_screen_stays_shut_when_used() {
+    let mut f = Fixture::new();
+    f.add_output(1, (1920, 1080));
+    f.niri_state().set_lid_closed(true);
+
+    f.niri_state().lid_proven_open();
+    assert!(f.niri().is_lid_closed);
+}
+
+#[test]
+fn an_open_lid_stays_open_when_used() {
+    let mut f = Fixture::new();
+
+    f.niri_state().lid_proven_open();
+    assert!(!f.niri().is_lid_closed);
+}
