+    /// Whether this bottom layer surface is drawn once on its output, where it is, rather than
+    /// on each workspace and moved with it as they slide: one whose namespace
+    /// NIRI_FIXED_TO_OUTPUT names, among others split by commas, read as niri starts, so its
+    /// config stays one a niri before this reads too. Only the bottom layer: a background
+    /// surface lies under each workspace's own background, which a single copy would be under.
+    pub fn fixed_to_output(&self) -> bool {
+        static NAMED: OnceLock<Vec<String>> = OnceLock::new();
+        let named = NAMED.get_or_init(|| {
+            std::env::var("NIRI_FIXED_TO_OUTPUT")
+                .unwrap_or_default()
+                .split(',')
+                .filter(|name| !name.is_empty())
+                .map(String::from)
+                .collect()
+        });
+
+        self.surface.layer() == Layer::Bottom
+            && named.iter().any(|name| name == self.surface.namespace())
+    }
+
