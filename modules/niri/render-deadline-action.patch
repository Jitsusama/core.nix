Adds a SetRenderDeadline action, IPC alone and marked knuffel(skip) so
the config can't name it, which turns render-deadline.patch's deadline
on or off while niri runs, so it can be tried by feel without restarting
niri. `niri msg action set-render-deadline true` turns it on, and false
off. Ours, not upstream's.

diff --git a/niri-config/src/binds.rs b/niri-config/src/binds.rs
index 36a69c7..a2c7c10 100644
--- a/niri-config/src/binds.rs
+++ b/niri-config/src/binds.rs
@@ -108,6 +108,8 @@ pub enum Action {
     PowerOnMonitors,
     #[knuffel(skip)]
     SetPanelSaturation(f64),
+    #[knuffel(skip)]
+    SetRenderDeadline(bool),
     PowerOffMonitor(#[knuffel(argument)] String),
     PowerOnMonitor(#[knuffel(argument)] String),
     ToggleDebugTint,
@@ -411,6 +413,7 @@ impl From<niri_ipc::Action> for Action {
             niri_ipc::Action::SetPanelSaturation { saturation } => {
                 Self::SetPanelSaturation(saturation)
             }
+            niri_ipc::Action::SetRenderDeadline { on } => Self::SetRenderDeadline(on),
             niri_ipc::Action::PowerOffMonitor { output } => Self::PowerOffMonitor(output),
             niri_ipc::Action::PowerOnMonitor { output } => Self::PowerOnMonitor(output),
             niri_ipc::Action::Spawn { command } => Self::Spawn(command),
