+/// The most a panel's colours may be saturated, or the least: past twice, a
+/// matrix sends every strong colour to full and hues shift with it, and below
+/// none it would invert them.
+pub const SATURATION: std::ops::RangeInclusive<f64> = 0.0..=2.0;
+
+/// sRGB's luminance from its linear red, green and blue (ITU-R BT.709), which
+/// a change of saturation keeps, so greys and white stay as they were.
+const SRGB_LUMINANCE: [f64; 3] = [0.2126, 0.7152, 0.0722];
+
+/// The matrix scaling linear sRGB's colourfulness by `saturation` about its
+/// grey of the same luminance: one changes nothing, more than one moves each
+/// colour away from grey, as a panel shown more vividly does, and less moves
+/// it towards grey.
+pub fn saturate(saturation: f64) -> Matrix {
+    std::array::from_fn(|row| {
+        std::array::from_fn(|column| {
+            let own = if row == column { saturation } else { 0. };
+            own + (1. - saturation) * SRGB_LUMINANCE[column]
+        })
+    })
+}
+
+/// The matrix the display engine is sent: sRGB's colours saturated, then
+/// taken to the screen's primaries where it is held to sRGB, or none when
+/// together they would change nothing anybody could see.
+pub fn screen_matrix(srgb: Option<Matrix>, saturation: f64) -> Option<Matrix> {
+    let identity: Matrix = std::array::from_fn(|row| {
+        std::array::from_fn(|column| if row == column { 1. } else { 0. })
+    });
+    let matrix = multiply(&srgb.unwrap_or(identity), &saturate(saturation));
+    (!changes_nothing(&matrix)).then_some(matrix)
+}
