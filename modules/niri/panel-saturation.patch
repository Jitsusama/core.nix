+/// How much more colourful than sRGB a laptop's own panel shows its colours,
+/// asked for through `NIRI_PANEL_SATURATION`, read at start, so a config
+/// written for this niri still parses in one without the patch: one, as they
+/// are, when it's unset or isn't a number from none to two.
+fn panel_saturation_asked() -> f64 {
+    let Some(asked) = std::env::var_os("NIRI_PANEL_SATURATION") else {
+        return 1.;
+    };
+    match asked.to_str().and_then(|asked| asked.trim().parse::<f64>().ok()) {
+        Some(saturation) if gamut::SATURATION.contains(&saturation) => saturation,
+        _ => {
+            warn!("NIRI_PANEL_SATURATION={asked:?} isn't a saturation from 0 to 2, so it's left at 1");
+            1.
+        }
+    }
+}
