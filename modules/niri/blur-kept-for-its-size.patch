diff --git a/src/render_helpers/texture_pool.rs b/src/render_helpers/texture_pool.rs
new file mode 100644
index 0000000..e7572cf
--- /dev/null
+++ b/src/render_helpers/texture_pool.rs
@@ -0,0 +1,133 @@
+//! Textures a background effect let go, kept for the next effect that needs them.
+//!
+//! smithay keeps a framebuffer effect's textures in its damage tracker only for the elements a
+//! frame draws, so a surface whose blur comes and goes, as a launcher's does each time it opens,
+//! makes its framebuffer and blur textures again inside the frame that shows it. Making them is
+//! the slow part of that frame: tens of milliseconds on the CPU when the driver has none of that
+//! size to hand. The pool keeps what an effect let go, up to a cap, and the next effect of the
+//! same size takes them rather than making new ones.
+//!
+//! A kept texture still holds the screen another surface's blur was drawn over, so whoever takes
+//! one draws over all of it before anything samples it, as a framebuffer effect's capture and
+//! each blur pass do.
+
+use std::cell::RefCell;
+use std::collections::VecDeque;
+use std::rc::Rc;
+
+use smithay::backend::allocator::Fourcc;
+use smithay::backend::renderer::gles::{GlesError, GlesRenderer, GlesTexture};
+use smithay::backend::renderer::{Offscreen as _, Texture as _};
+use smithay::utils::{Buffer, Size};
+
+/// The most the pool holds, in bytes. A launcher card with its drawer beside, at 4K's 1.5 scale,
+/// keeps about 21 MB of framebuffer and blur textures; this keeps that and a few smaller
+/// surfaces' sets, and lets the oldest go rather than holding more idle. What it keeps stays
+/// until an effect takes it or newer textures push it out, however long that is, since a
+/// launcher opened after an hour shut is the opening this is for. Other surfaces' sets, and the
+/// launcher's own at other heights, are kept beside it, so two or more of sizes it hasn't seen
+/// push its resting set out.
+const MOST: usize = 64 << 20;
+
+/// The most one effect's set may hold and still be kept. A prompt that fills a 4K screen gives
+/// up about 74 MB, more than the whole pool, and keeping it would push out every other set, the
+/// launcher's among them, for a surface seldom shown; so a set past half the pool is let go whole.
+const SET_MOST: usize = MOST / 2;
+
+// The launcher's set, about 21 MB on a 4K screen at 1.5, is the one this is for, so a smaller
+// limit would let it go each time the launcher shuts.
+const _: () = assert!(SET_MOST > 21 << 20, "the launcher's set must fit in SET_MOST");
+
+/// One renderer's kept textures, oldest first.
+#[derive(Debug, Default)]
+pub struct TexturePool {
+    kept: VecDeque<GlesTexture>,
+    bytes: usize,
+}
+
+/// What an effect's textures came from in one frame, for its log line.
+#[derive(Debug, Default, Clone, Copy)]
+pub struct Taken {
+    pub made: u32,
+    pub kept: u32,
+}
+
+fn bytes_of(texture: &GlesTexture) -> usize {
+    let size = texture.size();
+    usize::try_from(size.w).unwrap_or(0) * usize::try_from(size.h).unwrap_or(0) * 4
+}
+
+impl TexturePool {
+    /// The pool of the renderer's own context, made the first time it's asked for.
+    pub fn of(renderer: &mut GlesRenderer) -> Rc<RefCell<Self>> {
+        renderer
+            .egl_context()
+            .user_data()
+            .get_or_insert(|| Rc::new(RefCell::new(Self::default())))
+            .clone()
+    }
+
+    /// A kept texture of this format and size, or a new one from the renderer.
+    pub fn texture(
+        pool: &RefCell<Self>,
+        renderer: &mut GlesRenderer,
+        format: Fourcc,
+        size: Size<i32, Buffer>,
+        taken: &mut Taken,
+    ) -> Result<GlesTexture, GlesError> {
+        if let Ok(mut pool) = pool.try_borrow_mut() {
+            if let Some(texture) = pool.take(format, size) {
+                taken.kept += 1;
+                return Ok(texture);
+            }
+        }
+        taken.made += 1;
+        renderer.create_buffer(format, size)
+    }
+
+    fn take(&mut self, format: Fourcc, size: Size<i32, Buffer>) -> Option<GlesTexture> {
+        let at = self
+            .kept
+            .iter()
+            .rposition(|texture| texture.size() == size && texture.format() == Some(format))?;
+        let texture = self.kept.remove(at)?;
+        self.bytes -= bytes_of(&texture);
+        Some(texture)
+    }
+
+    /// Keep the set one effect gave up, of textures nothing else draws from, letting the oldest
+    /// go past the cap.
+    pub fn keep(&mut self, set: Vec<GlesTexture>) {
+        // A texture still shared would be drawn into under whoever holds it.
+        let set: Vec<_> = set
+            .into_iter()
+            .filter_map(|mut texture| texture.is_unique_reference().then_some(texture))
+            .collect();
+        let bytes: usize = set.iter().map(bytes_of).sum();
+        if bytes > SET_MOST {
+            debug!(
+                "the texture pool kept none of a set of {} MB, over half its {} MB",
+                bytes >> 20,
+                MOST >> 20
+            );
+            return;
+        }
+        self.bytes += bytes;
+        self.kept.extend(set);
+        let mut let_go = 0;
+        while self.bytes > MOST {
+            let Some(oldest) = self.kept.pop_front() else {
+                break;
+            };
+            self.bytes -= bytes_of(&oldest);
+            let_go += 1;
+        }
+        // Said once a set, so a surface resizing each frame logs no more than its own line does.
+        if let_go > 0 {
+            debug!(
+                "the texture pool let go of {let_go} textures, keeping {} MB",
+                self.bytes >> 20
+            );
+        }
+    }
+}
