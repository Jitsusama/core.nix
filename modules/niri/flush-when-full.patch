diff --git a/src/server/tests.rs b/src/server/tests.rs
index fa70c7d..bff3bb0 100644
--- a/src/server/tests.rs
+++ b/src/server/tests.rs
@@ -3343,3 +3343,75 @@ fn decorations_max_height_int_max() {
 /// See Pointer::handle_event for an explanation.
 #[test]
 fn popup_pointer_motion_workaround() {}
+
+// A client destroying a shm pool while satellite's socket to the compositor is full, as a storm
+// of X11 windows can leave it, slows satellite rather than killing it, and what it sends later
+// still arrives. testwl reads on this thread, never while satellite polls, so this covers the
+// Destroy, the backlog past 4 KB and the pending flush, not a retry after poll finds room.
+#[test]
+fn shm_pool_destroy_with_full_socket() {
+    let (mut f, compositor) = TestFixture::new_with_compositor();
+    let fd = unsafe { BorrowedFd::borrow_raw(0) };
+    let pool = TestObject::<WlShmPool>::from_request(
+        &compositor.shm.obj,
+        Req::<WlShm>::CreatePool { fd, size: 1024 },
+    );
+    let backlog = TestObject::<WlShmPool>::from_request(
+        &compositor.shm.obj,
+        Req::<WlShm>::CreatePool { fd, size: 1024 },
+    );
+    f.run();
+    let resize = |pool: &TestObject<WlShmPool>, f: &mut TestFixture<_>| {
+        for _ in 0..100 {
+            pool.send_request(Req::<WlShmPool>::Resize { size: 1024 })
+                .unwrap();
+        }
+        f.xwls_connection.flush().unwrap();
+        f.xwls_display.dispatch_clients(&mut *f.satellite).unwrap();
+    };
+
+    // Fill satellite's socket to the compositor by not letting testwl read it. The send buffer is
+    // shrunk to the kernel's floor of a few KB, so a builder's own socket defaults don't decide
+    // whether it fills; a hundred rounds of about 1.2 KB that never fill it fail rather than hang.
+    rustix::net::sockopt::set_socket_send_buffer_size(f.satellite.clientside_fd(), 4096).unwrap();
+    let mut filled = false;
+    for _ in 0..100 {
+        resize(&pool, &mut f);
+        match f.satellite.queue.flush() {
+            Ok(()) => {}
+            Err(WaylandError::Io(e)) if e.kind() == std::io::ErrorKind::WouldBlock => {
+                filled = true;
+                break;
+            }
+            Err(e) => panic!("Failed to flush: {e:?}"),
+        }
+    }
+    assert!(filled, "satellite's socket to the compositor never filled");
+
+    // Destroy the pool into the full socket, and let the main loop's flush give up on it too,
+    // with testwl still not reading.
+    pool.send_request(Req::<WlShmPool>::Destroy).unwrap();
+    f.xwls_connection.flush().unwrap();
+    f.xwls_display.dispatch_clients(&mut *f.satellite).unwrap();
+    f.satellite.run();
+
+    // Requests go on coming while the compositor is behind, far past the 4 KB wayland-backend
+    // buffered before 0.3.12, which then lost the connection.
+    for _ in 0..10 {
+        resize(&backlog, &mut f);
+    }
+    f.satellite.run();
+    assert!(f.satellite.flush_pending(), "the backlog all went out with testwl not reading");
+
+    // The stream is ordered and losing a request ends it, so a surface asked for after the
+    // backlog arriving means all of it did. Each run lets testwl read a socketful.
+    let _surface = compositor.create_surface();
+    for _ in 0..20 {
+        f.run();
+        if !f.testwl.created_surfaces().is_empty() && !f.satellite.flush_pending() {
+            break;
+        }
+    }
+    assert_eq!(f.testwl.created_surfaces().len(), 1);
+    assert!(!f.satellite.flush_pending(), "requests were still queued once testwl read");
+}
