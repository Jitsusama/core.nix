+/// What the main loop waits on from the compositor: its events, and room to write while a flush
+/// left requests queued, since nothing else wakes satellite to send them once the compositor has
+/// read what it was sent.
+fn compositor_flags(flush_pending: bool) -> PollFlags {
+    if flush_pending {
+        PollFlags::IN | PollFlags::OUT
+    } else {
+        PollFlags::IN
+    }
+}
