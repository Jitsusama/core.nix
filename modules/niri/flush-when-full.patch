+impl<S: X11Selection> InnerServerState<S> {
+    /// Flush requests to the compositor, waiting up to `patience` (forever for none) each time
+    /// its socket is full. What isn't written stays queued and goes out with the next flush, so
+    /// a compositor falling behind slows satellite rather than killing it and every X11 window
+    /// with it.
+    pub(crate) fn flush_queue(&self, patience: Option<Duration>) {
+        let timeout = patience.map(|patience| Timespec {
+            tv_sec: patience.as_secs() as _,
+            tv_nsec: patience.subsec_nanos() as _,
+        });
+        loop {
+            match self.queue.flush() {
+                Ok(()) => return,
+                Err(wayland_client::backend::WaylandError::Io(error))
+                    if error.kind() == std::io::ErrorKind::WouldBlock =>
+                {
+                    let fd = PollFd::new(&self.queue, PollFlags::OUT);
+                    match poll(&mut [fd], timeout.as_ref()) {
+                        Ok(0) => {
+                            error!(
+                                "Failed to flush clientside events (timeout)! Will try again later."
+                            );
+                            return;
+                        }
+                        Ok(_) | Err(rustix::io::Errno::INTR) => {}
+                        Err(e) => {
+                            error!(
+                                "Failed to flush clientside events ({e})! Will try again later."
+                            );
+                            return;
+                        }
+                    }
+                }
+                Err(other) => panic!("Failed flushing clientside events: {other:#?}"),
+            }
+        }
+    }
+}
