+impl<S: X11Selection> InnerServerState<S> {
+    /// Flush requests to the compositor, waiting while its socket is full for `patience` in all,
+    /// or for as long as it takes with none. What isn't written stays queued for the next flush,
+    /// which wayland-backend buffers without bound from 0.3.12, so a compositor falling behind
+    /// slows satellite rather than killing it and every X11 window with it; one that stops
+    /// reading altogether leaves the queue growing in satellite's memory, as libwayland's would.
+    /// A patience of zero leaves a full socket to the main loop's flush, which comes at the end
+    /// of the same turn, and says nothing, since a burst of requests would otherwise say it once
+    /// each. Whatever is left, the main loop then wakes to send once the socket has room.
+    pub(crate) fn flush_queue(&self, patience: Option<Duration>) {
+        let deadline = patience.map(|patience| Instant::now() + patience);
+        let mut waited = false;
+        self.flush_pending.set(true);
+        loop {
+            match self.queue.flush() {
+                Ok(()) => {
+                    self.flush_pending.set(false);
+                    return;
+                }
+                Err(wayland_client::backend::WaylandError::Io(error))
+                    if error.kind() == std::io::ErrorKind::WouldBlock => {}
+                Err(other) => panic!("Failed flushing clientside events: {other:#?}"),
+            }
+            let left = deadline.map(|deadline| deadline.saturating_duration_since(Instant::now()));
+            if left == Some(Duration::ZERO) {
+                if patience != Some(Duration::ZERO) {
+                    error!("Failed to flush clientside events (timeout)! Will try again later.");
+                }
+                return;
+            }
+            // An endless wait freezes every X11 window, so it says why once.
+            if left.is_none() && !waited {
+                warn!("The compositor's socket is full; waiting for it to read.");
+            }
+            waited = true;
+            let timeout = left.map(|left| Timespec {
+                tv_sec: left.as_secs() as _,
+                tv_nsec: left.subsec_nanos() as _,
+            });
+            let fd = PollFd::new(&self.queue, PollFlags::OUT);
+            match poll(&mut [fd], timeout.as_ref()) {
+                Ok(_) | Err(rustix::io::Errno::INTR) => {}
+                // With no patience the caller waits on the compositor's answer next, which never
+                // comes for a request left unsent, so it can't return and try again later.
+                Err(e) if left.is_none() => panic!("Failed waiting to flush: {e}"),
+                Err(e) => {
+                    error!("Failed to flush clientside events ({e})! Will try again later.");
+                    return;
+                }
+            }
+        }
+    }
+
+    /// Whether the last flush left requests queued for the compositor.
+    pub fn flush_pending(&self) -> bool {
+        self.flush_pending.get()
+    }
+}
