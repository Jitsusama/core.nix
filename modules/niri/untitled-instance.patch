+    fn get_wm_instance(&self, window: x::Window) -> XResult<Option<String>> {
+        let cookie = self.get_property_cookie(window, x::ATOM_WM_CLASS, x::ATOM_STRING, 256);
+        let resolver = |reply: x::GetPropertyReply| {
+            let data: &[u8] = reply.value();
+            // wm class is instance + class; a class alone counts as no instance
+            let mut fields = data.split(|b| *b == 0u8).filter(|s| !s.is_empty());
+            let instance = fields.next().filter(|_| fields.next().is_some());
+            instance.map(|i| String::from_utf8_lossy(i).to_string())
+        };
+        Ok(PropertyCookieWrapper::new(&self.connection, cookie)
+            .resolve(resolver)?
+            .flatten())
+    }
