+#[test]
+fn untitled_window_goes_by_its_instance() {
+    let mut f = Fixture::new();
+    let mut connection = Connection::new(&f.display);
+    let window = connection.new_window(connection.root, 0, 0, 20, 20, false);
+    connection.set_property(
+        window,
+        x::ATOM_STRING,
+        x::ATOM_WM_CLASS,
+        b"app-webcams\0App\0",
+    );
+    connection.map_window(window);
+    f.wait_and_dispatch();
+
+    let surface = f
+        .testwl
+        .last_created_surface_id()
+        .expect("No surface created!");
+    f.configure_and_verify_new_toplevel(&mut connection, window, surface);
+    let data = f.testwl.get_surface_data(surface).unwrap();
+    assert_eq!(data.toplevel().title, Some("app-webcams".into()));
+    assert_eq!(data.toplevel().app_id, Some("App".into()));
+
+    connection.set_property(window, x::ATOM_STRING, x::ATOM_WM_NAME, b"named\0");
+    f.wait_and_dispatch();
+
+    let data = f.testwl.get_surface_data(surface).unwrap();
+    assert_eq!(data.toplevel().title, Some("named".into()));
+}
+
+#[test]
+fn class_alone_leaves_a_window_untitled() {
+    let mut f = Fixture::new();
+    let mut connection = Connection::new(&f.display);
+    let window = connection.new_window(connection.root, 0, 0, 20, 20, false);
+    connection.set_property(window, x::ATOM_STRING, x::ATOM_WM_CLASS, b"App\0");
+    connection.map_window(window);
+    f.wait_and_dispatch();
+
+    let surface = f
+        .testwl
+        .last_created_surface_id()
+        .expect("No surface created!");
+    f.configure_and_verify_new_toplevel(&mut connection, window, surface);
+    let data = f.testwl.get_surface_data(surface).unwrap();
+    assert_eq!(data.toplevel().title, None);
+    assert_eq!(data.toplevel().app_id, Some("App".into()));
+}
