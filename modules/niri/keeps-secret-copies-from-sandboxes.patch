 pub const XDG_ACTIVATION_TOKEN_TIMEOUT: Duration = Duration::from_secs(10);
 
+/// What a password manager marks a secret copy's types with, in any case: KDE's hint, which
+/// wl-copy --sensitive and KeePassXC set, and the macOS pasteboard's concealed type.
+const SECRET_MARKS: [&str; 2] = ["passwordmanagerhint", "org.nspasteboard.concealedtype"];
+
+/// The type Windows' clipboard monitors are told to pass a copy over by, which a
+/// cross-platform password manager may set here too.
+const SECRET_KINDS: [&str; 1] = ["excludeclipboardcontentfrommonitorprocessing"];
+
+/// Whether a copy offered as `types` is a password manager's secret, as the clipboard door
+/// judges one.
+fn is_secret(types: &[String]) -> bool {
+    types.iter().any(|kind| {
+        let kind = kind.to_ascii_lowercase();
+        SECRET_MARKS.iter().any(|mark| kind.contains(mark)) || SECRET_KINDS.contains(&kind.as_str())
+    })
+}
+
+/// Which of the seat's selections hold a secret, so neither is offered to a sandbox's window.
+#[derive(Debug, Default, Clone, Copy)]
+struct SecretSelections {
+    clipboard: bool,
+    primary: bool,
+}
+
+fn secret_selections(seat: &Seat<State>) -> &RefCell<SecretSelections> {
+    let data = seat.user_data();
+    data.insert_if_missing(|| RefCell::new(SecretSelections::default()));
+    data.get::<RefCell<SecretSelections>>().unwrap()
+}
+
+impl State {
+    /// Offer the seat's selections to the client of the focused surface, as any compositor
+    /// does, but to no client of a security context while the selection holds a secret.
+    ///
+    /// Data control is never offered on a security context's socket, so a sandbox's only way
+    /// to the selection is its focused window's data device, which this withholds: a secret
+    /// copied while it has the focus, or held while it takes the focus, is never offered to it.
+    pub fn offer_selections_to(&mut self, seat: &Seat<Self>, focused: Option<&WlSurface>) {
+        let dh = &self.niri.display_handle;
+        let client = focused.and_then(|s| dh.get_client(s.id()).ok());
+        let restricted = client.as_ref().is_some_and(client_is_restricted);
+        let secret = *secret_selections(seat).borrow();
+        let offered = |holds_secret| client.clone().filter(|_| !(restricted && holds_secret));
+        set_data_device_focus(dh, seat, offered(secret.clipboard));
+        set_primary_focus(dh, seat, offered(secret.primary));
+    }
+
+    /// Say the compositor set a selection of its own, which holds no secret.
+    pub fn selection_set_by_niri(&mut self, ty: SelectionTarget) {
+        let seat = self.niri.seat.clone();
+        self.selection_holds(&seat, ty, false);
+    }
+
+    /// Record whether a selection holds a secret, and offer the selections again.
+    ///
+    /// smithay calls `new_selection` before it stores the selection and offers it to the
+    /// focused client. A secret withholds at once, so the store offers it to no sandbox. Any
+    /// other copy offers again once the store is done, since offering now would hand a
+    /// sandbox the secret it replaces.
+    fn selection_holds(&mut self, seat: &Seat<Self>, ty: SelectionTarget, secret: bool) {
+        {
+            let mut secrets = secret_selections(seat).borrow_mut();
+            match ty {
+                SelectionTarget::Clipboard => secrets.clipboard = secret,
+                SelectionTarget::Primary => secrets.primary = secret,
+            }
+        }
+        let offer = |state: &mut State, seat: &Seat<State>| {
+            let focused = seat.get_keyboard().and_then(|keyboard| keyboard.current_focus());
+            state.offer_selections_to(seat, focused.as_ref());
+        };
+        if secret {
+            offer(self, seat);
+        } else {
+            let seat = seat.clone();
+            self.niri.event_loop.insert_idle(move |state| offer(state, &seat));
+        }
+    }
+}
+
 impl SeatHandler for State {
     type KeyboardFocus = WlSurface;
     type PointerFocus = WlSurface;
