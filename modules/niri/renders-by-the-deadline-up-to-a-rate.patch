+/// The fastest refresh rate, in whole hertz, that renders by its deadline:
+/// `NIRI_RENDER_DEADLINE_UP_TO_HZ` as niri starts, or every rate without it.
+pub fn up_to_hz_from_env() -> Option<u32> {
+    let value = std::env::var("NIRI_RENDER_DEADLINE_UP_TO_HZ").ok();
+    let up_to_hz = up_to_hz(value.as_deref());
+    if let Some(hz) = up_to_hz {
+        info!("render deadline: only on screens up to {hz} Hz");
+    }
+    up_to_hz
+}
+
+/// The ceiling a value names. One set but not whole hertz defers no rate rather than every rate,
+/// so a typo can't bring the deadline back to a screen too fast for it.
+fn up_to_hz(value: Option<&str>) -> Option<u32> {
+    let value = value?;
+    match value.trim().parse() {
+        Ok(hz) => Some(hz),
+        Err(_) => {
+            warn!("render deadline: {value:?} isn't whole hertz, so no screen renders by it");
+            Some(0)
+        }
+    }
+}
+
+/// Whether a screen refreshing every `refresh` renders by its deadline when only rates up to
+/// `up_to_hz` do. A faster screen's refresh leaves too little room to render late in: a 120 Hz
+/// panel missed 8 vblanks in its first 20 s, where a 60 Hz screen missed none in 3 hours.
+/// A mode's rate is rarely whole (59.997 Hz, 60.002 Hz), so half a hertz over still counts.
+pub fn defers_at(refresh: Duration, up_to_hz: Option<u32>) -> bool {
+    let Some(up_to_hz) = up_to_hz else {
+        return true;
+    };
+    refresh.as_secs_f64() * (f64::from(up_to_hz) + 0.5) >= 1.0
+}
