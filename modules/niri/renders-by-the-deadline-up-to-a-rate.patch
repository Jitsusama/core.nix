+
+    #[test]
+    fn every_rate_defers_without_a_ceiling() {
+        assert!(defers_at(REFRESH_240, None));
+        assert!(defers_at(REFRESH_120, None));
+        assert!(defers_at(REFRESH_60, None));
+    }
+
+    #[test]
+    fn a_sixty_hertz_ceiling_defers_sixty_hertz_modes() {
+        assert!(defers_at(REFRESH_60, Some(60)));
+        assert!(defers_at(hz(59.997), Some(60)));
+        assert!(defers_at(hz(60.4), Some(60)));
+        assert!(defers_at(hz(48.0), Some(60)));
+    }
+
+    #[test]
+    fn a_sixty_hertz_ceiling_renders_faster_screens_at_once() {
+        assert!(!defers_at(REFRESH_120, Some(60)));
