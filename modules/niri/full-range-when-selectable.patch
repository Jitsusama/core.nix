+    /// The panel's base block with one CTA extension holding a video
+    /// capability block, whose RGB range is selectable or not.
+    fn with_video_capability(selectable: bool) -> Vec<u8> {
+        let mut base = PANEL[..128].to_vec();
+        base[126] = 1;
+        base[127] = checksum(&base[..127]);
+        let mut cta = vec![0u8; 128];
+        cta[0] = 0x02;
+        cta[1] = 0x03;
+        // An extended tag block of two bytes: tag 0, the video capability
+        // block, whose bit 6 says the RGB range is selectable.
+        let block = [0xe2, 0x00, if selectable { 0x40 } else { 0x00 }];
+        // Where the data blocks end: after the four bytes of the header.
+        cta[2] = 7;
+        cta[4..4 + block.len()].copy_from_slice(&block);
+        cta[127] = checksum(&cta[..127]);
+        base.extend(cta);
+        base
+    }
+
+    fn checksum(bytes: &[u8]) -> u8 {
+        bytes
+            .iter()
+            .fold(0u8, |sum, &byte| sum.wrapping_add(byte))
+            .wrapping_neg()
+    }
+
