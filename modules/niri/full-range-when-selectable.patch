+//! Whether a screen takes full-range RGB, from its EDID.
+//!
+//! A TV mode, such as 3840x2160 at 60 Hz, gets limited-range RGB from the
+//! driver unless it's told otherwise, and a monitor that reads full range
+//! then shows blacks as grey. A screen whose EDID says, in a CTA video
+//! capability block, that its RGB range is selectable reads the AVI
+//! infoframe that says which range it's sent, so it can be sent full. One
+//! that says nothing, such as a TV that wants limited range, is left to the
+//! driver.
+
+/// Whether an EDID says its screen's RGB quantization range is selectable.
+pub fn rgb_range_selectable(edid: &[u8]) -> bool {
+    let Ok(info) = libdisplay_info::info::Info::parse_edid(edid) else {
+        return false;
+    };
+    let Some(edid) = info.edid() else {
+        return false;
+    };
+    edid.extensions().iter().any(|extension| {
+        libdisplay_info::cta::CTA::from_extension(extension).is_some_and(|cta| {
+            cta.data_blocks().iter().any(|block| {
+                block
+                    .video_cap()
+                    .is_some_and(|cap| cap.selectable_rgb_quantization_range)
+            })
+        })
+    })
+}
