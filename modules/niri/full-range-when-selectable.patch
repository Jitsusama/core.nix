+/// Whether a screen whose EDID says it takes either RGB range is sent full
+/// range. Asked for through `NIRI_FULL_RANGE_WHEN_SELECTABLE=1`, read at start,
+/// so a config written for this niri still parses in one without the patch.
+fn full_range_wanted() -> bool {
+    std::env::var_os("NIRI_FULL_RANGE_WHEN_SELECTABLE").is_some_and(|v| v == "1")
+}
+
+/// Sets the connector's `Broadcast RGB` to Full when the screen's EDID says it
+/// takes either range. The driver's Automatic sends limited range for a TV
+/// mode such as 3840x2160 at 60 Hz, which a monitor reading full range shows
+/// with grey blacks. It says whether it set it.
+fn full_range_where_selectable(
+    device: &DrmDevice,
+    props: &ConnectorProperties,
+) -> anyhow::Result<bool> {
+    let edid = get_edid(device, props.connector)?;
+    if !range::rgb_range_selectable(&edid) {
+        return Ok(false);
+    }
+    let (info, value) = props.find(c"Broadcast RGB")?;
+    let property::ValueType::Enum(values) = info.value_type() else {
+        bail!("wrong property type")
+    };
+    let (_, enums) = values.values();
+    let full = enums
+        .iter()
+        .find(|e| e.name() == c"Full")
+        .context("no Full range")?
+        .value();
+    if *value != full {
+        props
+            .device
+            .set_property(props.connector, info.handle(), full)
+            .context("error setting property")?;
+    }
+    Ok(true)
+}
