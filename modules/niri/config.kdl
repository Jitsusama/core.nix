// Joel's niri: how it behaves. home.nix writes the rest beside it: the
// colours, spaces and animations in theme.kdl, from jitsusama.theme, the
// shortcuts in binds.kdl, from binds.nix, and how a held key repeats in
// keyboard.kdl, from ../keyboard/repeat.nix. niri's own guide to every section:
// https://github.com/niri-wm/niri/wiki/Configuration:-Introduction

include "theme.kdl"
include "binds.kdl"
include "keyboard.kdl"

input {
    keyboard {
        // Every keyboard reaches niri as US QWERTY: Joel's own lays out
        // Colemak in its firmware, and keyd does it below niri for a laptop's.
        xkb {
            layout "us"
        }
    }

    // As on his Mac: press to click, two fingers for the right button, and
    // content that follows the fingers.
    touchpad {
        click-method "clickfinger"
        natural-scroll
        dwt
    }

    // A touchscreen is the laptop's own panel, which Linux names eDP-1.
    // Unmapped, it would stretch across every screen plugged in.
    touch {
        map-to-output "eDP-1"
    }

    // Focus follows the pointer, as it did in i3, without scrolling the
    // view to reveal a window the pointer only grazes.
    focus-follows-mouse max-scroll-amount="0%"
}

// The gaps, border width and corners come from theme.kdl.
layout {
    center-focused-column "never"
    default-column-width {
        proportion 0.5
    }
    // Super+R cycles a column through these widths, and Super+Shift+R a
    // window through these heights, so windows stacked in a column split it
    // in the same thirds and halves the columns split the screen in.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // A thin border marks the focused window; no ring, no shadow.
    focus-ring {
        off
    }
}

// Programs draw no title bars of their own; niri's border says enough.
prefer-no-csd

// niri copies every screenshot to the clipboard and saves it here too.
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

// The launcher's collection of every layer's shortcuts stands in for niri's
// overlay, which shows only niri's own, so the overlay never opens unasked.
hotkey-overlay {
    skip-at-startup
}

// Quickshell's wallpaper sits behind the workspaces, which theme.kdl draws
// clear when there's a picture, so it stands still while they move.
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

// Quickshell's floating surfaces ask niri to blur behind their own rounded
// shape; this blurs the windows there, not only the wallpaper, so a surface
// hints at what it floats over. It's worked out again only while one shows
// and what's beneath it changes.
layer-rule {
    match namespace="^(launcher|polkit|notifications|volume|microphone|brightness|power)$"
    background-effect {
        xray false
    }
}

// A shared screen never shows a secret or a message: the launcher holds the
// clipboard's history, and polkit asks for a password. Notices are kept out
// of the screenshots niri takes by itself as well, so one never lands in the
// next shot; picking a region still sees them.
layer-rule {
    match namespace="^(launcher|polkit)$"
    block-out-from "screencast"
}

layer-rule {
    match namespace="^notifications$"
    block-out-from "screen-capture"
}

window-rule {
    match app-id="^1Password$"
    block-out-from "screencast"
}
