+/// Look a host's addresses of one family up, each with the canonical name its
+/// addrinfo struct holds. A failed lookup has no addresses.
+fn lookup_family(hostname: &str, family: i32) -> Vec<(Option<String>, IpAddr)> {
+    // Boths hints are necessary to mimick the glibc behaviour.
+    let hints = AddrInfoHints {
+        // The canonical name will be filled in the first
+        // addrinfo struct returned by getaddrinfo.
+        flags: AI_CANONNAME,
+        // There's no way to convey socktype in the the Nscd
+        // protocol, neither in the request nor response.
+        //
+        // Set this to SOCK_STREAM to match glibc and unscd
+        // behaviour.
+        socktype: SOCK_STREAM,
+        address: family,
+        protocol: 0,
+    };
+    match dns_lookup::getaddrinfo(Some(hostname), None, Some(hints)) {
+        Ok(found) => found
+            .filter_map(|e| e.ok())
+            .map(|e| (e.canonname, e.sockaddr.ip()))
+            .collect(),
+        Err(_) => vec![],
+    }
+}
