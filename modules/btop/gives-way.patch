+	auto fitting(const string& boxes) -> string {
+		string fit = boxes;
+		for (const string_view dropped : {"net", "mem"}) {
+			if (const auto [width, height] = needed(fit); Term::width >= width and Term::height >= height) break;
+			string kept;
+			for (const auto& box : Tools::ssplit(fit)) {
+				if (box == dropped) continue;
+				if (not kept.empty()) kept += ' ';
+				kept += box;
+			}
+			fit = kept;
+		}
+		return fit;
+	}
+
+	auto get_min_size(const string& boxes) -> array<int, 2> {
