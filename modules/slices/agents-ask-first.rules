// No agent's process may put a polkit prompt on Joel's screen but one:
// running a command as root, through run0 or pkexec, which asks him once
// for that command alone while his session is in front (agentAsks). An
// agent's root step that has to become a line he types himself stops him
// getting things done, which is a bug, not a safeguard. Whatever else
// would have asked him is refused outright, so the agent hears a plain
// "not authorized" and he never sees a box he didn't call up. An agent's
// process is one in agents.slice, where every pi session runs, in
// jobs.service, where pi starts each command, in jobs-work.slice, where
// the jobs sorter moves them, in jobs-timed.slice, where pi's queue gives
// a VM test its turn, in shared.slice, where a push waits on its walk
// slot, or in a pi-jobs scope, which the jobs broker starts for a fenced
// command wherever it places it. What Joel starts at a terminal runs in
// jobs-awaited.slice and asks as it always did. Nothing timed or shared
// needs to ask: a timer that leans on a grant, such as suspending, keeps it.
// What a rule already grants without asking, a switch or a slice's weight,
// agents keep. agents-ask.nix says why, and agents-ask-last.rules,
// read after every other rule, refuses what polkit's own defaults would ask.
//
// This catches an agent's mistake, not one set on getting round it: a
// process can move itself to another slice of the account's, and keeping
// it from doing so is the fence's work.

// Where the process asking runs: the cgroup the kernel has it in, or null
// for one that's gone or can't be read.
function placeOf(subject) {
  try {
    var cgroup = polkit.spawn(["@cat@", "/proc/" + subject.pid + "/cgroup"]);
    return cgroup.replace(/^0::/, "").replace(/\n$/, "");
  } catch (_gone) {
    return null;
  }
}

// Whether a place is an agent's. A process that's gone is taken as one,
// since a prompt for it would answer nobody.
function fromAgents(place) {
  return (
    place === null ||
    /\/(agents|jobs-work|jobs-timed|shared)\.slice\//.test(place) ||
    /\/jobs\.slice\/jobs\.service(\/|$)/.test(place) ||
    /\/pi-jobs-[^/]*\.scope(\/|$)/.test(place)
  );
}

// polkit's own lines name only a process, gone by the time anyone reads
// them, so each refusal, and each ask a rule puts to Joel, says where the
// process ran: the next "who asked" is answered from the journal, as
// polkit-asks. polkit.log can't say it, since polkitd runs with its
// stderr closed (--no-debug), so logger does. A line that can't be written
// changes no answer.
function record(line) {
  try {
    polkit.spawn(["@logger@", "--tag", "polkit-asks", "--", line]);
  } catch (_unwritten) {
    // The answer stands without its line.
  }
}

function refused(action, subject, place) {
  record("refused " + action.id + " to pid " + subject.pid + " in " + (place || "a process gone"));
  return polkit.Result.NO;
}

// What an agent may ask Joel for, each with the verb its asker names:
// run0 starts its command as a transient unit of the system's (systemd's
// StartTransientUnit asks manage-units for "start"), and pkexec asks for
// itself. A unit's other verbs, its files and every other action stay
// refused, so a stray client, as libvirt's was on 12 November, still
// raises nothing.
var agentsMayAsk = {
  "org.freedesktop.systemd1.manage-units": "start",
  "org.freedesktop.policykit.exec": null,
};

// The command a process runs, as ps says it on one line, cut short where
// it runs on; null for one gone. The journal keeps what Joel was asked.
function commandOf(subject) {
  try {
    var said = polkit.spawn(["@ps@", "-o", "args=", "-p", String(subject.pid)]);
    var command = said.replace(/\s+/g, " ").replace(/^ | $/g, "");
    return command === "" ? null : command.slice(0, 300);
  } catch (_gone) {
    return null;
  }
}

// An agent's ask to run one command as root, put to Joel: his password,
// or his key's touch where yubikey's once-in.sh lets polkit take one,
// for this command only (auth_admin, never kept), and only while his
// session is the one in front, so nothing asks a screen he isn't at. Null
// for anything else an agent asks, which is refused.
function agentAsks(action, subject, place) {
  if (!agentsMayAsk.hasOwnProperty(action.id)) {
    return null;
  }
  var verb = agentsMayAsk[action.id];
  if (verb !== null && action.lookup("verb") !== verb) {
    return null;
  }
  if (place === null || !subject.local || !subject.active) {
    return null;
  }
  var command = commandOf(subject);
  if (command === null) {
    return null;
  }
  record(
    "asks Joel for " + action.id + " for pid " + subject.pid + " in " + place +
      " running " + command
  );
  return polkit.Result.AUTH_ADMIN;
}

// An agent's answer: its one ask put to Joel, or a refusal.
function forAgent(action, subject, place) {
  return agentAsks(action, subject, place) || refused(action, subject, place);
}

// Every rule added from here on has its asking turned into a refusal for
// an agent's process, so a rule that asks an administrator (fwupd's, or a
// switch to a system it doesn't know) never asks on an agent's behalf.
// polkit reads the rules again into the same engine when they change, so
// the wrapping starts from the addRule it first had, never from its own.
polkit._addRuleAsGiven = polkit._addRuleAsGiven || polkit.addRule;
(function () {
  var addRule = polkit._addRuleAsGiven;
  polkit.addRule = function (rule) {
    addRule.call(polkit, function (action, subject) {
      var result = rule(action, subject);
      if (!/^auth_/.test(result)) {
        return result;
      }
      var place = placeOf(subject);
      if (fromAgents(place)) {
        return forAgent(action, subject, place);
      }
      record("asks Joel for " + action.id + " for pid " + subject.pid + " in " + place);
      return result;
    });
  };
})();
