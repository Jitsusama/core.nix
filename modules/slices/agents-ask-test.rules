// The cases of agents-ask-first.rules and agents-ask-last.rules, run by
// duktape, polkit's own engine, after agents-ask-polkit.rules, polkit's
// init.js and a workstation's 10-nixos.rules as polkitd reads it, with
// the first rules, one that asks (firmware-asks.rules), one that grants
// (work-slices.rules) and the last rules, and after catalogued, which says
// whether the machine names a root step agents may repeat
// (modules/slices/checks.nix).
var account = "/user.slice/user-1000.slice/user@1000.service/";
var where = {
  session: account + "agents.slice/kitty-3272-33.scope",
  host: account + "agents.slice/pi-host-work-background.service",
  work: account + "jobs.slice/jobs-work.slice/jobs-work-qestabc.slice/work-12-3.scope",
  command: account + "jobs.slice/jobs.service",
  timed: account + "jobs.slice/jobs-timed.slice/work-16-2.scope",
  shared: account + "shared.slice/run-p17-i9.scope",
  brokered: account + "app.slice/pi-jobs-qestabc-1.scope",
  node: account + "agents.slice/mycelium.service",
  held: account + "agents.slice/mycelium-pi-3f2a.scope",
  terminal: account + "jobs.slice/jobs-awaited.slice/awaited-40-5.scope",
  app: account + "app.slice/app-niri-kitty-41.scope",
};
var pids = {
  session: 10,
  host: 11,
  work: 12,
  terminal: 13,
  app: 14,
  command: 15,
  timed: 16,
  shared: 17,
  brokered: 18,
  node: 19,
  held: 20,
};
for (var place in where) {
  processes[pids[place]] = where[place];
}

function joels(pid) {
  var subject = new Subject();
  subject.pid = pid;
  subject.user = "jitsusama";
  subject.groups = ["users", "wheel"];
  subject.seat = "seat0";
  subject.session = "2";
  subject.local = true;
  subject.active = true;
  return subject;
}

function asking(id, details) {
  var action = new Action();
  action.id = id;
  for (var key in details) {
    action["_detail_" + key] = details[key];
  }
  return action;
}

var failed = 0;
function expect(what, action, place, said) {
  var answer = polkit._runRules(action, joels(pids[place] || 99));
  if (answer !== said) {
    failed += 1;
    print("FAIL " + what + " from " + place + ": " + answer + ", not " + said);
  }
}

var libvirt = asking("org.libvirt.unix.manage", {});
var firmware = asking("org.freedesktop.fwupd.update-internal", {});
var weight = asking("org.freedesktop.systemd1.manage-units", {
  verb: "set-property",
  unit: "build.slice",
});

// What no rule answers is polkit's default, which asks Joel: an agent is
// refused it, and Joel's own terminal and apps are left to it.
expect("libvirt's system connection", libvirt, "session", "no");
expect("libvirt's system connection", libvirt, "host", "no");
expect("libvirt's system connection", libvirt, "work", "no");
expect("libvirt's system connection", libvirt, "command", "no");
expect("libvirt's system connection", libvirt, "timed", "no");
expect("libvirt's system connection", libvirt, "shared", "no");
expect("libvirt's system connection", libvirt, "brokered", "no");
expect("libvirt's system connection", libvirt, "terminal", null);
expect("libvirt's system connection", libvirt, "app", null);

// A rule that asks an administrator asks Joel, never for an agent.
expect("writing firmware", firmware, "session", "no");
expect("writing firmware", firmware, "work", "no");
expect("writing firmware", firmware, "command", "no");
expect("writing firmware", firmware, "terminal", "auth_admin_keep");
expect("writing firmware", firmware, "app", "auth_admin_keep");

// What a rule grants unasked, agents keep.
expect("a work slice's weight", weight, "session", "yes");
expect("a work slice's weight", weight, "command", "yes");
expect("a work slice's weight", weight, "timed", "yes");
expect("a work slice's weight", weight, "terminal", "yes");

// So is holding the efficient cores' clock, and freeing it, for an
// administrator, but nothing else of that unit's, and no unit named like it.
function held(verb, unit) {
  return asking("org.freedesktop.systemd1.manage-units", { verb: verb, unit: unit });
}
var hold = "efficient-cores-held@1600.service";
expect("holding the efficient cores", held("start", hold), "command", "yes");
expect("freeing the efficient cores", held("stop", hold), "session", "yes");
expect("holding the efficient cores", held("start", hold), "terminal", "yes");
expect("killing the efficient cores' hold", held("kill", hold), "command", "no");
expect("restarting the efficient cores' hold", held("restart", hold), "command", "no");
expect("a hold at no speed", held("start", "efficient-cores-held@0.service"), "command", "no");
["start", "stop"].forEach(function (verb) {
  expect(verb + " at the lowest speed", held(verb, "efficient-cores-held@400.service"),
    "command", "yes");
  expect(verb + " at the highest speed", held(verb, "efficient-cores-held@5000.service"),
    "command", "yes");
});
expect("a hold below the lowest speed", held("start", "efficient-cores-held@399.service"),
  "command", "no");
expect("a hold above the highest speed", held("start", "efficient-cores-held@5001.service"),
  "command", "no");
expect("a hold at a wrapping speed", held("start", "efficient-cores-held@999999.service"),
  "command", "no");
expect("a hold at a speed read as octal", held("start", "efficient-cores-held@010.service"),
  "command", "no");
expect("a unit ending like the hold", held("start", "x" + hold), "command", "no");
expect("a unit starting like the hold", held("start", hold + ".d"), "command", "no");
// Someone who isn't an administrator is granted nothing by it.
var stranger = joels(pids.command);
stranger.groups = ["users"];
var strangers = polkit._runRules(held("start", hold), stranger);
if (strangers === "yes") {
  failed += 1;
  print("FAIL holding the efficient cores as a stranger: yes");
}

// mycelium's node holds off sleep and shutdown while it keeps work, as
// Joel's session may; nothing else of agents' does, and it's granted
// nothing more.
var inhibits = ["block-sleep", "delay-sleep", "block-shutdown", "delay-shutdown"];
for (var i = 0; i < inhibits.length; i++) {
  var inhibit = asking("org.freedesktop.login1.inhibit-" + inhibits[i], {});
  expect("holding off " + inhibits[i], inhibit, "node", "yes");
  expect("holding off " + inhibits[i], inhibit, "held", "no");
  expect("holding off " + inhibits[i], inhibit, "session", "no");
  expect("holding off " + inhibits[i], inhibit, "terminal", null);
}
expect("libvirt's system connection", libvirt, "node", "no");
expect(
  "suspending",
  asking("org.freedesktop.login1.suspend", {}),
  "node",
  "no"
);
var elsewhere = joels(pids.node);
elsewhere.active = false;
var away = polkit._runRules(asking("org.freedesktop.login1.inhibit-block-sleep", {}), elsewhere);
if (away !== "no") {
  failed += 1;
  print("FAIL holding off sleep from the node outside the active session: " + away);
}

// An agent's run0 or pkexec asks Joel, once for its command alone, from
// wherever agents work; a unit's other verbs and its files stay refused.
// Today's case: an agent's run0 adding an address to the Wi-Fi.
var run0 = asking("org.freedesktop.systemd1.manage-units", {
  verb: "start",
  unit: "run-u42.service",
});
var pkexec = asking("org.freedesktop.policykit.exec", {
  program: "/run/current-system/sw/bin/ip",
});
var stopping = asking("org.freedesktop.systemd1.manage-units", {
  verb: "stop",
  unit: "nix-daemon.service",
});
var unitFiles = asking("org.freedesktop.systemd1.manage-unit-files", {});
var addsAnAddress = "run0 /run/current-system/sw/bin/ip addr add 192.168.0.2/24 dev wlp0s20f3";
for (var asker in pids) {
  commands[pids[asker]] = addsAnAddress;
}
var agentsPlaces = ["session", "host", "work", "command", "timed", "shared", "brokered", "held"];
for (var j = 0; j < agentsPlaces.length; j++) {
  expect("run0", run0, agentsPlaces[j], "auth_admin");
  expect("pkexec", pkexec, agentsPlaces[j], "auth_admin");
  expect("stopping a unit", stopping, agentsPlaces[j], "no");
  expect("a unit's files", unitFiles, agentsPlaces[j], "no");
}
expect("run0", run0, "terminal", null);
expect("run0", run0, "gone", "no");

// Nor does it ask a screen Joel isn't at, or for a command it can't name.
var notInFront = joels(pids.held);
notInFront.active = false;
if (polkit._runRules(run0, notInFront) !== "no") {
  failed += 1;
  print("FAIL run0 from an agent while Joel's session isn't in front was asked");
}
var remote = joels(pids.held);
remote.local = false;
if (polkit._runRules(run0, remote) !== "no") {
  failed += 1;
  print("FAIL run0 from an agent of a session elsewhere was asked");
}
delete commands[pids.held];
expect("run0 for a command gone", run0, "held", "no");
commands[pids.held] = addsAnAddress;

// A root step Joel named in agentsMayRepeat is granted an agent without
// asking him, from wherever agents work and whether or not he's in front,
// since a grant puts nothing on a screen; checks.nix runs these cases on
// a machine naming nix-daemon.service's restart (catalogued) and on one
// naming nothing. Another verb, another unit, or a session elsewhere is
// answered as before, and Joel's own terminal is left to ask.
var restarting = asking("org.freedesktop.systemd1.manage-units", {
  verb: "restart",
  unit: "nix-daemon.service",
});
var restartingAnother = asking("org.freedesktop.systemd1.manage-units", {
  verb: "restart",
  unit: "sshd.service",
});
var restartingNoUnit = asking("org.freedesktop.systemd1.manage-units", {
  verb: "restart",
  unit: "hasOwnProperty",
});
for (var k = 0; k < agentsPlaces.length; k++) {
  expect("restarting a named unit", restarting, agentsPlaces[k], catalogued ? "yes" : "no");
  expect("restarting another unit", restartingAnother, agentsPlaces[k], "no");
  expect("restarting a name no unit has", restartingNoUnit, agentsPlaces[k], "no");
  expect("stopping a named unit", stopping, agentsPlaces[k], "no");
}
expect("restarting a named unit", restarting, "terminal", null);
expect("restarting a named unit", restarting, "gone", "no");
var asleep = joels(pids.session);
asleep.active = false;
if (polkit._runRules(restarting, asleep) !== (catalogued ? "yes" : "no")) {
  failed += 1;
  print("FAIL restarting a named unit while Joel isn't in front");
}
var afar = joels(pids.session);
afar.local = false;
if (polkit._runRules(restarting, afar) !== "no") {
  failed += 1;
  print("FAIL restarting a named unit from a session elsewhere was granted");
}

// A process gone before it's read is refused, since nobody's there to ask.
expect("libvirt's system connection", libvirt, "gone", "no");

// A grant is read without looking at where it came from.
spawned = 0;
polkit._runRules(weight, joels(pids.app));
if (spawned !== 0) {
  failed += 1;
  print("FAIL a grant read a cgroup " + spawned + " times");
}

// A refusal, and an ask a rule puts to Joel, say where the process ran.
function says(what, action, place, line) {
  logged = [];
  polkit._runRules(action, joels(pids[place] || 99));
  if (logged.join("\n") !== line) {
    failed += 1;
    print("FAIL " + what + " from " + place + " logged: " + logged.join(" | "));
  }
}
says(
  "libvirt's system connection",
  libvirt,
  "session",
  "refused org.libvirt.unix.manage to pid 10 in " + where.session
);
says(
  "writing firmware",
  firmware,
  "terminal",
  "asks Joel for org.freedesktop.fwupd.update-internal for pid 13 in " + where.terminal
);
says(
  "run0",
  run0,
  "held",
  "asks Joel for org.freedesktop.systemd1.manage-units for pid 20 in " +
    where.held +
    " running " +
    addsAnAddress
);
if (catalogued) {
  says(
    "restarting a named unit",
    restarting,
    "session",
    "grants org.freedesktop.systemd1.manage-units restart of nix-daemon.service to pid 10 in " +
      where.session
  );
}
says(
  "libvirt's system connection",
  libvirt,
  "gone",
  "refused org.libvirt.unix.manage to pid 99 in a process gone"
);

if (failed > 0) {
  throw new Error(failed + " cases failed");
}
print("every case held");
