// The machine's administrators, agents and the account's jobs-sorter among
// them, may start and stop efficient-cores-held@MHZ.service without a
// password, and do nothing else with it: modules/slices/nixos.nix says why.
// The unit only lowers the efficient cores' clock ceiling, or frees it, so
// the most it can do is slow the machine's slower cores. Only a speed from
// 400 to 5000 MHz, written without a leading zero, is granted, the range
// efficient-cores.sh holds. polkit's own engine reads this, in the
// JavaScript it knows.
polkit.addRule(function (action, subject) {
  var held = /^efficient-cores-held@([1-9][0-9]{2,3})\.service$/.exec(action.lookup("unit"));
  if (
    action.id === "org.freedesktop.systemd1.manage-units" &&
    /^(start|stop)$/.test(action.lookup("verb")) &&
    held !== null &&
    Number(held[1]) >= 400 &&
    Number(held[1]) <= 5000 &&
    subject.isInGroup("wheel")
  ) {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
