+/// Paragraphs wrapped at 80 columns, as Markdown files are kept.
+const WRAPPED: &str = include_str!("wrapped-paragraphs.md");
+
+#[test]
+fn wrapped_lines_keep_a_space_between_their_words() {
+    log::init();
+    let elements = interpret_md(WRAPPED);
+    let said: Vec<String> = elements
+        .iter()
+        .filter_map(elem_as_text_box)
+        .map(|text_box| text_box.texts.iter().map(|text| text.text.as_str()).collect())
+        .collect();
+    let said = said.join("\n");
+    // Each pair is the last word of a line and the first of the next.
+    for pair in [
+        "wraps its paragraphs",
+        "at eighty columns,",
+        "so each line ends",
+        "with a word that",
+        "the next begins. The",
+        "reader joins them",
+        "with a space, as",
+        "with emphasis at",
+        "the edge and a link",
+        "near the end. A hard",
+    ] {
+        assert!(said.contains(pair), "{pair:?} isn't in what was read: {said}");
+    }
+    assert!(said.contains("break\nstarts"), "a hard break didn't start a line: {said}");
+    assert!(!said.contains("\n starts"), "a line after a hard break starts with a space: {said}");
+}
