+// The account's own keys, which the build names: what's pressed in Vim is
+// what each does here, and q and Escape alone are nothing, since nothing
+// records and Escape closes nothing of ours.
+#[test]
+fn speaks_vim() {
+    use super::action::{HistDirection, Zoom};
+
+    log::init();
+
+    let config = include_str!(env!("INLYNE_KEYBINDINGS"));
+    let Config { keybindings, .. } = Config::load_from_str(config).unwrap();
+    let mut key_combos = KeyCombos::new(keybindings).unwrap();
+
+    let key = |virt: VirtKey| -> ModifiedKey { virt.into() };
+    let shifted = |virt: VirtKey| ModifiedKey(virt.into(), ModifiersState::SHIFT);
+    let ctrl = |virt: VirtKey| ModifiedKey(virt.into(), ModifiersState::CTRL);
+    let ctrl_shifted =
+        |virt: VirtKey| ModifiedKey(virt.into(), ModifiersState::CTRL | ModifiersState::SHIFT);
+    let test_vectors = [
+        (key(VirtKey::Q), None),
+        (key(VirtKey::Escape), None),
+        (key(VirtKey::J), Some(Action::Scroll(VertDirection::Down))),
+        (key(VirtKey::K), Some(Action::Scroll(VertDirection::Up))),
+        (key(VirtKey::G), None),
+        (key(VirtKey::G), Some(Action::ToEdge(VertDirection::Up))),
+        (key(VirtKey::LShift), None),
+        (shifted(VirtKey::G), Some(Action::ToEdge(VertDirection::Down))),
+        // :q and Return, as Shift+; arrives on a Mac and on Wayland.
+        (key(VirtKey::LShift), None),
+        (shifted(VirtKey::Semicolon), None),
+        (key(VirtKey::Q), None),
+        (key(VirtKey::Return), Some(Action::Quit)),
+        (key(VirtKey::LShift), None),
+        (shifted(VirtKey::Colon), None),
+        (key(VirtKey::Q), None),
+        (key(VirtKey::Return), Some(Action::Quit)),
+        // ZZ, with Shift pressed again between the two.
+        (shifted(VirtKey::Z), None),
+        (key(VirtKey::LShift), None),
+        (shifted(VirtKey::Z), Some(Action::Quit)),
+        // Space w, and Escape dropping a waiting Space.
+        (key(VirtKey::Space), None),
+        (key(VirtKey::W), Some(Action::Quit)),
+        (key(VirtKey::Space), None),
+        (key(VirtKey::Escape), None),
+        (key(VirtKey::W), None),
+        (key(VirtKey::F1), Some(Action::Keys)),
+        // Space ?, as Shift+/ arrives on a Mac.
+        (key(VirtKey::Space), None),
+        (key(VirtKey::LShift), None),
+        (shifted(VirtKey::Slash), Some(Action::Keys)),
+        // The Ctrl chords, and Ctrl with Shift+= as Wayland names it.
+        (ctrl(VirtKey::F), Some(Action::Page(VertDirection::Down))),
+        (ctrl(VirtKey::B), Some(Action::Page(VertDirection::Up))),
+        (ctrl(VirtKey::O), Some(Action::History(HistDirection::Prev))),
+        (ctrl(VirtKey::I), Some(Action::History(HistDirection::Next))),
+        (ctrl(VirtKey::Equals), Some(Action::Zoom(Zoom::In))),
+        (ctrl_shifted(VirtKey::Plus), Some(Action::Zoom(Zoom::In))),
+        (ctrl(VirtKey::Minus), Some(Action::Zoom(Zoom::Out))),
+        (ctrl(VirtKey::Key0), Some(Action::Zoom(Zoom::Reset))),
+    ];
+
+    for (pressed, maybe_action) in test_vectors {
+        assert_eq!(key_combos.munch(pressed), maybe_action, "after {pressed}");
+    }
+}
+
