--- a/src/showing.rs
+++ b/src/showing.rs
@@ -0,0 +1,57 @@
+//! The file this inlyne shows, kept for the desktop to read: a line saying
+//! the process and the file's whole path, in `inlyne/showing/<pid>` under
+//! the state home. It's written aside and renamed over, so it's never read
+//! half written, and removed as inlyne quits. What a killed inlyne left is
+//! cleared by the next to start. Keeping it is a courtesy, so a failure is
+//! passed over and inlyne runs as it would.
+
+use std::path::{Path, PathBuf};
+use std::{env, fs, process};
+
+fn folder() -> Option<PathBuf> {
+    let state = env::var_os("XDG_STATE_HOME")
+        .map(PathBuf::from)
+        .filter(|state| state.is_absolute())
+        .or_else(|| dirs::home_dir().map(|home| home.join(".local/state")))?;
+    Some(state.join("inlyne/showing"))
+}
+
+/// Clears what inlyne processes that are gone left behind.
+pub fn clear_gone() {
+    let Some(folder) = folder() else { return };
+    let Ok(entries) = fs::read_dir(&folder) else { return };
+    for entry in entries.flatten() {
+        let name = entry.file_name();
+        let Some(pid) = name
+            .to_str()
+            .map(|name| name.trim_start_matches('.'))
+            .filter(|pid| !pid.is_empty() && pid.bytes().all(|b| b.is_ascii_digit()))
+        else {
+            continue;
+        };
+        if !Path::new("/proc").join(pid).exists() {
+            let _ = fs::remove_file(entry.path());
+        }
+    }
+}
+
+/// Keeps `path` as the file this inlyne shows.
+pub fn keep(path: &Path) {
+    let Some(folder) = folder() else { return };
+    if fs::create_dir_all(&folder).is_err() {
+        return;
+    }
+    let pid = process::id();
+    let writing = folder.join(format!(".{pid}"));
+    let line = format!("{pid}\t{}\n", path.display());
+    if fs::write(&writing, line).is_ok() {
+        let _ = fs::rename(&writing, folder.join(pid.to_string()));
+    }
+}
+
+/// Says this inlyne shows nothing any more.
+pub fn forget() {
+    if let Some(folder) = folder() {
+        let _ = fs::remove_file(folder.join(process::id().to_string()));
+    }
+}
