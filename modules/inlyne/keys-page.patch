+#[test]
+fn keys() {
+    log::init();
+
+    let config = r#"
+[keybindings]
+base = [["Keys", { key = "/", mod = ["Shift"] }]]
+"#;
+
+    let Config { keybindings, .. } = Config::load_from_str(config).unwrap();
+    let mut key_combos = KeyCombos::new(keybindings).unwrap();
+    let question = ModifiedKey(VirtKey::Slash.into(), ModifiersState::SHIFT);
+    assert_eq!(key_combos.munch(question), Some(Action::Keys));
+}
+
