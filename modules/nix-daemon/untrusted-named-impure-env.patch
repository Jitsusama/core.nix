+                        || name == "extra-" + settings.getLocalSettings().impureEnv.name)) {
+                    /* A client that isn't trusted may set only the
+                       variables the daemon's own configuration names, and
+                       only adds them to what the daemon set itself. They
+                       reach nothing but fixed-output derivations, whose
+                       outputs are checked against their hashes. A value
+                       may be a credential, so a warning names the
+                       variable and never its value, and an entry that
+                       isn't name=value is dropped without echoing it. */
+                    auto & allowed = settings.getLocalSettings().untrustedImpureEnvNames.get();
+                    StringMap kept;
+                    for (const auto & entry : tokenizeString<Strings>(value)) {
+                        auto eq = entry.find('=');
+                        if (eq == entry.npos) {
+                            warn("ignoring a client-specified impure-env entry that isn't name=value");
+                            continue;
+                        }
+                        std::string var(entry, 0, eq);
+                        if (allowed.count(var))
+                            kept.insert_or_assign(var, std::string(entry, eq + 1));
+                        else
+                            warn(
+                                "ignoring the client-specified impure-env variable '%s', because it isn't in "
+                                "untrusted-impure-env-names and you are not a trusted user",
+                                var);
+                    }
+                    auto & impureEnv = settings.getLocalSettings().impureEnv;
+                    auto merged = impureEnv.get();
+                    for (auto & [var, val] : kept)
+                        merged.insert_or_assign(var, val);
+                    impureEnv.assign(merged);
