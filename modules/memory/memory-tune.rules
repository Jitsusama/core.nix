// The machine's administrators may start the memory module's four tuning
// units with a value from these lists, without a password, and nothing
// else: modules/memory/nixos.nix says why. polkit's own engine reads this,
// in the JavaScript it knows.
var listed = new RegExp(
  "^memory-(" +
    [
      "watermarks@(10|25|50|100|200|400)",
      "hugepages@(always|madvise|never)",
      "lru-gen@(y|n)",
      "swappiness@(20|60|100|140|180)",
    ].join("|") +
    ")\\.service$"
);

polkit.addRule(function (action, subject) {
  if (
    action.id === "org.freedesktop.systemd1.manage-units" &&
    /^(start|restart)$/.test(action.lookup("verb")) &&
    listed.test(action.lookup("unit")) &&
    subject.isInGroup("wheel")
  ) {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
