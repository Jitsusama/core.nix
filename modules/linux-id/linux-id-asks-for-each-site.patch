+// An approval for one site, or for signing in, never answers a request for
+// another site, or a registration, that comes within the cache's time.
+func TestCachingVerifier_AsksForAnotherPrompt(t *testing.T) {
+	inner := &fakeVerifier{nextResult: VerifyResult{OK: true}}
+	v := newCachingVerifier(inner)
+
+	for _, prompt := range []string{
+		"FIDO2 Authenticate: site.example",
+		"FIDO2 Authenticate: other.example",
+		"FIDO2 Register: other.example",
+	} {
+		ch, err := v.VerifyUser(prompt)
+		if err != nil {
+			t.Fatalf("VerifyUser(%q): %s", prompt, err)
+		}
+		<-ch
+	}
+	if inner.callCount != 3 {
+		t.Errorf("an approval answered another prompt; inner.callCount = %d, want 3", inner.callCount)
+	}
+}
