drm/edid: read the luminance range from DisplayID's Display Parameters

Panels that give their luminance only in a DisplayID 2.x Display
Parameters block (tag 0x21), with no CTA HDR static metadata, leave
luminance_range at zero. Drivers that set brightness in nits then
guess: i915 and xe drive an eDP 1.5 panel's VESA luminance control
from 0 to 512 nits. The XPS 14's LG OLED is one: 400 nits over the full
screen in that block, which is Windows' ceiling for it too, so the top
fifth of the slider asks for light the panel isn't rated to give. When
no CTA block gives a range, it's read from Display Parameters instead.
Cristian La Spina posted the same idea for 7.3's parser in August
2026, unmerged; this is written for 7.2, which lacks that parser.

--- a/drivers/gpu/drm/drm_edid.c
+++ b/drivers/gpu/drm/drm_edid.c
@@ -6755,6 +6755,64 @@
 	memset(&info->amd_vsdb, 0, sizeof(info->amd_vsdb));
 }
 
+/*
+ * DisplayID 2.x gives luminance in cd/m^2 as an IEEE 754 half-precision
+ * float. Returns it in whole nits, rounded, or 0 for a value that isn't a
+ * positive normal number.
+ */
+static u32 displayid_luminance(const u8 *bytes)
+{
+	u16 val = bytes[0] | bytes[1] << 8;
+	unsigned int exp = (val >> 10) & 0x1f;
+	u32 mant = (val & 0x3ff) | 0x400;
+
+	if (val & 0x8000 || !exp || exp == 0x1f)
+		return 0;
+
+	/* The value is mant * 2^(exp - 25). */
+	if (exp >= 25)
+		return mant << (exp - 25);
+
+	return (mant + (1 << (24 - exp))) >> (25 - exp);
+}
+
+/*
+ * Some panels give their luminance only in a DisplayID 2.x Display
+ * Parameters block, with no CTA HDR static metadata. Bytes 21 and 22 of
+ * the block hold the maximum luminance over the full screen, and bytes 25
+ * and 26 the minimum.
+ */
+static void drm_get_luminance_range_displayid(struct drm_connector *connector,
+					      const struct drm_edid *drm_edid)
+{
+	struct drm_luminance_range_info *range = &connector->display_info.luminance_range;
+	const struct displayid_block *block;
+	struct displayid_iter iter;
+
+	displayid_iter_edid_begin(drm_edid, &iter);
+	displayid_iter_for_each(block, &iter) {
+		const u8 *params = (const u8 *)(block + 1);
+		u32 max, min;
+
+		if (block->tag != DATA_BLOCK_2_DISPLAY_PARAMETERS || block->num_bytes < 27)
+			continue;
+
+		max = displayid_luminance(&params[21]);
+		min = displayid_luminance(&params[25]);
+		if (!max || min >= max)
+			continue;
+
+		range->max_luminance = max;
+		range->min_luminance = min;
+
+		drm_dbg_kms(connector->dev,
+			    "[CONNECTOR:%d:%s] DisplayID luminance range is %u - %u nits\n",
+			    connector->base.id, connector->name, min, max);
+		break;
+	}
+	displayid_iter_end(&iter);
+}
+
 static void update_displayid_info(struct drm_connector *connector,
 				  const struct drm_edid *drm_edid)
 {
@@ -6813,6 +6871,10 @@
 	info->color_formats |= BIT(DRM_OUTPUT_COLOR_FORMAT_RGB444);
 	drm_parse_cea_ext(connector, drm_edid);
 
+	/* CTA HDR static metadata comes first, so a range from it is kept. */
+	if (!info->luminance_range.max_luminance)
+		drm_get_luminance_range_displayid(connector, drm_edid);
+
 	update_displayid_info(connector, drm_edid);
 
 	/*
