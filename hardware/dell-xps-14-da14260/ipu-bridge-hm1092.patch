media: ipu-bridge: Add Himax HM1092 IR sensor

Without an entry here the IR sensor's endpoint is built with no link
frequencies, so its driver rejects every mode and the sensor never
binds. From mainline, commit 4fdb0342f05e by Jake Steinman, which 7.2
doesn't have.

Link: https://git.kernel.org/torvalds/c/4fdb0342f05eed8bd134e84859a4e89e60bd5bc1

diff -ruN a/drivers/media/pci/intel/ipu-bridge.c b/drivers/media/pci/intel/ipu-bridge.c
--- a/drivers/media/pci/intel/ipu-bridge.c
+++ b/drivers/media/pci/intel/ipu-bridge.c
@@ -49,6 +49,8 @@
  * Please keep the list sorted by ACPI HID.
  */
 static const struct ipu_sensor_config ipu_supported_sensors[] = {
+	/* Himax HM1092 */
+	IPU_SENSOR_CONFIG("HIMX1092", 2, 180000000, 180480000),
 	/* Himax HM11B1 */
 	IPU_SENSOR_CONFIG("HIMX11B1", 1, 384000000),
 	/* Himax HM2170 */
