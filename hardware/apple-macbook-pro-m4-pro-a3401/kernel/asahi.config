# Shared Apple Silicon hardware defaults for M1 and later, including Neo.
# Merge over ARM64 defconfig or a distribution base config, then run
# olddefconfig and verify that the requested settings survive resolution.
# Device-specific boot, debug and distribution policy stays in the base.
CONFIG_RUST=y
CONFIG_ARM64_ACTLR_STATE=y
CONFIG_ARCH_APPLE=y
# CONFIG_ARM64_4K_PAGES is not set
CONFIG_ARM64_16K_PAGES=y
# CONFIG_ARM64_64K_PAGES is not set
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_USER4K_EXPERIMENTAL=y
CONFIG_ARM64_MEMORY_MODEL_CONTROL=y
# 16K pages make a page block 32 MiB, and khugepaged then sets min_free_kbytes
# to 352 MiB on an 8 GB Mac. Keep page blocks at 2 MiB as on 4K kernels.
CONFIG_PAGE_BLOCK_MAX_ORDER=7
CONFIG_ARM_APPLE_CPUIDLE=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=m
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y
# CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE is not set
CONFIG_THERMAL_DEFAULT_GOV_POWER_ALLOCATOR=y
CONFIG_BT_BRCMEXT=y
CONFIG_BT_HCIBCM4377=m
CONFIG_BT_MTK7932_PCIE=m
CONFIG_PCIE_APPLE=y
CONFIG_NVME_APPLE=m
CONFIG_MMC_SDHCI_PCI=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_PCIE_APPLE_T8140_BOOTSTRAP=y
CONFIG_PCIEASPM=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_MT7932_FULLMAC=m
CONFIG_TOUCHSCREEN_APPLE_Z2=m
CONFIG_INPUT_MACSMC_INPUT=m
CONFIG_I2C_APPLE=m
CONFIG_SPI_APPLE=m
CONFIG_SPI_APPLE_QSPI=m
CONFIG_SPMI_APPLE=y
CONFIG_PINCTRL_APPLE_GPIO=m
CONFIG_GPIO_MACSMC=m
CONFIG_NFC=m
CONFIG_NFC_APPLE_STOCKHOLM=m
CONFIG_POWER_RESET_MACSMC=m
CONFIG_MACSMC_POWER=m
CONFIG_SENSORS_MACSMC_HWMON=m
CONFIG_SENSORS_APPLE_PMP_J613=m
CONFIG_THERMAL_NETLINK=y
CONFIG_NVME_HWMON=y
CONFIG_APPLE_WATCHDOG=y
# m1n1 hands the ADT and its own log over as phram regions (/dev/mtd*).
CONFIG_MTD=y
CONFIG_MTD_PHRAM=m
# Apple NVRAM partitions are 4 KiB aligned (J700: 0x24000).
CONFIG_MTD_SPI_NOR_USE_4K_SECTORS=y
CONFIG_VIDEO_APPLE_AVD=m
CONFIG_VIDEO_APPLE_AVE=m
CONFIG_VIDEO_APPLE_ISP=m
CONFIG_VIDEO_APPLE_PRORES=m
CONFIG_VIDEO_APPLE_JPEG=m
CONFIG_DRM=y
CONFIG_DRM_ASAHI=m
CONFIG_DRM_ASAHI_G15=y
CONFIG_DRM_ASAHI_G16=y
CONFIG_DRM_ADP=m
CONFIG_DRM_APPLE=m
CONFIG_DRM_APPLE_DCP_T8132=y
CONFIG_DRM_APPLE_AUDIO=y
CONFIG_DRM_ACCEL=y
CONFIG_DRM_ACCEL_ANE=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_SND_SOC_APPLE_AOP_AUDIO=m
CONFIG_SND_SOC_APPLE_MCA=m
CONFIG_SND_SOC_APPLE_MACAUDIO=m
CONFIG_SND_SOC_CS42L83=m
CONFIG_SND_SOC_CS42L84=m
CONFIG_SND_SOC_MAX98357A=m
CONFIG_SND_SOC_TAS2764=m
CONFIG_SND_SOC_TAS2770=m
CONFIG_HID_APPLE=m
CONFIG_HID_MAGICMOUSE=m
CONFIG_HID_APPLE_MTP_HAPTIC=m
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_HID_DOCKCHANNEL=m
CONFIG_SPI_HID_APPLE_OF=m
CONFIG_SPI_HID_APPLE_CORE=m
CONFIG_USB_DWC3_APPLE=m
CONFIG_USB_VL122_HUB=m
CONFIG_TYPEC=m
CONFIG_USB4=m
CONFIG_USB4_APPLE_SOC=m
CONFIG_USB_XHCI_PCI_ASMEDIA=y
CONFIG_TYPEC_SN201202X=m
CONFIG_RTC_DRV_MACSMC=y
CONFIG_RTC_DRV_APPLE_PMU=m
CONFIG_APPLE_ADMAC=m
CONFIG_APPLE_SIO=m
CONFIG_MFD_MACSMC=y
CONFIG_COMMON_CLK_APPLE_NCO=m
CONFIG_APPLE_DART=y
CONFIG_APPLE_DART_J713_DCP=y
CONFIG_APPLE_DOCKCHANNEL=m
CONFIG_SERIAL_APPLE_DOCKCHANNEL=y
CONFIG_SERIAL_APPLE_DOCKCHANNEL_EARLYCON=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_PMGR_MISC=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_RTKIT_HELPER=m
CONFIG_APPLE_SART=m
CONFIG_RUST_APPLE_RTKIT=y
CONFIG_APPLE_AOP=m
CONFIG_HW_RANDOM=y
CONFIG_KEYS=y
CONFIG_TRUSTED_KEYS=y
# CONFIG_TRUSTED_KEYS_TPM is not set
# CONFIG_TRUSTED_KEYS_TEE is not set
CONFIG_APPLE_SEP=m
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_APPLE_PMP=m
CONFIG_APPLE_PMP_REPORT=y
CONFIG_APPLE_PMP_THERMAL=m
CONFIG_APPLE_T8132_PLATFORM_HANDOFF=y
CONFIG_IIO_AOP_SENSOR_LAS=m
CONFIG_IIO_AOP_SENSOR_ALS=m
CONFIG_IIO_AOP_SENSOR_MOTION=m
CONFIG_RUST_FW_LOADER_ABSTRACTIONS=y
CONFIG_PWM_APPLE=m
CONFIG_APPLE_AIC=y
CONFIG_PHY_APPLE_ATC=m
CONFIG_PHY_APPLE_T6040_USB2=m
CONFIG_PHY_APPLE_DPTX=m
CONFIG_PHY_TI_CD2E22=m
CONFIG_APPLE_M1_CPU_PMU=y
CONFIG_NVMEM_APPLE_EFUSES=m
CONFIG_NVMEM_APPLE_SPMI=y
CONFIG_MUX_APPLE_DPXBAR=m
CONFIG_TYPEC_TPS6598X=m
CONFIG_RESET_APPLE_CIO=y
CONFIG_INFINIBAND=m
CONFIG_INFINIBAND_USER_ACCESS=m
CONFIG_INFINIBAND_USER_MAD=m
CONFIG_RDMA_RXE=m
CONFIG_RDMA_SIW=m
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_EDAC_APPLE_SOC=m
# Confine kernel executable code to a fixed physical CTXR window so the kernel
# can run at EL2 on chips whose firmware locks the code-execute range. Inert
# unless the bootloader supplies a window (/chosen/aurora,ctxr-exec-window) or
# the ctxr_exec_window= command-line option is given.
CONFIG_ARM64_CTXR_EXECMEM=y
