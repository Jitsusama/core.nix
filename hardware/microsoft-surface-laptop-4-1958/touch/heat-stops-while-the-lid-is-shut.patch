+/* The lid's switch. Its handler takes only devices with SW_LID, reads the
+ * switch as it stands when one connects, and hands each change to the rest's
+ * work, which stops or starts the heat maps under seq_lock. */
+static void spi_hid_lid_heard(struct spi_hid *shid, bool shut)
+{
+	if (READ_ONCE(shid->lid_shut) == shut)
+		return;
+	WRITE_ONCE(shid->lid_shut, shut);
+	if (!READ_ONCE(shid->removing))
+		mod_delayed_work(system_wq, &shid->heat_rest_work, 0);
+}
+
+static void spi_hid_lid_event(struct input_handle *handle, unsigned int type,
+			      unsigned int code, int value)
+{
+	struct spi_hid *shid = container_of(handle->handler, struct spi_hid,
+					    lid_handler);
+
+	if (type == EV_SW && code == SW_LID)
+		spi_hid_lid_heard(shid, value);
+}
+
+static int spi_hid_lid_connect(struct input_handler *handler,
+			       struct input_dev *input,
+			       const struct input_device_id *id)
+{
+	struct spi_hid *shid = container_of(handler, struct spi_hid, lid_handler);
+	struct input_handle *handle;
+	int ret;
+
+	handle = kzalloc(sizeof(*handle), GFP_KERNEL);
+	if (!handle)
+		return -ENOMEM;
+	handle->dev = input;
+	handle->handler = handler;
+	handle->name = "sl4a_lid";
+	ret = input_register_handle(handle);
+	if (ret)
+		goto err_free;
+	ret = input_open_device(handle);
+	if (ret)
+		goto err_unregister;
+	spi_hid_lid_heard(shid, test_bit(SW_LID, input->sw));
+	dev_info(&shid->spi->dev, "lid: hearing %s, shut=%d\n",
+		 input->name ?: "its switch", READ_ONCE(shid->lid_shut));
+	return 0;
+
+err_unregister:
+	input_unregister_handle(handle);
+err_free:
+	kfree(handle);
+	return ret;
+}
+
+static void spi_hid_lid_disconnect(struct input_handle *handle)
+{
+	input_close_device(handle);
+	input_unregister_handle(handle);
+	kfree(handle);
+}
+
+static const struct input_device_id spi_hid_lid_ids[] = {
+	{
+		.flags = INPUT_DEVICE_ID_MATCH_EVBIT | INPUT_DEVICE_ID_MATCH_SWBIT,
+		.evbit = { BIT_MASK(EV_SW) },
+		.swbit = { [BIT_WORD(SW_LID)] = BIT_MASK(SW_LID) },
+	},
+	{ },
+};
+
+static void spi_hid_lid_register(struct spi_hid *shid)
+{
+	int ret;
+
+	shid->lid_handler.event = spi_hid_lid_event;
+	shid->lid_handler.connect = spi_hid_lid_connect;
+	shid->lid_handler.disconnect = spi_hid_lid_disconnect;
+	shid->lid_handler.name = "sl4a_lid";
+	shid->lid_handler.id_table = spi_hid_lid_ids;
+	ret = input_register_handler(&shid->lid_handler);
+	if (ret)
+		dev_warn(&shid->spi->dev,
+			 "lid: can't hear its switch (%d), so the panel scans shut too\n",
+			 ret);
+	else
+		shid->lid_handler_registered = true;
+}
+
+static void spi_hid_lid_unregister(struct spi_hid *shid)
+{
+	if (!shid->lid_handler_registered)
+		return;
+	input_unregister_handler(&shid->lid_handler);
+	shid->lid_handler_registered = false;
+}
