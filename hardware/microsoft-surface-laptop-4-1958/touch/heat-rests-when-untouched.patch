+/*
+ * The idle rest. The panel sends its heat maps about 95 times a second while
+ * the lid is open, touched or not, and each costs a core several
+ * milliseconds. After heat_rest_after heat maps in a row with no contact the
+ * panel is asked to stop them (SET_FEATURE 5 = 0), and heat_rest_ms later to
+ * start them again, so an untouched screen scans a few frames at a time
+ * rather than all the time. Anything else the panel sends while it rests
+ * starts them at once, in case it says so when touched. 0 leaves it off.
+ */
+static uint heat_rest_after;
+module_param(heat_rest_after, uint, 0644);
+MODULE_PARM_DESC(heat_rest_after,
+	"Heat maps in a row with no contact before the panel rests; 0 = never");
+
+static uint heat_rest_ms = 200;
+module_param(heat_rest_ms, uint, 0644);
+MODULE_PARM_DESC(heat_rest_ms,
+	"How long the panel rests before it scans again, in ms");
+
+enum { HEAT_SCANNING, HEAT_STOPPING, HEAT_RESTING };
+
+/* Called with seq_lock held: SET_FEATURE 5 with `on`, doubled framing only. */
+static int spi_hid_heat_scan(struct spi_hid *shid, bool on)
+{
+	u8 frame[] = { 0x02, 0x02, 0x00, 0x00, 0x03, 0x82, 0x00, 0x03,
+		       0x04, 0x00, 0x05, 0x01, 0x00, 0x00, 0x00 };
+
+	frame[11] = on;
+	shid->read_resp_type = SPI_HID_CONTENT_TYPE_SET_FEATURE;
+	shid->read_resp_content_id = 5;
+	return spi_hid_seq_write_speed(shid, frame, sizeof(frame), NULL, 0,
+				       setfeat_speed_hz);
+}
+
+static void spi_hid_heat_rest_work(struct work_struct *work)
+{
+	struct spi_hid *shid = container_of(to_delayed_work(work),
+					    struct spi_hid, heat_rest_work);
+	int ret;
+
+	mutex_lock(&shid->seq_lock);
+	if (READ_ONCE(shid->removing) || READ_ONCE(shid->suspended) ||
+	    shid->seq_state != SPI_HID_SEQ_DONE) {
+		shid->heat_rest_phase = HEAT_SCANNING;
+	} else if (shid->heat_rest_phase == HEAT_STOPPING) {
+		ret = spi_hid_heat_scan(shid, false);
+		shid->heat_rest_phase = ret ? HEAT_SCANNING : HEAT_RESTING;
+		if (!ret) {
+			shid->stat_heat_rests++;
+			schedule_delayed_work(&shid->heat_rest_work,
+				msecs_to_jiffies(READ_ONCE(heat_rest_ms)));
+		}
+	} else if (shid->heat_rest_phase == HEAT_RESTING) {
+		ret = spi_hid_heat_scan(shid, true);
+		if (ret) {
+			/* A panel left resting never sends a touch: try again. */
+			dev_warn_ratelimited(&shid->spi->dev,
+				"heat rest: restarting the heat maps failed: %d\n", ret);
+			schedule_delayed_work(&shid->heat_rest_work,
+				msecs_to_jiffies(READ_ONCE(heat_rest_ms)));
+		} else {
+			shid->heat_empty_frames = 0;
+			shid->heat_rest_phase = HEAT_SCANNING;
+		}
+	}
+	mutex_unlock(&shid->seq_lock);
+}
+
