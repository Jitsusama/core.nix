+static ssize_t touch_stats_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct spi_hid *shid = dev_get_drvdata(dev);
+	u32 off, i;
+
+	mutex_lock(&shid->seq_lock);
+	off = sysfs_emit(buf,
+			 "heat_frames=%u\ncontact_frames=%u\nrests=%u\nresting=%u\nother_frames=%u\nlast_other_id=0x%02x\nlast_contacts=%u\n",
+			 shid->stat_heat_frames, shid->stat_heat_contact_frames,
+			 shid->stat_heat_rests,
+			 shid->heat_rest_phase == HEAT_RESTING,
+			 shid->stat_other_frames, shid->stat_last_other_id,
+			 shid->stat_last_contacts);
+	for (i = 0; i < shid->stat_last_contacts && i < HEATMAP_MAX_BLOBS; i++)
+		off += sysfs_emit_at(buf, off, "contact=%u.%02u,%u.%02u\n",
+				     shid->stat_last_gx[i] / 100, shid->stat_last_gx[i] % 100,
+				     shid->stat_last_gy[i] / 100, shid->stat_last_gy[i] % 100);
+	mutex_unlock(&shid->seq_lock);
+	return off;
+}
+static DEVICE_ATTR_RO(touch_stats);
+
+/*
+ * Sends SET_FEATURE report 5 with the value written, 1 to start the heat
+ * maps and 0 to ask the panel to stop them, to find out by hand whether it
+ * stops scanning and what it sends on a touch while stopped.
+ */
+static ssize_t heat_scan_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct spi_hid *shid = dev_get_drvdata(dev);
+	bool on;
+	int ret;
+
+	ret = kstrtobool(buf, &on);
+	if (ret)
+		return ret;
+	mutex_lock(&shid->seq_lock);
+	ret = spi_hid_heat_scan(shid, on);
+	mutex_unlock(&shid->seq_lock);
+	dev_info(dev, "heat_scan: SET_FEATURE(5)=%u sent: %d\n", on, ret);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(heat_scan);
+
