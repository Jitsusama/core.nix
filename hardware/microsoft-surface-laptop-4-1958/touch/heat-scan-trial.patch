diff --git a/spi-hid-core.c b/spi-hid-core.c
index 54b0f39..f8a4859 100644
--- a/spi-hid-core.c
+++ b/spi-hid-core.c
@@ -4536,6 +4536,55 @@ static ssize_t lifecycle_status_show(struct device *dev,
 }
 static DEVICE_ATTR_RO(lifecycle_status);
 
+static ssize_t touch_stats_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct spi_hid *shid = dev_get_drvdata(dev);
+	u32 off, i;
+
+	mutex_lock(&shid->seq_lock);
+	off = sysfs_emit(buf, "heat_frames=%u\ncontact_frames=%u\nlast_contacts=%u\n",
+			 shid->stat_heat_frames, shid->stat_heat_contact_frames,
+			 shid->stat_last_contacts);
+	for (i = 0; i < shid->stat_last_contacts && i < HEATMAP_MAX_BLOBS; i++)
+		off += sysfs_emit_at(buf, off, "contact=%u.%02u,%u.%02u\n",
+				     shid->stat_last_gx[i] / 100, shid->stat_last_gx[i] % 100,
+				     shid->stat_last_gy[i] / 100, shid->stat_last_gy[i] % 100);
+	mutex_unlock(&shid->seq_lock);
+	return off;
+}
+static DEVICE_ATTR_RO(touch_stats);
+
+/*
+ * Sends SET_FEATURE report 5 with the value written, 1 to start the heat
+ * maps and 0 to ask the panel to stop them, to find out by hand whether it
+ * stops scanning when nothing touches it. Only the doubled-opcode framing
+ * this panel takes (wire_double_opcode=1) is sent.
+ */
+static ssize_t heat_scan_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct spi_hid *shid = dev_get_drvdata(dev);
+	u8 frame[] = { 0x02, 0x02, 0x00, 0x00, 0x03, 0x82, 0x00, 0x03,
+		       0x04, 0x00, 0x05, 0x01, 0x00, 0x00, 0x00 };
+	bool on;
+	int ret;
+
+	ret = kstrtobool(buf, &on);
+	if (ret)
+		return ret;
+	frame[11] = on;
+	mutex_lock(&shid->seq_lock);
+	shid->read_resp_type = SPI_HID_CONTENT_TYPE_SET_FEATURE;
+	shid->read_resp_content_id = 5;
+	ret = spi_hid_seq_write_speed(shid, frame, sizeof(frame), NULL, 0,
+				      setfeat_speed_hz);
+	mutex_unlock(&shid->seq_lock);
+	dev_info(dev, "heat_scan: SET_FEATURE(5)=%u sent: %d\n", on, ret);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(heat_scan);
+
 static const struct attribute *const spi_hid_attributes[] = {
